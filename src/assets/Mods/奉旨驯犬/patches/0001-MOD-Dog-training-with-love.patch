+ {
+        "id": 6600002,
+        "name": "奉旨驯犬",
+        "text": "苏丹似乎对你同他的骑兵队长走得太近很是不满……",       
+        "tips": "",
+        "mapping_id":8001255,
+        "once_new":0,
+        "round_number": 1,
+        "waiting_round":0, 
+        "waiting_round_end_action":[
