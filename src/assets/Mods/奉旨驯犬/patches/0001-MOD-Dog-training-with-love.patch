+                    }
+                }
+            }
+        ],
+        "method_settlement": "",
+        "auto_begin": 0, 
+        "auto_result": 0, //自动执行                           
+        "location": "上城区:[7,12]", 
+        "icon": "rite_16",  
+        "tag_tips": [
+        ],
+        "tag_tips_up":{
+        },
+        "tips_text":[
+            "你可以为此折断一张纵欲卡，或消除一次苏丹的猜忌",
+			" "
+        ],
+        "open_conditions": [  
+        ],
+        "random_text": { 
+        },
+        "random_text_up":{
+        },
+        "random_effect": {          
+        },
+        "settlement_prior": [
+        ],                
+        "settlement": [
+        ],                
+        "settlement_extre": [
+            {
+                "condition": {
+                    "s4.纵欲":1
+                },
+                "result_title":"奉旨驯犬",
+                "result_text": "苏丹的奴仆将你的手指束在有着黄金指爪的犬爪套里，然后是发箍、犬尾……毫不在意自己的指甲会划痛你，毕竟，他们只是在装饰一个物品，一个苏丹觉得很有趣的玩具。\n你跪伏在地，丧家之犬一般卑微绝望，又缺了能遮蔽恶意目光的毛皮，只能祈求这一切快些结束。但是，当你嗅到法里斯那一身熟悉的狗味时，还是忍不住抬头望了过去——你怕在他那张忠厚纯朴的脸上见到鄙夷。\n法里斯确实无比震惊地看着你，但随着苏丹的耳语，他的面色逐渐凝重……骑兵队长深吸一口气，闭上眼喃喃自语了一番，再度睁开那双眼时，他望着你的眼神已与望着新月的别无二致。\n“坐下。”他简短有力地发令，你也只能服从。\n“真乖，第一次就做得这么好，好狗狗好狗狗。”法里斯将你的头抱在胸口，手指熟练地轻轻搔抓你的头顶和耳根，酥酥麻麻的触感似电流般自他指尖流窜，配合着那热切的夸赞，将你的大脑搅得昏昏乎乎，“[player.name]真是一条好狗狗。” \n这不对。你仅存的理智和一点自尊挣扎着想要将自己拽出去，可连日挣扎求生的紧张使得你忍不住任由自己往那温暖黑暗的水里沉下去、沉下去……什么也不用操心。没有苏丹卡，没有残酷的游戏，你只是一条只要听得懂指令就能得到奖励的狗儿，除此之外什么也不用操心。\n“法里斯卿，听话的狗是否应该给些奖励？”苏丹玩味地看着你们。\n“是。”法里斯的手伸向腰包，掏出一块什么东西放到你嘴里。你有些抗拒，然后想起法里斯自己也会吃他亲手烹饪的那些肉干。“自己没尝过的东西，又怎么放心让心爱的狗儿们吃呢？”他总是这样说。\n没加盐和香料的肉干难免有些寡淡，但好在用料扎实，吃起来还是很香。你迷迷糊糊地想着，还没等你完全咽下，法里斯就将你的一只“犬爪”抓起，放在自己的手心。\n“握手。”他耐心地教导着你。\n你还能怎么办呢？给法里斯做狗总比给苏丹当狗好，至少法里斯真的很爱他的狗。你自我安慰着，只要忘记自己是人，就能在苏丹的宫廷游戏里活下去……\n可你还是有些不甘心。你的尾巴摇得热切，眼角却溢出泪水，又怕被苏丹看见质疑你的忠心，只得将脸埋往法里斯怀里。他似是意识到了你的紧张，一把将你笼在怀里，轻轻拍打你的脊背，又轻抚你的头顶：“好狗狗，好狗狗，你已经做得很好了哦。主人会一直陪着你的……”他的声音低沉醇厚，你感到苏丹这些天扎在你身上的盐刺被一点点融化殆尽。\n你发出低低的呜咽声。然后是哭泣。你不在乎苏丹会不会有疑心。你太累了，累得不想再去忧心……\n法里斯一直抱着你。似是怕自己表现得太过关心，他很快把你放倒在地，以宽厚温暖的手掌打着圈抚摸你的肚皮。管他呢。你放任自己吻上他的脸颊，出于感激……或许不只是感激。\n苏丹笑了，笑得很肆意。他最初或许是怀疑你接近法里斯的动机、想要离间你们……但你那可怜兮兮的模样成功打消了他的疑虑。\n“真是一出令人感动的温情戏啊，法里斯卿。”苏丹似笑非笑地发话，“但你是否知道，这条不知廉耻的犬今天想要你在他身上折断一张苏丹卡？” \n不被允许口吐人言的你呜咽着、可怜兮兮地看向法里斯——你想解释，你真的是走投无路，是悬在头顶的处刑日迫你做出此事。\n但法里斯只是轻轻拍了拍你。“没关系。”他以口形赦免了你。\n仿佛照料受伤的幼犬一般，法里斯温柔、细致又耐心地为你做好了准备，轻柔地同你说无需害怕……他不会伤害你。\n你呜咽着抱紧了法里斯，随着他的动作，你觉得自己仿佛真的要堕为野兽一般。\n“好狗狗好狗狗，没事的没事的，想叫就叫吧，想咬就咬吧。”他放任甚至鼓励了你，毫不在意你给他结实的蜜色小臂又添上了几道齿印。\n法里斯的小臂并不光滑，那上边新的疤痕叠着旧的，大大小小的狗儿都在上边留下过痕迹。不知为何，你情不自禁地想要用自己的记号盖过去，如饥似渴地舔舐渗出的一点点血腥气……想要占有，想要标记。现在没有挣扎求生的大臣，没有意图谋逆推翻苏丹的斗士，只有你。而你只是条忠于内心欲求的犬罢了。渴求着独占最心爱的主人的犬……\n你最终脱力倒在了法里斯怀里，感觉堆积多日的许多东西通通泄了出去。而他只是轻抚你的头、为你平息呼吸，轻声说着好狗狗好狗狗。\n苏丹恩准法里斯将新驯好的犬带回家里。他搀扶着你、用身体为你遮蔽着一路上或探求、或嘲弄的目光。刚踏出宫廷，他就脱下披风为你披上。那上边曾让贝姬夫人连连哈气的狗味儿让此刻的你无比安心。\n你想同他说些什么，嗫嚅着嘴唇，又组织不出话语。而他只是摇摇头，抱紧了你，轻轻拍了拍你的背。没事的，他的温度这样告诉你。",
