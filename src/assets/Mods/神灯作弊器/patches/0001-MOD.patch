e": "item", "cost.金币": 20}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "商人们需要你投资至少20枚金币"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以亲自，或派遣任意追随者同行"}, "s3": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些消耗品在长途商旅中派得上用场"}, "s4": {"condition": {"is": 2000539}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "商队向你保证，他们会竭尽全力"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
