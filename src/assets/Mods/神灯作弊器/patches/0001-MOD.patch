+{"id": 5208049, "name": "快脚的约会", "text": "快脚出去约会一天……他试图偷偷摸摸趁你不注意的时候再走，但没有意识到自己一般会提前两天就开始不自觉的哼歌。", "tips": "", "mapping_id": 8001179, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_22", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["一个7天一次的循环仪式。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1": 1}, "result_title": "快乐", "result_text": "快脚回来的时候，全身都在发光，这可不光是洗澡的缘故……嗯，还是不要告诉他那些女士面霜的价格比较好。", "result": {}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000370}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "快乐的快脚"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
