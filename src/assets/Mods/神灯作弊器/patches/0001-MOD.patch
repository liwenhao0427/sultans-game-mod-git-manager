+{"id": 5206521, "name": "星灵之夜", "text": "你大声地赞颂星灵的每一个名字，那记录于残卷上的无穷通路已被开启。承受这一伟大命运的人，也注定要因此消逝。", "tips": "", "mapping_id": 8001068, "once_new": 1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_23", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "一阵狂躁的黑色旋风冲进你的宅邸，人们惊叫着躲避。等骚乱过后，人们发现房间里什么都没少，而鲁梅拉已然消失无踪。你望向星空，只有你知道她去了什么地方。", "result": {"clean.s1": 1, "card": 2000545}, "action": {"global_counter=7200233": 1}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000123}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "她还是鲁梅拉么？"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
