+{"id": 5400503, "text": "打老婆的邻居", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100503}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400503_option_1", "text": "你的邻居——一个什么都要和你攀比的蠢货——打肿了他自己老婆的脸，就为了警告她不要和你这种【用巫术卡牌与女人通奸的脏东西】说话。", "icon": "cards/2000001", "items": [{"text": "满足他的幻想", "tag": "op1"}, {"text": "教训他一顿", "tag": "op2"}, {"text": "置之不理", "tag": "op3"}, {"text": "只是女人？", "tag": "op4"}]}, "case:op1": {"rite": 5006002, "prompt": {"id": "5400503_prompt_1", "text": "朋友，这不是巧了吗，我有纵欲的需要，而你恰好有一个老婆。", "icon": ["", [2010005], "cards/2000001"]}}, "case:op2": {"counter+7100004": 1, "prompt": {"id": "5400503_prompt_2", "text": "你刚刚敲响了他家的大门，他就从后窗跳了出去，摔断了一条腿，还尿在了自己裤子里。这让你失去了继续折磨他的兴致，总之，这件事到此为止了。", "icon": "cards/2000001"}}, "case:op3": {"counter+7100002": 1, "counter-7100001": 1, "prompt": {"id": "5400503_prompt_3", "text": "你根本没把邻居的话放在心上，更别提那个可怜女人的遭遇了。然而不久后，邻居堵在你家门口痛斥你勾搭他的妻子，还把她藏了起来，他说得那么言之凿凿，痛彻心扉，人们同情他，对你根本不存在的恶行指指点点……这一刻，你百口莫辩……", "icon": "cards/2000001"}}, "case:op4": {"no_prompt": {"card": 2000684}, "rite": 5006594, "prompt": {"id": "5400503_prompt_4", "text": "你对我的了解还不够多，朋友……现在我们有一个加深彼此了解的机会了。", "icon": ["", [2010005], "cards/2000001"]}}}}]}
