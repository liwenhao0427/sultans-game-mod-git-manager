+{"id": 5201103, "name": "不归之路", "text": "阿图娜尔主动备好美酒，点燃熏香，热情地邀请那位阴晴不定的君王……一个欲望的陷阱，正等待着不可一世的猎物踏入。", "tips": "", "mapping_id": 8001222, "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_4", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你能做的只有等待她的消息。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "阿图娜尔告诉你这个消息的时候，手都在微微发抖——她成功了，苏丹的魔法戒指已在昨夜被她偷偷掉包，接下来的事就得靠你了。她焦躁不安地催促着你尽快行动，一旦苏丹觉察异状，一切就完了。", "result": {"s2-equip": 2000529, "card": [2000281, "已拥有+1"]}, "action": {"global_counter=7200249": 1, "event_on": 5300333}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000129}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿图娜尔在行动"}, "s2": {"condition": {"is": 2000024}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "傲慢的君主"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
