+{"id": 5400173, "text": "刺杀", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100173}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"table.clean.2000063": 1, "table.clean.2000062": 1, "rite": 5000608, "prompt": {"id": "5400173_prompt_1", "text": "有一天，你听说法图娜带着扎齐伊悄悄离开了这座城市，不知去往何方。她只留下一张信笺，上面写着简短的感谢。也许……你想，也许那个聪明的女人知道了什么，而现在，她已经摆脱那些盘旋头顶的贪婪兀鹫。你衷心地祈祷她能平安。\n不过，有的人恐怕因此要气得要发疯了……", "icon": "cards/2000001"}, "success": {"event_off": 5400173}}}]}
