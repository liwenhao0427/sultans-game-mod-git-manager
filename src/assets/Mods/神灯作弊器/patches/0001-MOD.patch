+{"id": 5420552, "text": "深谈", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120552}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"prompt": {"id": "5420552_prompt_01", "text": "屠龙的一切准备都已经做好，你可以随时出征。\n但是，请注意，屠龙是整个世界为之震撼的大事，无论成功与否，你的游戏都进入结束阶段。\n一切都会结束，万事万物，都会。但是结束的方式不尽相同，幸福与悲惨一线相隔。\n出发吧，去杀了那只大蜥蜴。", "icon": "cards/2000332"}, "rite": 5006067, "event_off": 5420552}}]}
