+{"id": 5203012, "name": "流言四起", "text": "一夜之间，流言四起，真假掺半。", "tips": "", "mapping_id": 8001246, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_8", "tag_tips": ["影响力", "恶名"], "tips_text": ["这是一个会扣除你已有影响力的仪式", "这是一个已经发生的不幸事件，你无法改变它", "如果已经没有影响力，你会得到更多的恶名"], "open_conditions": [], "random_text": {}, "settlement_prior": [], "settlement": [{"condition": {"!s1": 1}, "result_title": "", "result_text": "事态脱离了你的控制。人们添油加醋的狂热消解了你尚在苦苦支撑的坚持、你被逼无奈的挣扎。你成了一个纯粹的恶的抽象化身。不需要任何证据，任何人都能将任何罪名安在你身上，引来一连串快乐的笑声。没有人关心真相，没有人听你解释。放弃吧，堕落吧，良知和真理在这片诅咒的土地上没有容身之所。", "result": {"counter+7100002": 1}, "action": {}}, {"condition": {"s1": 1}, "result_title": "", "result_text": "你疲于奔波，终于在形势不可挽回之前遏制了流言的传播。但你注意到，不少人已经不再像从前那样尊敬你了。不论你拥有怎样的权势、财富，他们都能在你华贵外衣之下窥见他们想看到的丑态，并为之发出一阵阵笑声。", "result": {}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.影响力": [1, 2]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你在这座城市的影响力将被流言消解"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
