+{"id": 5208111, "name": "阁楼里偶尔的笑声", "text": "由于布缇娜的约束和明里暗里的施压，妓女们隔很久才能找到机会偷偷过来干一次私活。", "tips": "", "mapping_id": 8001143, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_13", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每隔14天才能出现一次"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "妓女们在舍馆的餐厅吃过饭后，客人会立即跟着她们登上阁楼的楼梯……现在她们偶然还是会邀请哈比卜，但反正没时间邀请你了。\n看来哈比卜对她们挺大方的。呵呵，男人。", "result": {"loot": 6001059}, "action": {"counter+7000491": 1}}], "cards_slot": {"s1": {"condition": {"type": "char", "any": {"is": 2000789, "妓女": 1}}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "终于找到机会偷偷过来的女士"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
