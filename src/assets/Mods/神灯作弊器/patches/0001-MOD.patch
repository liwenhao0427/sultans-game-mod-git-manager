+{"id": 5400504, "text": "贼人之手", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100504}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400504_option_1", "text": "梅姬有一件心爱的珠宝遭窃了，会是谁做的？随她陪嫁来的女奴小圆最容易接近她的珠宝盒；快脚经常在城市跑动，最容易销赃……又或者……会不会是最近曾来拜访过你妻子的某位好友？", "icon": "cards/2000001", "items": [{"text": "女仆小圆", "tag": "op1"}, {"text": "跑腿的快脚", "tag": "op2"}, {"text": "贵族友人", "tag": "op3"}]}, "case:op1": {"card": 2000083, "prompt": {"id": "5400504_prompt_1", "text": "你指认小圆是贼人，梅姬大为震惊。她反复强调她的女仆不可能做出这种事，但你坚持自己的指控。搜身之后，小圆确实什么都没偷，妻子对你失望极了。", "icon": "cards/2000001"}, "event_on": 5320102}, "case:op2": {"card": 2000039, "prompt": {"id": "5400504_prompt_2", "text": "你早就觉得这家伙有些可疑……以他的速度只需要一个小时就能干完的活有的时候他要花三个小时才回来。一番指认之后，他软弱地跪倒在地，交待说自己确实偷过餐桌上的银勺子，但他坚称珠宝的事他确实不知道。搜查无果，你也只好接受这个结局。", "icon": "cards/2000001"}, "event_on": 5320102}, "case:op3": {"coin": 3, "prompt": {"id": "5400504_prompt_3", "text": "你提出要约梅姬的朋友来聊聊珠宝的事，出乎意料的事，她似乎大松了一口气。“说真的，我也有点怀疑，她先是要看我的珠宝匣，而后又说起自己丈夫赌博的事……但我总在想，是不是不该怀疑朋友？”\n你安慰了她，而后给那位妇女的丈夫写了信。几天后，你收到了一封空白的回信，以及装着珠宝的袋子。", "icon": "cards/2000001"}, "event_on": 5320102}}}]}
