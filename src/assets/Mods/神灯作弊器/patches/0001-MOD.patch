+{"id": 5206080, "name": "直面苏丹", "text": "青金石宫殿浓厚的阴影和辉煌的光在苏丹身上交织，为他编织出难测的妆容。你直视着他，正望见他喉头滚动，表达出难以掩饰的、野兽般直白的喜悦。", "tips": "", "mapping_id": 8001022, "once_new": 0, "round_number": 0, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "结局:7", "type": "END", "icon": "rite_ex_2", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["战斗还没开始，别紧张"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "一个令苏丹愉悦的游戏", "result_text": "龙血浓厚的腥味充斥在这广阔的觐见厅。你没有动，只是盯着自己侍奉多年的君王。你看见他从王座上长身而起，烛台和焰火在他身后拖开庞大的影子。被挤压的空气沉甸甸地压在你的肩头，令你不得不拼尽全力，才能抵抗那跪下去的本能，为了驱散这重逾千钧的死寂，你缓缓地、颤抖地，抽出自己随身的兵刃。", "result": {"s1=战斗": 7, "s1=体魄": 7, "s1=魅力": 7, "s1=生存": 7, "s1=智慧": 7, "s1=魔力": 7}, "action": {}}, {"condition": {}, "result_title": "为了你，他全副武装", "result_text": "苏丹微微眯起眼睛，看着你手中刀刃的反光。很好。他抬手拿起自己的征战之剑，让侍卫给自己套上了盔甲，又在其他武器之间稍加迟疑，选择了另一柄轻薄但扭曲的弯刀。\n在他做这些事情的时候，你没有说话，也没有冲锋，仿佛有某种默契一般地，只是等待着即将到来的、属于勇士的决战。", "result": {"s1+s3": 1, "s1+s4": 1, "s1+s5": 1}, "action": {}}, {"condition": {}, "result_title": "光与影之兽", "result_text": "终于，苏丹离开了他盘踞已久的王座，一步步地走下台阶，走向你……每一步，他的影子都更显膨胀，每一步，他反射的光都更为瑰丽。你紧盯着你的对手，紧握着手中的利刃，你唯有鼓起全部勇气和力量才能面对他，你清楚地知道：一头猛兽终于从束缚他、腐化他、折磨他的囚笼里被你释放出来。", "result": {"s1+s2": 1}, "action": {"rite": 5006081}}], "cards_slot": {"s1": {"condition": {"is": 2000024}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "苏丹"}, "s2": {"condition": {"type": "item", "is": 2000915}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "连阳光与影子都是属于苏丹的"}, "s3": {"condition": {"type": "item", "is": 2000916}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "摧残王者之刃"}, "s4": {"condition": {"type": "item", "is": 2000917}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "他不需要防护，但需要展现威仪"}, "s5": {"condition": {"type": "item", "is": 2000918}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "摧残弱者之刃"}, "s6": {"condition": {"type": "char", "主角": 1, "屠龙苏丹": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "你必须亲自见证这一切"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
