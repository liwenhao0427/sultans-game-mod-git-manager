+{"id": 5200849, "name": "故国的旗帜", "text": "誓言之证尚有空白的页面——你可以让更多人加入。", "tips": "", "mapping_id": 8001246, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_19", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["谋反的意图能强化誓言，弑君的计划则能让誓言直接完成！"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"s2.is": 2000171}, "result_title": "古老的文书上面增加了新的血", "result_text": "你让更多人加入了故国复兴的计划——其实无论叫什么都好，人们只是需要一个名义，称号，理由，借口而已……", "result": {"s1+回应誓言": 1, "clean.s2": 1}, "action": {}}, {"condition": {"s2.is": 2000172}, "result_title": "天理在我们这边", "result_text": "弑君之罪，何其之大……而复国之命，何其正义。现在，你同时握住了罪与义理，握住了历史榨取人类鲜血的巨轮——是时候让它转动起来了。", "result": {"s1=回应誓言": 6, "clean.s2": 1}, "action": {}}, {"condition": {"s2.is": 2001024}, "result_title": "", "result_text": "", "result": {"s1=回应誓言": 6, "clean.s2": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000913}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "誓言之证"}, "s2": {"condition": {"type": "item", "any": {"is": 2001024}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "谋反的意图或弑君的计划"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
