+{"id": 5206629, "name": "无法拒绝的安慰", "text": "有那么一刻，你不得不承认，你的灵魂深处有一些阴影在蠢蠢欲动。你看上小圆了，这名梅姬的陪嫁女奴在哭泣的时候，突然触动了你的欲望。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [{"condition": {"!s2": 1}, "result_title": "", "result_text": "你把小圆带到房间，然后就出去了。年轻的女奴惴惴不安地，想要逃走可又不敢。一天过后，你回到房间，发现她正睡在地毯上，脸上的泪痕已经干涸。被你叫醒时，她吓了一大跳，差点嗑着脑袋。她惊慌地向你行礼，然后手忙脚乱地说自己该去干活了。你也就这么放她离开。\n不管怎么说，现在她该知道，梦中的狼算不上什么可怕的东西了。", "result": {}, "action": {"event_on": 5320177}}], "settlement": [], "settlement_extre": [{"condition": {"s2": 1}, "result_title": "你抱了她", "result_text": "年轻的女孩一直在哭着求你，双手却老老实实举过头顶、任由你在她身上肆虐，而不敢反抗她的主人。鲜血滴落，流淌，形成一道永远无法愈合的伤口、永远无法忘却的伤痛。\n你得到了她，但，你失去了什么呢？", "result": {"counter+7100002": 1, "counter+7000422": 1}, "action": {}}, {"condition": {"s2": 1, "have.妻子": 1}, "result_title": "这件事让梅姬大为光火", "result_text": "得知此事后，梅姬狠狠扇了你一个耳光。你从没见她如此失望过。", "result": {"card": 2000083}, "action": {"event_on": 5320178}}, {"condition": {"s2": 1, "!have.妻子": 1}, "result_title": "", "result_text": "这之后好几天，你都睡不好觉。你感觉自己应该是梦见了梅姬，但怎么也想不起来她对你说了什么、做了些什么。", "result": {"card": 2000083}, "action": {}}, {"condition": {"s3": 1}, "result_title": "", "result_text": "你折断这张卡片时，有的人唾骂你无耻地违背一个女孩的意愿强占了她，有的人则宣称，她没有反抗，便是心甘情愿。人们为此争得沸反盈天，然而，没有一个人问过小圆是怎么想的。没有一个人真正在乎。", "result": {"s1+纵欲的痕迹": 1, "clean.s3": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000371}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "小圆战战兢兢，不敢反抗"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你决定亲自安慰小圆"}, "s3": {"condition": {"type": "sudan", "纵欲": 1, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以借此折断一张不高于小圆品级的纵欲卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
