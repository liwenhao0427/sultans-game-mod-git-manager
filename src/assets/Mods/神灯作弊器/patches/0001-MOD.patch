+{"id": 5206048, "name": "阿迪莱正在寻龙", "text": "《屠龙之书》中记载了龙族最喜欢的几种栖息地，阿迪莱已经信心满满地出发，去每一个有可能的地点查探一番，确认龙巢的真正位置。", "tips": "", "once_new": 0, "round_number": 5, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "野外:[1,14]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["这不是一趟困难的冒险，你无需插手。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "阿迪莱顺利归来了", "result_text": "阿迪莱第一个就找到了你和梅姬，向你们宣布，她幸运地发现了龙的踪迹。\n按照《屠龙之书》的描述，龙很少留下足迹，因为这些大蜥蜴很谨慎，它们知道自己的脚印太特殊，会被认出来，所以，它们只会在坚硬的、不会留痕迹的岩石上歇脚。但百密一疏地，它们忘记了自己喷吐的硫磺气息也会留下痕迹。\n“我在一处符合条件的栖息地附近找到了带着这种痕迹的石头，”她兴奋地说，“这一定就是龙的巢穴，眼下只要确定那家伙在巢穴里，就可以准备猎杀了……”", "result": {}, "action": {"rite": 5006049}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000061}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿迪莱正在找寻龙的踪迹"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
