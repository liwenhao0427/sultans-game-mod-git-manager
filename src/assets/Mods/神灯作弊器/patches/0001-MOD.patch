+{"id": 5200761, "name": "您也不想别人知道吧", "text": "你拿着哲巴尔遗留的那张面具，准备和他好好谈谈。", "tips": "", "mapping_id": 8001008, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "5200761_prompt_01", "text": "你忽然发现今天还有事，算了，先放过他。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[1,12]", "icon": "rite_16", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["将“拳斗士的证明”放入槽位，就会选择对应的路线。"], "open_conditions": [{"condition": {"any": {"s2": 1, "s3": 1, "s4": 1}}, "tips": "你必须选择一种处理方式"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s2": 1}, "result_title": "你拿着这张面具，向他索要一笔不菲的钱财", "result_text": "“这是最好解决的。”他大笑起来，而后解下自己的佩刀丢给了你。“面具我就拿走了，那个拳斗场很好玩，可惜啊，以后看来是不能去了。”\n他转身离去，你掂量着手里的宝剑，思考这一切是否值得……", "result": {"card": [2000733, "已拥有+1"], "clean.s2": 1}, "action": {}}, {"condition": {"s3": 1}, "result_title": "你拿着这张面具，希望他公开对你表示支持", "result_text": "“我不太擅长在苏丹面前勾心斗角，但……”他挠挠头，“如果你这么要求的话，我会尽力支持你的。”\n“那，面具我就拿走了，那个拳斗场很好玩，可惜啊，以后看来是不能去了。”他不无遗憾地冲你点点头，转身离去了。", "result": {"counter+7100003": 3, "s1=反对": 0, "s1+支持": 1, "clean.s3": 1}, "action": {}}, {"condition": {"s4": 1}, "result_title": "你拿着这张面具，希望他成为你的同伴", "result_text": "哲巴尔对于你的请求似乎有些意外。\n“同伴？我吗？我好歹也是个将军，而且是苏丹的铁卫之首……”\n他有些难办地挠了挠头。\n“但是吧，唔，也好。您用得上我，我也用得上一位权臣盟友。”他冲你伸出满是老茧的大手，与你握了握。\n“那以后我再去拳斗场玩，麻烦您就算看到了也什么都别说。在苏丹御前伺候可不是什么让人心情愉快的事儿……我总需要找点无害的消遣，对吧？要是有比拳斗更刺激的猎物出现，我倒是可以许诺再也不去那边玩了。”\n他忽然冲你笑了笑，重重拍了拍你的肩膀。\n“如果下次我们在那见面，我会成为你的‘同伴’的。”", "result": {"clean.s4": 1}, "action": {"event_on": 5300270}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000054}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哲巴尔还不知道你找他是为了什么"}, "s2": {"condition": {"type": "item", "!s3": 1, "!s4": 1, "is": 2000731}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你准备向他索要金钱"}, "s3": {"condition": {"type": "item", "!s2": 1, "!s4": 1, "is": 2000731}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你希望他公开支持你"}, "s4": {"condition": {"type": "item", "!s2": 1, "!s3": 1, "is": 2000731}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你希望他成为你的同伴"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
