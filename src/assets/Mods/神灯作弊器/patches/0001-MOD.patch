+{"id": 5200573, "name": "净事阉奴", "text": "莎姬提到，会有一个阉人专门“清理”妃子们的身体……那么，我们是否可以贿赂这个阉奴，让他给我们亲爱的莎姬留一些存货呢？此事值得深入调查。", "tips": "", "mapping_id": 8001008, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_3", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["抓紧时间，莎姬的信物如果倒计时归零，她就会死亡，任务就会失败"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [{"condition": {"any": {"counter.7000530>=": 1, "!have.2001019": 1, "have.2001021": 1}}, "result_title": "", "result_text": "已经没有调查的必要了", "result": {"s2+回收": 1, "s4+回收": 1}, "action": {}}], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "莎姬的信息：该死的阉奴", "result_text": "莎姬的信使带着一封潦草的手书来找你，你来不及意外她竟然识字——就先被信里的内容吓了一跳。\n信中，莎姬告诉你，她已经想办法杀掉了一个苏丹的老阉奴，正是这个人每次都负责用冰冷的水冲进她的身体，把帝王留下的“至宝”给洗刷干净。这个老阉奴完全是带着扭曲的仇恨心理来做这件事的，每次都会把女人弄的很痛苦；所以莎姬找了个机会，让三四个被这个阉奴得罪过的女人一起向苏丹抱怨，而后又假意替他说话，“哎呀，毕竟老巴鲁是您的乳父——哦，我听说您含过他的奶头呢！”苏丹觉得很恶心，老巴鲁当天晚上就脑袋落地。\n伴随着这些残酷的故事，她也提醒你一定要尽快行事，圣主正不断地用梦境折磨和惩罚她……合上这封信以后，你不由得停下来重新思考了半晌；莎姬远不像宫廷中其他人想象的那样只知道敛财和争宠，她的缜密让你甚至有些害怕。", "result": {}, "action": {}}, {"condition": {}, "result_title": "来自宫廷的人事情报", "result_text": "你没费多大力气就打听到，接下来，一位年轻点的阉奴被指派来接替老巴鲁的工作，这人叫斯瓦萨尔，是个白皮肤阉奴。与装满了恶毒歹意的老巴鲁不同，斯瓦萨尔是个冷静、聪明的人……但要如何说动他冒着生命危险背叛苏丹呢？总之，你又花了一点钱，买到了一个他的爱好：他喜欢看书。", "result": {}, "action": {}}, {"condition": {}, "result_title": "关于皇宫，有数不清的恐怖故事，它们大多是真的", "result_text": "据说，所有被苏丹处死的奴隶，都不会被正式下葬，而是扔进皇宫的水渠里……污水之中，有一条巨大的鳄鱼专门吃这样的奴隶尸体，茁壮成长。", "result": {}, "action": {}}, {"condition": {}, "result_title": "染指苏丹的妃子绝非没有代价", "result_text": "你就知道……据说这些净事阉奴会被割掉舌头，以防他们泄露任何宫廷之秘。这可不是一门简单的手艺，苏丹的行刑官会定期统一加工这些奴隶……也许斯瓦萨尔还有一些时间。", "result": {}, "action": {"event_on": 5320266}}], "cards_slot": {"s1": {"condition": {"type": "char", "any": {"is": 2000019, "隐匿": 5}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "找莎姬打听消息：派遣热娜或者是一个隐匿不小于5的追随者去交接信息"}, "s2": {"condition": {"type": "item", "cost.金币": 8}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "贿赂官员：8枚金币不可少"}, "s3": {"condition": {"type": "char", "!贵族": 1, "社交": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "调查民间的谣言：一个社交不小于5的非贵族追随者"}, "s4": {"condition": {"type": "item", "is": 2000416, "cost.情报": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "情报交易：需要一份黄金品级的内幕"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
