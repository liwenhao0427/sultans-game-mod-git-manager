+{"id": 5410614, "text": "伊曼的感谢信", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5110614}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"counter+7100006": 3, "prompt": {"id": "5410614_prompt_1", "text": "一封奇怪的信摆在了你的桌案上，上面一个字也没有写，这片空荡荡的、洁净的纯白纸张晕染着一股独特的茉莉花香——它掩藏着血的气味，痛苦的气味，或许，还有更幽密的思绪藏于其中，却不发一言。", "icon": ["cards/2000021"]}, "success": {"event_off": 5410614}}}]}
