+{"id": 5200813, "name": "追猎豺狼", "text": "芮尔找到了豺狼帮余党的藏身之地，她出动自己所有的人手，决心将他们一举剿灭！", "tips": "", "mapping_id": 8001285, "once_new": 0, "round_number": 2, "waiting_round": 7, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"counter+7000467": 1, "counter=7000465": 0, "clean.s7": 1}, "action": {"prompt": {"id": "5200813_prompt_01", "text": "就算没有你的帮助，芮尔也顺利地自行清缴了豺狼残部。", "icon": "cards/2000771"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "黑街:[2,5]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {"tips": ["战斗"], "type": "fight_result"}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "芮尔一脚踹开豺狼残部藏身的破房子的大门", "type": "fight_result", "type_tips": "芮尔及其手下的战斗属性提供的骰子数量受到豺狼帮的影响", "low_target": 5, "low_target_tips": "至少需要5点成功才能彻底扫清敌人。"}}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"r1:战斗-e(战斗)>=": [5, 5]}, "result_title": "你们无路可逃", "result_text": "那些人一开始还在怒骂这个女蛮子赶尽杀绝，芮尔听得哈哈大笑，没关系，血流光了也就骂不动了。", "result": {"s1+战斗": 3, "s2+战斗": 3}, "action": {"event_on": 5300541}}, {"condition": {"r1:战斗-e(战斗)<": [5, 5]}, "result_title": "你给我等着", "result_text": "豺狼帮的人学乖了，他们不再跟芮尔硬碰硬，他们且战且退，虽然留下了几具尸首，但大部队却很快消失在异常复杂的暗巷里。\n他们大概很久都不敢再兴风作浪了，但芮尔还是狠狠骂了几句蛮族粗口，显然杀得一点也不尽兴。", "result": {"clean.s7": 1, "counter+7000467": 1, "counter=7000465": 0}, "action": {}}], "settlement_extre": [{"condition": {"r1:战斗-e(战斗)>=": [5, 5], "any": {"s4": 1, "s6": 1}}, "result_title": "他们还有用", "result_text": "你说服芮尔放过那些已经完全失去反抗能力哭着求饶的豺狼帮众人，芮尔很嫌弃他们贪生怕死，不过也不得不承认吞并了豺狼帮那么大一块地盘之后，自己正是缺人手的时候。", "result": {"no_show": {"clean.s7": 1}, "card": [2000966, "芮尔手下+1"]}, "action": {}}, {"condition": {"r1:战斗-e(战斗)>=": [5, 5], "s6": 1}, "result_title": "", "result_text": "尽管帮派斗殴本身没什么意思，但你绘声绘色地讲了很久芮尔活吃肝脏的残忍画面，苏丹还是同意了你折断这张品级本身也不怎么高的征服卡。", "result": {"clean.s6": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "芮尔": 1, "is": 2000771}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "芮尔"}, "s2": {"condition": {"type": "item", "芮尔手下": 1, "is": 2000965}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "芮尔的手下们"}, "s3": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以派人去帮助芮尔"}, "s4": {"condition": {"type": "item", "cost.金币=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以花钱5金币收编豺狼帮"}, "s5": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以为芮尔提供一些物资"}, "s6": {"condition": {"type": "sudan", "rare<": 3, "征服": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以借机折断一张不高于青铜品级的征服卡"}, "s7": {"condition": {"type": "item", "is": 2001057}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "豺狼帮残部"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
