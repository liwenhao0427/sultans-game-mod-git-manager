+{"id": 5202008, "name": "书店门口的乞丐", "text": "严格来说，她并没有在乞讨，她只是用一种渴求的眼神看着你手中的书籍。当然，这很荒谬，众所周知，贫民不识字，更不可能产生对知识的高贵渴求。", "tips": "", "mapping_id": 8001308, "once_new": 0, "round_number": 0, "waiting_round": 2, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5300027}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "商业区:[4,5]", "icon": "rite_4", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以什么都不做，也可以满足这个小姑娘的愿望"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [{"condition": {}, "result_title": "", "result_text": "她仿佛受到惊吓一般离开了，这些书可能有去无回……但愿她是真的要看书，虽然这也不太可能。", "result": {"s2-已拥有": 1, "s2+赠予少女": 1}, "action": {"event_on": 5300028}}], "settlement": [], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000161}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "衣衫褴褛的少女"}, "s2": {"condition": {"type": "item", "读物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "送书给一个乞丐？你确定吗？"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
