+{"id": 5206534, "name": "蠢妓女和活恶棍", "text": "鲁梅拉送给你的书，上面记录着她复仇的始末与因果。", "tips": "", "mapping_id": 8001005, "once_new": 1, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"is": 2000123}, "result_title": "", "result_text": "你把这本书递给鲁梅拉的时候，年轻的女孩轻轻地叹了口气。她读书的声音比以往更轻了，不再像是给女仆们讲故事那样将自己抽离出去，仿佛一段故事的旁观者。她平淡的话语里带着讽刺，带着嘲弄，但不再有恨了。仇恨已经被她亲手了结，在那个惊心动魄的夜晚。\n读到最后，鲁梅拉阖上书卷，“希望您不会再想听这个故事，主人……”她顿了顿，又低下头去，“也希望这个世界上，再也不会有这样的故事。”", "result": {"s2+生存": 1, "clean.s1": 1}, "action": {}}, {"condition": {}, "result_title": "", "result_text": "一个女孩的一生——她曾拥有过的幸福、失去的关爱、她的沦落、她的憎恨，还有，最重要的，她孤注一掷的复仇——都在这薄薄的纸页之间。", "result": {"s2+生存": 1, "clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000547}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "蠢妓女和活恶棍"}, "s2": {"condition": {"type": "char", "!动物": 1, "!怪物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阅读者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
