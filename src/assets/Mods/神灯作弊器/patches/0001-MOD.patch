+{"id": 5208162, "name": "小狗和月亮之歌", "text": "阅读可以提升自己，养成阅读的习惯吧", "tips": "", "mapping_id": 8001005, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "没有人能读完整篇长诗却不心中泛起柔情，期待着养一只属于自己的小狗。", "result": {"s1-已拥有": 1, "s1-正在阅读": 1, "s2+equip_slot": "animal_handling"}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "正在阅读": 1, "is": 2001054}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "诗歌"}, "s2": {"condition": {"type": "char", "!动物": 1, "!怪物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阅读者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
