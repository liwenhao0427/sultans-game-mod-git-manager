+{"id": 5421035, "text": "丰产的仪式说明", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121035}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5421035_option_1", "text": "盖斯解读了这份仪式图纸。\n他若有所思地告诉你，这是在蛮荒的年代里，苏丹的父辈们最常使用的仪式——用无辜者的鲜血告慰大地，取悦河川，以换取领地接下来一年的丰收。\n“我愿意做您的祭品。”盖斯盯着你的眼睛，取出一把尖刀，呈至你的面前。", "icon": "cards/2000056", "items": [{"text": "筹备仪式", "tag": "op1"}, {"text": "还是算了", "tag": "op2"}]}, "case:op1": {"no_prompt": {"table.2000757-事件提示": 1}, "rite": 5008023, "prompt": {"id": "5421035_prompt_1", "text": "为什么不呢？你毫不犹豫地接过了那把仪式刀。盖斯的眼睛被你的决断点亮了。现在的他渴望着鲜血和献奉，一如当初他执着于公平和正义。", "icon": "cards/2000056"}, "success": {"event_off": 5421035}}, "case:op2": {"no_prompt": {"table.2000757-事件提示": 1}, "rite": 5008024, "prompt": {"id": "5421035_prompt_2", "text": "你拒绝了他。盖斯没说什么，只是若有所思地点头：“看来它没什么价值，那就销毁掉它吧。”他提议道。", "icon": "cards/2000056"}, "success": {"event_off": 5421035}}}}]}
