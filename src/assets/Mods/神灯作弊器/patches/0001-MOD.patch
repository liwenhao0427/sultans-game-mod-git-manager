+{"id": 5208090, "name": "大家一起来！", "text": "哈比卜证明了自己的手艺——看看围着厨房的这帮没出息的家伙们吧！要不是你还站在门口，他们早就冲进去里抢饭吃了。你微笑着，示意大家可以开饭了。", "tips": "", "mapping_id": 8001121, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"clean.s5": 1}, "action": {"prompt": {"id": "prompt_5208090_01", "text": "除了大口咀嚼吞咽的声音之外，饭桌上没有任何其他杂响。人们吃得满嘴流油，心满意足之后疯狂地赞美哈比卜。"}, "rite": 5008091}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_18", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [{"condition": {"any": {"s2": 1, "s3": 1, "s4": 1}}, "tips": "放入追随者或者自己享用餐食"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1, "s3": 1}, "result_title": "你和梅姬联袂出席", "result_text": "见到你们，所有人一下子都变得拘谨了——大家伙谁都没有和贵族老爷和夫人一起吃过饭呢！\n哈比卜先为你们上菜，然后才板着脸给所有人分餐，他的区别待遇让梅姬抿着嘴唇忍不住笑了。\n看在这笑容的份上，你拿了些钱命人去给大家买酒，单独有一瓶送到了哈比卜手上，一时间，所有人都在赞扬你的慷慨。", "result": {"clean.s5": 1, "counter+7100004": 1, "s2+体魄": 1, "s3+体魄": 1, "s4+体魄": 1}, "action": {"rite": 5008091}}, {"condition": {"s2": 1, "!s3": 1}, "result_title": "你加入了这场欢宴", "result_text": "见到你，黑街的人们一下子就变得拘谨了——大家伙谁都没有和贵族老爷在同一张桌子吃过饭呢！但你冲他们摆摆手，笑呵呵地说不用这样。因为哈比卜做的饭菜真的很美味，大家渐渐地也真的放松下来，他们一开始还吹捧你几句，很快就光顾着唏哩呼噜吃饭了。\n宴后，你把哈比卜专门叫来表扬了几句，告诉他，你的舍馆就交给他来管理了，哈比卜恭敬地向你行礼，人群随之一齐欢呼起来。", "result": {"clean.s5": 1, "counter+7100004": 1, "s2+体魄": 1, "s4+体魄": 1}, "action": {"rite": 5008091}}, {"condition": {"!s2": 1, "s3": 1}, "result_title": "梅姬很乐意来尝尝", "result_text": "一见到传说中又睿智又温柔的夫人，黑街的人们一下子就变得拘谨了，只有哈比卜面色如常地、毕恭毕敬地走上前来，为梅姬单独上了一分餐食，还斟了一杯据说是从你领地带来的美酒。\n哈比卜做的饭菜真的很美味，它征服了在场的所有人，也包括梅姬的味蕾。事后，她劝勉了哈比卜几句，告诉他，你的舍馆就交给他来管理了。他难掩激动地郑重点头，发誓不会辜负夫人的信任。巴望着他能留下来做饭的人群随之一齐欢呼起来。", "result": {"clean.s5": 1, "counter+7100004": 1, "s3+体魄": 1, "s4+体魄": 1}, "action": {"rite": 5008091}}, {"condition": {"!s2": 1, "!s3": 1}, "result_title": "[s4.name]替你尝了哈比卜的手艺", "result_text": "[s4.gender]对他的手艺赞不绝口，据说之后好几天都赖在舍馆蹭饭，赶都赶不走。", "result": {"clean.s5": 1, "s4+体魄": 1}, "action": {"rite": 5008091}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000932}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "馋坏了的黑街居民们"}, "s2": {"condition": {"主角": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "只要你愿意，你就可以和他们一起吃"}, "s3": {"condition": {"妻子": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "梅姬很愿意尝尝哈比卜的手艺"}, "s4": {"condition": {"!贵族": 1, "!主角": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以邀请一位非贵族追随者一起吃"}, "s5": {"condition": {"is": 2000939}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哈比卜为舍馆众准备的餐食"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
