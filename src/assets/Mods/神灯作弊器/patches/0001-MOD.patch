+{"id": 5202038, "name": "淘书", "text": "黑街上流淌着无数来历不明的东西，有些是赃物，有些甚至更糟……而我要做的，就是把手伸进浑浊的水流，抓住时机、攥住一朵浪花、一本书，它离开那条河以后，就与我的其他收藏一样完美、一样耐人琢磨了。书店老板这么说着，邀请你或是和你一样精于战斗的人与他一同去“抓浪花”。", "tips": "", "mapping_id": 8001315, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5300175}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "黑街:[2,5]", "icon": "rite_6", "tag_tips": [], "tag_tips_up": {"tips": ["战斗", "体魄"], "type": "normal_result"}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "找书重要但也要小心", "type": "normal_result", "type_tips": "你的战斗和体魄为你提供了完整的骰子数量。", "low_target": 4, "low_target_tips": "你至少需要4点成功。"}}, "settlement_prior": [{"condition": {"!loot": 6000005}, "result_title": "搜刮一空", "result_text": "你买了太多书，短时间内附近的小贩和小偷都拿不出什么像样的书了……", "result": {"s3+回收": 1, "s4+回收": 1}, "action": {}}], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "你只需要负责警戒", "result_text": "书店老板基本上就仿佛一条猎犬，总能在嘈杂的黑街里嗅到他追寻的目标……你只需要看着点他别被人敲闷棍就行了。", "result": {}, "action": {"event_on": 5300179}}, {"condition": {"r1:战斗+体魄>=": [4, 5], "any": {"counter.7000332<": 3, "counter.7000332>": 3}}, "result_title": "一朵浪花", "result_text": "你们买到了一本不错的书，今天是个好日子，不用动刀，没人流血，就收获了知识。", "result": {"loot": 6000005, "counter+7000332": 1}, "action": {"global_counter+7200206": 1}}, {"condition": {"r1:战斗+体魄>=": [4, 5], "counter.7000332=": 3}, "result_title": "一朵浪花", "result_text": "你们买到了一本不错的书，今天是个好日子，不用动刀，没人流血，就收获了知识。", "result": {"loot": 6000005, "counter+7000332": 1}, "action": {"global_counter+7200206": 1, "event_on": 5300178}}, {"condition": {"r1:战斗+体魄<": [4, 5]}, "result_title": "出意外了", "result_text": "有人抢劫，[s2.name]击退了不知好歹的盗匪，但自己也挂彩了，今天的抓浪花行动只能无功而返。", "result": {"s2+equip": 2000098}, "action": {}}, {"condition": {"r1:战斗+体魄>=": [4, 5], "s2.is": 2000019}, "result_title": "", "result_text": "这次淘书的经历为热娜提供了珠宝的设计灵感。", "result": {"s2+灵感": 1}, "action": {}}, {"condition": {"counter.7000117<": 6}, "result_title": "", "result_text": "在过去，书曾经是一个逃避现实的好地方，毕竟那里充满了故事与虚构之物。而现在，你身在故事中心，在一切纸页上都只能看到暗喻，讽刺，提醒你现实的荒诞与不讲情理。", "result": {"counter+7000117": 1}, "action": {}}, {"condition": {"counter.7000117>=": 6, "counter.7000200<": 34, "any": {"counter.7000332<": 3, "counter.7000332>": 3}}, "result_title": "", "result_text": "一件值得注意的事情发生了。", "result": {"counter=7000117": 0, "counter+7000200": 1}, "action": {"event_on": 5300601}}], "cards_slot": {"s1": {"condition": {"is": 2000199, "书店老板": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "书店老板"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "派个追随者跟随", "pops": [{"condition": {}, "action": {"choose": {"pop.5202038_s2_01.s1": "快！快！快！"}}}]}, "s3": {"condition": {"type": "item", "cost.金币": 3}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "淘书的钱得你来付"}, "s4": {"condition": {"type": "item", "any": {"all": {"cost.消耗品=": 1, "!金币": 1}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些道具或许能在沟通中派上用场"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
