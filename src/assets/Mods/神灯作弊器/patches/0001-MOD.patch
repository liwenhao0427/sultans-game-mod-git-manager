, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "娜依拉的野心愈发膨胀。"}, "s2": {"condition": {"主角": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "她只肯见你本人。"}, "s3": {"condition": {"type": "item", "rare=": 4, "any": {"奇珍": 1, "饰品": 1}, "!is": 2001022}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "一件金色的奇珍或饰品"}, "s4": {"condition": {"any": {"all": {"rare=": 3, "type": "sudan", "杀戮": 1}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "一场奢靡的表演，或者一个死亡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
