+{"id": 5206010, "name": "处置等死的奴隶", "text": "时机已到，你决定利用你抽到的卡片，处置这个胆敢偷窃主人财物的奴隶了。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_21", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["杀戮，或者纵欲？总之，这是他应得的惩罚！"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s3.纵欲": 1}, "result_title": "你决定放纵欲望。", "result_text": "这名奴隶对你予取予求。他还怎么敢再拒绝自己的主人呢？于是，你度过了一个不错的夜晚，只是第二天起来后，你听说那名清晨时分才被拖出卧房的奴隶，已经没有了气息。", "result": {"clean.s1": 1, "clean.s3": 1}, "action": {}}, {"condition": {"s3.杀戮": 1}, "result_title": "你决定享受杀戮。", "result_text": "这名奴隶的生命是属于你的，你早就可以夺走它了，不是么？面对你手中的屠刀，饱经折磨的奴隶反而平静了下来。自此以后，他再也不必担惊受怕了。", "result": {"clean.s1": 1, "clean.s3": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000534}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "等死的奴隶，任你摆布。"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "这种时候，当然是你亲自上阵。"}, "s3": {"condition": {"type": "sudan", "any": {"纵欲": 1, "杀戮": 1}, "rare<=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你可以借此折断一张岩石品级的纵欲卡或杀戮卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
