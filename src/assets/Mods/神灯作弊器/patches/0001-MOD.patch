+{"id": 5400550, "text": "奴隶暴动", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100550}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"no_prompt": {"card": 2000981, "clean.rite": 5000812, "counter+7000465": 1, "rite": 5000812}, "rite": 5000825, "prompt": {"id": "5400550_prompt_1", "text": "据说，奴隶市场出了点事情。因为他们生意做的太大，抓捕的奴隶太多——终于那些被拐卖的奴隶起义了，而最可怕的是，听说自己很多同胞也被这样抓走，蛮人和游牧民也联合起来组成了军队，要来讨个公道。\n一切的矛盾都指向了宰相，因为所有人都在说，就是他在一直赞助奴隶贸易！", "icon": "cards/2000001"}, "success": {"event_off": 5400550}}}]}
