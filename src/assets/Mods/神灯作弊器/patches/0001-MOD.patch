+{"id": 5208045, "name": "突袭贪官宅邸", "text": "你带领着人来到哲瓦德的宅邸。", "tips": "", "mapping_id": 8001053, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5321048}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "大敌:3", "type": "ENEMY", "icon": "rite_2000057", "tag_tips": ["体魄", "战斗"], "tag_tips_up": {"tips": ["体魄", "战斗"], "type": "fight_result"}, "tips_text": ["你必须亲自与哲瓦德决战，不死不休"], "open_conditions": [], "random_text": {"r1": "先下手为强！"}, "random_text_up": {"r1": {"text": "先下手为强！", "type": "fight_result", "type_tips": "你的骰子数受对方的战斗和体魄的影响。", "low_target": 1, "low_target_tips": "你至少1点成功才不会死亡。"}}, "settlement_prior": [], "settlement": [{"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [3, 5], "s4": 1}, "result_title": "一场大胜", "result_text": "你杀死了哲瓦德，阿鲁米娜也投井自尽了。", "result": {"clean.s1": 1, "clean.s2": 1, "clean.s3": 1, "clean.s4": 1, "coin": 20, "card": [2000790, "已拥有+1"]}, "action": {}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [3, 5], "!s4": 1}, "result_title": "一场大胜", "result_text": "你杀死了哲瓦德。", "result": {"clean.s1": 1, "clean.s2": 1, "clean.s3": 1, "clean.s4": 1, "coin": 20}, "action": {}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [1, 5], "s4": 1}, "result_title": "你抓到了阿鲁米娜", "result_text": "贪官宅邸混乱不堪，你们没有抓到哲瓦德，但无意中阿鲁米娜却落入了你们的包围。\n本来应该活捉她的，但她自己突然撞到了守卫的剑上……\n经过这次打击，哲瓦德应该会安分一段时间，但你知道，这仇恨更没法化解了。", "result": {"clean.s4": 1, "card": [2000790, "已拥有+1"], "clean.s5": 99}, "action": {"event_on": 5321047}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [1, 5], "!s4": 1}, "result_title": "你打散了他的队伍", "result_text": "贪官与家丁都是一群乌合之众，你抓了不少，杀了不少，虽然没抓到哲瓦德，但他应该暂时也没办法捣乱了。", "result": {"clean.s5": 99}, "action": {"event_on": 5321047}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)<": [1, 5]}, "result_title": "你失败了", "result_text": "本来火攻是个不错的主意，可突然改变的风向把你自己也困在了火场之中。\n在你寻找出路的时候，一只强健的臂膀从身后卡住了你的脖颈……", "result": {"clean.s6": 1}, "action": {"over": 13}}], "settlement_extre": [{"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [3, 5], "s10.杀戮": 1}, "result_title": "一次杀戮", "result_text": "贵族就是要有管教家丁的能力，但像你这样能亲自动手的也不算太多。", "result": {"clean.s10": 1, "counter+7100004": 3, "counter+7100003": 3}, "action": {}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [3, 5], "s10.征服": 1}, "result_title": "一场征服", "result_text": "你告诉苏丹，这些人是曾经被灭亡的异族余孽，于是苏丹决定按照讨伐敌人的胜利来褒奖你，而非镇压家丁。", "result": {"clean.s10": 1, "counter+7100003": 3}, "action": {}}, {"condition": {"r1:战斗+体魄-e(战斗+体魄)>=": [3, 5], "!s10": 1}, "result_title": "", "result_text": "你扑灭了一个贪污官员，大家交口称赞。", "result": {"counter+7100004": 3, "counter+7100003": 3}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000057}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "哲瓦德"}, "s2": {"condition": {"is": 2000782}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "贪污官员们，哲瓦德的崇拜者"}, "s3": {"condition": {"is": 2000781}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "哲瓦德的打手们"}, "s4": {"condition": {"is": 2000774}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "阿鲁米娜"}, "s5": {"condition": {"type": "item", "cost.哲瓦德的优势": [1, 999]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "哲瓦德一直在等待复仇的时机……"}, "s6": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "需要主角亲自上"}, "s7": {"condition": {"部队": 1, "any": {"type": "char", "is": "2000554"}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "属于你的部队，是必要的"}, "s8": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "追随者"}, "s9": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "可以提升能力的消耗品"}, "s10": {"condition": {"type": "sudan", "any": {"杀戮": 1, "征服": 1}, "rare<=": 2}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "青铜稀有度的征服卡或者杀戮卡"}}, "is_replay": 0, "auto_start": false, "st