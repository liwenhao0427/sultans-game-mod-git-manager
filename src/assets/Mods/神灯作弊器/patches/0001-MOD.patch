+{"id": 5206523, "name": "孤女复仇记", "text": "一本突然流行起来的，关于复仇的故事。", "tips": "", "mapping_id": 8001005, "once_new": 1, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"is": 2000123}, "result_title": "", "result_text": "鲁梅拉年轻的声音在书斋里响起，语调像和仆人们讲故事时那样平静。这本书中，描述了一个与母亲相依为命的少女的故事，嗜酒的暴虐父亲反复出卖母亲来换取金钱，而懦弱的母亲却离不开这样的男人，不断地骗着自己说“这就是爱情”……母亲惨死后，少女在一位贵族主人的帮助下，逐渐振作起来，策划着对父亲的复仇……\n读完书之后，鲁梅拉低着头，不太自在地请求离开。你望着她匆匆的背影，忍不住微笑起来。\n确实，无论怎么读，这书里提到的都是你。那名少女是谁，自然也昭然若揭了。", "result": {"s2+智慧": 1, "s2+生存": 1, "clean.s1": 1}, "action": {"event_on": 5320032}}, {"condition": {}, "result_title": "", "result_text": "书中描述了一个与母亲相依为命的少女的故事，嗜酒又嗜赌的暴虐父亲反复出卖母亲来换取金钱，而懦弱的母亲却离不开这样的男人，不断地骗着自己说“这就是爱情”……母亲惨死后，少女在一位贵族主人的帮助下，逐渐振作起来，策划着对父亲的复仇……确实，无论怎么读，这书里提到的都是你。那名少女是谁，自然也昭然若揭了。", "result": {"s2+智慧": 1, "s2+生存": 1, "clean.s1": 1}, "action": {"event_on": 5320032}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000548}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "《孤女复仇记》"}, "s2": {"condition": {"type": "char", "!动物": 1, "!怪物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阅读者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
