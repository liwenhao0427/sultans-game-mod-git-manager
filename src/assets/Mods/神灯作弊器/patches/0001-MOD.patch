+{"id": 5206064, "name": "探访踪迹", "text": "阿迪莱和哲巴尔正在找寻龙的踪迹。", "tips": "", "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "阿迪莱和哲巴尔找到了龙的踪迹", "result_text": "按照《屠龙之书》的描述，龙很少留下足迹，因为这些大蜥蜴很谨慎，它们知道自己的脚印太特殊，会被认出来，所以，它们只会在坚硬的、不会留痕迹的岩石上歇脚。但百密一疏地，它们忘记了自己喷吐的硫磺气息也会留下痕迹。\n阿迪莱和哲巴尔在一处符合条件的栖息地附近找到了带着这种痕迹的石头，龙巢就在附近。他们传信回来，告诉你，接下来他们将确认龙巢的位置，如果有机会的话，他们打算伺机潜入布置陷阱、设下埋伏，狠狠给这条该死的蜥蜴一个惊喜……", "result": {}, "action": {"rite": 5006066}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000061}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿迪莱正在冒险"}, "s2": {"condition": {"type": "char", "is": 2000054}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哲巴尔正在冒险"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
