": {}}], "settlement_extre": [{"condition": {"s3.金币>=": 1}, "result_title": "损失不小", "result_text": "这些钱即使你也要挣很久呢！你想想就来气，这老贼的贪婪程度堪比苏丹！", "result": {"clean.s3": 1}, "action": {}}, {"condition": {"s3.金币=": 0}, "result_title": "", "result_text": "早上起来你才发现：阿里木在你的房梁上刻了一个“穷”字。", "result": {}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000113}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "半夜，他敲打你窗"}, "s2": {"condition": {"type": "item", "is": 2000885}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "阿里木为他而来"}, "s3": {"condition": {"type": "item", "cost.金币": [1, 10]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "阿里木偷窃了你的金币"}, "s4": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以亲自，或派遣任意追随者去办这件差事"}, "s5": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以亲自，或派遣任意追随者去办这件差事"}, "s6": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "任何你觉得有帮助的东西"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
