+{"id": 5206021, "name": "强者待遇", "text": "你发现，从此之后，这个装了生命权杖的人就出名了。他每周都有一天要去干全城络绎不绝向它求爱和求欢的人。没办法，没法拒绝，而且不是你给他装的么！这就是结果！", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[4,12]", "icon": "rite_22", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你也可以参与进去，同时折断一张和这位盟友品级符合的纵欲苏丹卡。", "即便不参与，这位盟友也能为你带来不菲的好处。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"!s2": 1}, "result_title": "", "result_text": "盟友大干一场。", "result": {"loot": 6000057}, "action": {}}, {"condition": {"!s1.妻子": 1, "s2": 1}, "result_title": "", "result_text": "玩家爽翻了。", "result": {"card": 2000083}, "action": {}}, {"condition": {"s1.妻子": 1, "s2": 1}, "result_title": "", "result_text": "玩家爽翻了。", "result": {}, "action": {}}], "settlement_extre": [{"condition": {"s2": 1, "s3": 1}, "result_title": "", "result_text": "消除苏丹卡", "result": {"clean.s3": 1}, "action": {"event_on": 5320519}}], "cards_slot": {"s1": {"condition": {"type": "char", "生命权杖": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "接受权杖手术的人"}, "s2": {"condition": {"主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你自己也可以加入进来"}, "s3": {"condition": {"type": "sudan", "纵欲": 1, "f:rare-s1.rare<=": 0}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "品级不高于权杖使用者的纵欲卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
