+{"id": 5420001, "text": "领路者", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120001}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"coin": 3, "no_prompt": {"table.2000062-事件提示": 1}, "counter+7000118": 1, "prompt": {"id": "5420001_prompt_01", "text": "<size=+10><font=\"TitleSDF\"><b>你的善良成为了年轻人的榜样</b></font></size>\n法图娜和她的儿子扎齐伊一起拜访你，为你送上了一份礼物。这是为了感激你为她的儿子树立起了道德的楷模，“他现在会体恤家中老年仆人的生活，还会主动过问领地的税收……我真的太高兴、太感动了，这都多亏了您。”", "icon": ["cards/2000062", "cards/2000063", null]}}}]}
