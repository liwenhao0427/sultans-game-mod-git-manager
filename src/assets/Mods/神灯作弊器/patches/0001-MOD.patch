+{"id": 5200685, "name": "实地走访", "text": "根据女仆给的线索，你着手调查那名税吏的案件——首先要调查清楚的就是，他的妻儿是走哪一条路回乡的，又是在什么地方失踪的？你决定派人亲自走一趟，到实地展开调查。", "tips": "", "mapping_id": 8001131, "once_new": 1, "round_number": 7, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "5200685_prompt_1", "text": "找你求助的女仆等了你三天，希望你有所动作，但她注定要失望了。"}, "event_on": 5300350}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[1,6]", "icon": "rite_16", "tag_tips": [], "tag_tips_up": {"tips": ["生存"], "type": "normal_result"}, "tips_text": ["这将是1个长达7天的追踪调查，请谨慎选择调查员。", "失败后可以重新展开调查，但也有可能会打草惊蛇，再无所获。"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "[s1.name]展开地图，希望能找到那位夫人离去的蛛丝马迹……", "type": "normal_result", "type_tips": "你的生存为你提供完整的骰子数量。", "low_target": 2, "low_target_tips": "你至少需要2点成功才能有所收获。"}}, "settlement_prior": [{"condition": {"r1:生存>=": [2, 5]}, "result_title": "有所发现", "result_text": "经过不懈的调查，[s1.name]在一个驿站发现了那名税吏的妻儿的记录——这个驿站甚至离她父母所在的城市非常近——之后便不知所踪。看来她的确安全地离开了城市，如果是税吏谋杀她，不可能等这么久、走这么远才动手……", "result": {"pop.5200685_1.s1": "幸不辱命"}, "action": {"event_on": 5300344}}, {"condition": {"r1:生存<": [2, 5], "counter.7000114<=": 2}, "result_title": "你茫然地看了看四周", "result_text": "一无所获，下次再来", "result": {"pop.5200685_2.s1": "下次一定！", "counter+7000114": 1}, "action": {"rite": 5200685}}, {"condition": {"r1:生存<": [2, 5], "counter.7000114>": 2}, "result_title": "你茫然地看了看四周", "result_text": "一无所获，时间过去太久了……你再也无法找到有价值的线索。", "result": {"pop.5200685_3.s1": "没有机会了。"}, "action": {}}], "settlement": [], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你可以亲自，或派遣追随者展开调查", "pops": [{"condition": {"f:s1.生存+s2.生存<": 2}, "action": {"pop.5200685_s1_01.self": "以目前己方的<b><color=white>【生存】</color></b>能力，就不要去浪费时间了吧。"}}, {"condition": {"f:s1.生存+s2.生存>=": 2, "!s2": 1}, "action": {"pop.5200685_s1_02.self": "如果有<