+{"id": 5420264, "text": "宫廷-索要妃子-星星的秘密", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120264}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"prompt": {"id": "5420264_prompt_01", "text": "仿佛知道你在忧心的事情，有一天，鲁梅拉将一本陈旧的古书放到了你的桌上：上面记载了星灵——也就是高原人曾经崇拜的神明是如何与凡人交媾，在一次次转世中获得更多力量的故事。\n一段文字中提到，越强大的星灵就需要越高贵的人间血脉进行转生……否则它们就会在凡间失去力量，甚至记忆。\n你什么时候买过这本书来着？", "icon": "cards/2000123"}, "event_off": 5320265}}]}
