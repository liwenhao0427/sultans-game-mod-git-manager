@@ -0,0 +1 @@
+{"id": 5206619, "name": "让我尝尝", "text": "加了冰酪和蜂蜜的莓果会是什么味道？你可以再买一些莓果，让小圆多做一些来尝尝。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_18", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["一个难得放松的时光"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "小圆端上了食物，期待地看着你。", "result": {}, "action": {}}, {"condition": {}, "result_title": "", "result_text": "酸甜的莓果蘸着薄薄一层晶亮的蜂蜜，而细细的薄荷碎给冰酪更增了几份清爽，颇具巧思。你发出轻微的喟叹，享受着这难得的消遣。", "result": {"s2+体魄": 1}, "action": {}}, {"condition": {"s3": 1}, "result_title": "", "result_text": "梅姬靠在你身边，微笑着，说自己访友时吃过类似的点心，但都没有小圆做得好吃。小圆脸蛋红扑扑的，羞怯的眼睛却在闪闪发光。", "result": {"s3+体魄": 1}, "action": {}}, {"condition": {"!s4": 1}, "result_title": "", "result_text": "你心情大好，叫小圆也一起分吃这份难得的消热佳品。她受宠若惊地叩首，接着又小心翼翼地问可不可以带回去吃。你当然没有意见。她再次叩首致谢，接着小心翼翼地捧着一小碗冰酪，一溜烟跑没了踪影。不知是不习惯与你们同席，还是急于想和谁人分享呢？", "result": {"s1+体魄": 1}, "action": {}}, {"condition": {"s4": 1}, "result_title": "", "result_text": "你让小圆把铁头也叫来，一起分吃这份难得的消热佳品。她受宠若惊地叩首，接着一溜烟跑去把铁头拉进来，盛了小小一碗给他，满怀期待地望着他。\n铁头先是向你致谢，这才坐到小圆身边。他动作慢吞吞的，反而有一种奇异的、不符合奴隶身份的优雅和稳重——仿佛他对这样贵重的珍馐早已司空见惯似的，不急于一时口欲。\n可是，为什么呢？你第一次觉得，自己多年前买回来的这名奴隶，颇有些不同寻常。", "result": {"s1+体魄": 1, "s4+体魄": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000371}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "小圆已经跃跃欲试"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你决心亲自品尝"}, "s3": {"condition": {"type": "char", "妻子": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你当然可以邀请梅姬一起分享"}, "s4": {"condition": {"type": "char", "is": 2000369}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你也可以邀请铁头来尝尝他提过的美味"}, "s5": {"condition": {"type": "item", "cost.金币": 2}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "制作费用2金币"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
