+{"id": 5208056, "name": "应许时刻", "text": "法尔达克的请求被苏丹冷酷地拒绝了，现在谁还不知，他的家乡已是他再回不去的地方。\n近乎本能地，失魂落魄的法尔达克再一次来到你的门前。", "tips": "", "mapping_id": 8001107, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_16", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["不同的选择会开启不同的剧情与后续事件"], "open_conditions": [{"condition": {"any": {"s2": 1, "s3": 1, "s4": 1}}, "tips": "你必须亲自接待法尔达克。"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1}, "result_title": "苦中作乐", "result_text": "事到如今，除了接受这残酷的命运，又还能做些什么呢？你们相对而坐，谁也没有说话。\n你在他眼睛里看到了熟悉的疲惫和绝望，也许，他也从你眼中看到了同样的东西。你们如同大海上面对着同一场风暴的两艘小船……他向你靠近，又或者是你向他靠近，那都不重要了。你们抱住了彼此。", "result": {}, "action": {"rite": 5008057}}, {"condition": {"s3": 1}, "result_title": "我可以帮你逃走", "result_text": "这不是一件简单的事，而你一向不会开这种玩笑的……法尔达克吃惊地瞪大了眼睛，等着你继续说下去。", "result": {}, "action": {"rite": 5008058}}, {"condition": {"have.2000853": 1, "s4": 1}, "result_title": "你要像老鼠一样……", "result_text": "你安抚着焦躁又悲伤的年轻人，告诉他，那条险峻的、属于狮子和羚羊的小径，那天未被苏丹发现的小径，那是他唯一的出路。但他不能就这样偷偷离开……他必须像老鼠一样把自己藏在苏丹宫殿的阴影之中，而后再趁着苏丹不注意，飞速地钻出去。\n法尔达克长长地叹了口气，捏紧了拳头，“我当然，我当然能等……！不急在一时。”\n他许诺了不会做什么过激的、冲动的事，离开前，他将一把锋利的短刀塞到你手里。\n“……我原本……我原本想用它自裁的。送给您吧，不然我每次想到它，那个念头就都会抓住我。”", "result": {"card": [2000854, "已拥有+1"], "s1+智慧": 1}, "action": {"counter+7000353": 1}}, {"condition": {"!have.2000853": 1, "s4": 1}, "result_title": "你要像老鼠一样……", "result_text": "你安抚着焦躁又悲伤的年轻人，告诉他，他唯一能做的就是像老鼠一样把自己藏在苏丹宫殿的阴影之中，而后再趁着苏丹不注意，飞速地钻出去。\n可惜……你又想起了那条小径，如果它还未被苏丹所知，也许还能成为法尔达克的退路吧……一切都太迟了。", "result": {}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000350}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "法尔达克"}, "s2": {"condition": {"type": "char", "主角": 1, "!s3": 1, "!s4": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择拥抱他，劝说他接受这残酷的命运", "pops": [{"condition": {"s2": 1}, "action": {"pop.5208056_s2_01.s1": "我该怎么办才好？", "pop.5208056_s2_02.s2": "接受这残酷的命运吧，我可以教你快乐的秘诀……"}}]}, "s3": {"condition": {"type": "char", "主角": 1, "!s2": 1, "!s4": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择告诉他，你可以帮助他逃走……", "pops": [{"condition": {"s3": 1}, "action": {"pop.5208056_s3_01.s1": "我该怎么办才好？", "pop.5208056_s3_02.s3": "如果你真的想要离开，我可以帮你。"}}]}, "s4": {"condition": {"type": "char", "主角": 1, "!s2": 1, "!s3": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择告诉他，他应像老鼠一样……", "pops": [{"condition": {"s4": 1}, "action": {"pop.5208056_s4_01.s1": "我该怎么办才好？", "pop.5208056_s4_02.s4": "你要像老鼠一样，等待时机……"}}]}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
