@@ -0,0 +1 @@
+{"id": 5206053, "name": "梅姬，我问你……", "text": "阿迪莱突然的摊牌让你有点睡不着觉了。翻来覆去好久之后，你实在忍不住，把梅姬叫醒了……", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_10", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "你把阿迪莱说的话全都告诉了梅姬", "result_text": "梅姬原本困得迷迷蒙蒙的，听了你的话，顿时睁大眼，愣了好一会才醒过神来。\n“亲爱的阿迪莱，我的天啊……我从没想过她是这样想的……这么说来，哦……嗯……”她似乎是逐渐回忆起了阿迪莱与她相处时的种种表现，“她确实说过，她从来都想不出自己和男人在一起是什么样……”\n她陷入了某种沉沉的思绪之中……阿迪莱要在屠龙成功后带她私奔……她会怎么想？你紧张地盯着她，迫切想从她的眼珠里看出点什么。", "result": {}, "action": {}}, {"condition": {"counter.7000182>=": 3}, "result_title": "", "result_text": "几乎是下意识地，梅姬点了点头，而后，像是刚刚想起你还在她身边，她又赶紧摇了摇头。\n“我不会放弃做这栋宅邸的女主人，而去做一个女战士的……情人的，这太蠢了，对吧？”\n你原本希望她说一些诸如她爱你之类的诺言……但梅姬轻轻打了个哈欠，“快睡吧，亲爱的。”\n好吧，眼下这样的保证也算是让人放心。\n阿迪莱还未归来，这一切都还是未知数，你只能先压下心中的不安，不去想这些。", "result": {}, "action": {}}, {"condition": {"counter.7000182<": 3, "counter.7000182>": 0}, "result_title": "", "result_text": "而梅姬只是困惑地歪着头，努力思考了好一会，才确认这不是一个笑话。\n“带我私奔？但我并不想跟她私奔，她怎么能这么说？我对她并没有什么爱恋的感情……天啊，我对你之外的人都没有、没有过！”\n她睁大眼睛望着你，“等等，你该不会怀疑我……”\n噢，天啊，你赶紧表示你当然从未怀疑过你们之间的感情，并为此赌咒发誓。梅姬怀疑的目光在你脸上停了一会儿，接着便阖上了，“好了亲爱的，睡吧，很晚了。”\n这件事到此为止，你轻轻松了口气。都怪阿迪莱说的那些疯话。", "result": {}, "action": {}}, {"condition": {"counter.7000182<=": 0}, "result_title": "", "result_text": "“啊，她怎么能说这种话，对我的丈夫说这种话！”\n梅姬终于回过神来，她重重地捏着拳头：“嫁给你是我这辈子最幸福的事，哪怕是一起经历苏丹的折磨，我都从没后悔过，她怎么会、怎么会认为我对你的爱意是，是那么肤浅的东西！”\n梅姬生气了好一会儿，又自责是否是自己给了阿迪莱太多的错觉，你连忙将她拥入怀中，低声安慰她，你们俩依偎在一起，很快就在柔和的烛光中静静地、安心地睡去。", "result": {}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "妻子": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你实在是很想问问梅姬"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
