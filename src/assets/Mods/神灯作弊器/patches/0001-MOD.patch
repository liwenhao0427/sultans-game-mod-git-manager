+{"id": 5200702, "name": "无尽黄沙", "text": "根据哲巴尔家族代代相传的古地图，在大沙漠的中心，有一块水土丰沃，尚未被文明触碰的绿洲。那里有森林也有湖泊，如果想要前往未知的远方冒险，一定要以它作为补给点，才能穿越沙漠。", "tips": "", "mapping_id": 8001262, "once_new": 0, "round_number": 7, "waiting_round": 2, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_4", "tag_tips": ["体魄", "生存"], "tag_tips_up": {"tips": ["体魄", "生存"], "type": "normal_result"}, "tips_text": ["耗时长久，请做好准备", "每个岗位都有不同的属性需求才能胜任，但探索的成败取决于生存与体魄"], "open_conditions": [], "random_text": {"r1": "穿越沙漠，寻找根据地。"}, "random_text_up": {"r1": {"text": "穿越沙漠，找到根据地。", "type": "normal_result", "type_tips": "你的体魄和生存为你提供了完整的骰子数量。", "low_target": 10, "low_target_tips": "你至少需要10点成功才能抵达目的地。"}}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"r1:体魄+生存>=": [10, 5]}, "result_title": "成功！", "result_text": "冒险队归来了，他们遭遇了沙匪，巨大的蝎子，恐怖的流沙，狼群……更不要说白天的酷暑与夜晚的彻骨冰寒，还有饥饿与干渴……\n 但没有人觉得这不值得，他们描述那甘美的泉水，那碧绿的森林与金色的晨光……一个神圣而美丽，不为外人所知的秘境，足以传承给后代的乐土，即使是苏丹也未曾知晓它，也无法征服它。", "result": {"s1+生存": 1, "s2+生存": 1, "s3+生存": 1, "s4+生存": 1, "card": [2000317, "已拥有+1"], "clean.s7": 1}, "action": {}}, {"condition": {"r1:体魄+生存<": [10, 5]}, "result_title": "队伍没能达到目的地。", "result_text": "探险队耗尽了水和粮食，在沙漠里行进到了极限……但仍然没有找到绿洲的身影。也许它根本不存在？世界上岂能有真正的乐土？", "result": {"s2+equip": 2000098, "s3+equip": 2000098, "s4+equip": 2000098}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000054, "counter.7000228>=": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "爱冒险的将军，今次会来吗？"}, "s2": {"condition": {"type": "char", "生存>=": 4}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "队伍的向导，需要生存属性大于等于4"}, "s3": {"condition": {"type": "char", "战斗>=": 4}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "对付野兽与盗匪的战士，需要战斗属性大于等于4"}, "s4": {"condition": {"type": "char", "智慧>=": 4}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "能够绘制地图、计算星象、分辨古迹的智者，需要智慧属性大于等于4"}, "s5": {"condition": {"type": "item", "cost.金币": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须投入5金币作为冒险资金"}, "s6": {"condition": {"type": "item", "cost.消耗品=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些道具能在冒险中派上用场"}, "s7": {"condition": {"type": "item", "is": 2000707}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "冒险的起点"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
