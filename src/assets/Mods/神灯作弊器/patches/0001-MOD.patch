+{"id": 5420522, "text": "酒与肉", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120522}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"counter+7000169": 1, "rite": 5006029, "prompt": {"id": "5420522_prompt_01", "text": "阿迪莱叩响你的家门。她一手提着包油腻腻的烤羊肉，另一手抱着酒瓶，似乎是在从集市回家的路上顺道过来的。\n“啊，是您，一起喝一杯吗？”她冲你举举酒瓶，就像是集市上的屠夫邀请卖家禽的小贩一样，“虽说我本来是来找您夫人的……”", "icon": "cards/2000061"}, "table.2000061-事件提示": 1, "success": {"event_off": 5420522}}}]}
