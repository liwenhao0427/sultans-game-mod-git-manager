+{"id": 5201104, "name": "香消玉殒", "text": "宫廷里弥漫着沉重的气息……所有人都战战兢兢，噤声不言。某些重大的事情正在发生，也许你早有预感，但已无可挽回。", "tips": "", "mapping_id": 8001167, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_11", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["面对这样的变故，你已经没有什么可以做的了。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "阿图娜尔的尸首被拖出宫廷，看起来遭受了严酷的刑罚。\n人们震撼、恐惧于苏丹的喜怒无常，只有你知道这一切是为什么……那头猛兽正以他凶悍的眼眸扫视他的王国，找寻这个女人的同谋。\n你不能为她的死流露出一丝悲哀。告慰她的唯一途径，只有赢下这场竞速游戏。", "result": {"clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000129}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿图娜尔在劫难逃"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
