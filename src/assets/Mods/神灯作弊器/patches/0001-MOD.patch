+{"id": 5208120, "name": "苏丹的戏弄", "text": "苏丹告诉你，他有点想念上次在你舍馆里吃到的美食……所以，现在是时候展现你的忠诚了。", "tips": "", "mapping_id": 8001008, "once_new": 1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_14", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每回合会扣除一张苏丹的耐心。", "当苏丹的耐心为0时，游戏就会结束。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [{"condition": {"s1.大餐": 1}, "result_title": "", "result_text": "你端来哈比卜亲手做的美食，酒足饭饱之后，苏丹大发慈悲地放过你了。", "result": {"clean.s2": 1, "counter+7100003": 1}, "action": {}}], "settlement": [{"condition": {"s2": 1}, "result_title": "", "result_text": "苏丹的耐心在消解。", "result": {"clean.s2": 1}, "action": {}}, {"condition": {"!s2": 1}, "result_title": "", "result_text": "苏丹不一定真的相信流言，但他无法忍受你的不服从。", "result": {}, "action": {}}], "settlement_extre": [{"condition": {"耐心<=": 0}, "result_title": "", "result_text": "你被处死了。", "result": {"global_counter=7200005": 1}, "action": {"over": 1}}, {"condition": {"耐心>": 0}, "result_title": "", "result_text": "今天已被你蒙混过去，但苏丹的耐心已经不多了", "result": {}, "action": {"rite": 5001002}}], "cards_slot": {"s1": {"condition": {"type": "item", "大餐": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "任意大餐"}, "s2": {"condition": {"type": "item", "is": 2001053, "cost.耐心": [1, 3]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "苏丹的耐心"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
