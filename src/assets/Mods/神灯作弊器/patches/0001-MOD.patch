@@ -0,0 +1 @@
+{"id": 5400605, "text": "禁忌的画册", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100605}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400605_option_1", "text": "最近，城里秘密流传起一本十分露骨的画册，主角是你和苏丹……", "icon": "cards/2000001", "items": [{"text": "严厉打击！", "tag": "op1"}, {"text": "微妙暗示", "tag": "op2"}, {"text": "请示苏丹", "tag": "op3"}, {"text": "让我品品", "tag": "op4"}]}, "case:op1": {"counter-7100004": 1, "counter+7100002": 1, "prompt": {"id": "5400605_prompt_1", "text": "如此奇怪的口味！多么亵渎的想法！你一想到这本书的内容就浑身难受，坐立不安。于是，你连夜派遣卫兵查抄了所有售卖这本书的黑店，甚至砍了好几个抄书人的脑袋。如此兴师动众的一夜过去，朝堂上所有人都忍着笑称赞你的雷厉风行，你成了全城人的笑柄，连苏丹看你的眼神都带着些玩味……", "icon": "cards/2000001"}}, "case:op2": {"counter+7100003": 1, "prompt": {"id": "5400605_prompt_2", "text": "所有人都知道这本描绘了你和苏丹的禁忌爱情和肉欲的画册只是个笑话，他们故意当着你的面谈起，想嘲弄你一番，但你暧昧且意味深长地微笑着，既不肯定，也不否定。于是，所有人又沉默下去了。他们看向你的目光中，很长一段时间中都带着隐隐的敬畏和讨好。", "icon": "cards/2000001"}}, "case:op3": {"coin": 5, "prompt": {"id": "5400605_prompt_3", "text": "这件事事关重大……你隐姓埋名买到一本画册，呈给苏丹，请示该如何处理。苏丹饶有兴致地翻阅了几页，微笑着收下了它。\n等等，这是什么意思……一瞬间，你汗都流下来了。你无法自制地胡思乱想着，最后拿着苏丹赏赐的金子离开宫廷时，还感到你至高无上的王那束兴味颇丰的目光缠绕在你的背上……", "icon": "cards/2000001"}}, "case:op4": {"card": 2000541, "prompt": {"id": "5400605_prompt_4", "text": "还有这样的画册？这你不得买一本回来品鉴一番？……于是，那段时间里，你满脑子都是书中那些充满禁忌、暧昧和情欲的画面……也许……咳咳，也许有一天，你能让它成真呢…………", "icon": "cards/2000001"}}}}]}
