+++ b/event/trigger_events/5420022.json
@@ -0,0 +1 @@
+{"id": 5420022, "text": "读书会", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120022}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5420022_option_01", "text": "你最近偶然发现，每到午后不那么忙的时分，仆人们都会聚在书斋，聚在鲁梅拉身边听她读书。那纸上的字迹还没晾干，似乎是鲁梅拉自己写的。\n“……她把水罐摔碎在石头上，牛奶流进了河中，但她一点也不觉得后悔，因为这是仇人给她的，仇人给的蜜糖即是毒药。”鲁梅拉缓声读着，声音没什么起伏，但吐字非常清晰，“艾波罗丝怒声咒骂着给她牛奶的男人，她说，她宁愿饿死，也不会靠杀死自己母亲之人的施舍过活。”\n女仆们听得入迷了，她们七嘴八舌讨论着鲁梅拉读的故事，讨论女主角该不该摔碎那只牛奶罐，直到老女奴提醒大家主人的午餐要开始了，才四散去干活了。\n鲁梅拉这才注意到了廊下的你，向你跪拜行礼之后，又有些紧张地绞着衣袍：“您觉得呢，主人，艾波罗丝该留下仇人给的牛奶吗？”", "icon": "cards/2000123", "items": [{"text": "应该留下", "tag": "op1"}, {"text": "不该留下", "tag": "op2"}, {"text": "别浪费仆人的时间了", "tag": "op3"}]}, "case:op1": {"counter+7100001": 1, "counter+7000132": 1, "prompt": {"id": "5420022_prompt_01", "text": "你告诉她，在你看来，荣誉远不如幸福重要，又或者说，人活着的终极目标应该是让自己幸福，荣誉只是幸福的手段之一。而对于书中女主角的孩子来说，一口热牛奶就是幸福，因此，你认为她应该把牛奶带回家，至于仇恨，还是放下吧。\n“您总是对的。”鲁梅拉望着你，顺从地点了点头。过了一会儿，有些难以启齿似的，又问，“那我还能还能继续给她们讲故事吗？”\n你微笑着允诺。", "icon": ["cards/2000123", "cards/2000001", null]}}, "case:op2": {"counter+7100004": 1, "counter+7000133": 1, "prompt": {"id": "5420022_prompt_02", "text": "你告诉她，如果接受了仇人的恩赐，就要质问自己的内心，是否还要坚持复仇。牛奶别人也有、不喝牛奶也可以活下去，但复仇……这件事只有一种解决方式。\n她听了你的话，用力地点了点头。过了一会儿，有些难以启齿似的，又问，“那我还能还能继续给她们讲故事吗？”\n你微笑着允诺。", "icon": ["cards/2000123", "cards/2000001", null]}}, "case:op3": {"counter+7100003": 1, "prompt": {"id": "5420022_prompt_03", "text": "你瞪了她一眼，让她别管故事里的傻问题了，更重要的是，她不该占用仆人们这么多时间。你把她们买回来可不是让她们来听故事的。\n鲁梅拉愣了愣，“我知道了。”她收起书，小声向你道歉，接着面无表情地离开了书斋。", "icon": ["cards/2000123", "cards/2000001", null]}}}}]}
