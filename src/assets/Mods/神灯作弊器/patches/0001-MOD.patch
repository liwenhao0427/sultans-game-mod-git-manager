+{"id": 5200666, "name": "远方的乐土", "text": "一名风尘仆仆的信使叩响了你家的大门。", "tips": "", "mapping_id": 8001063, "once_new": 0, "round_number": 0, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你必须给信使一点钱，他才会把信交给你。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "你掏钱打发了信使", "result_text": "你认出信封上的是麦娜尔的字迹。\n她在信中说，她已经找到了一个安全的栖身地，那里远离苏丹的统治，水草丰美，气候温和，那里的统治者英明仁慈，人民富庶友善……信封里还附了一张地图，为你详细标明了前往那片乐土的途径及必要的说明和注解。\n你知道，倘若你厌倦了这场游戏，倘若你决心离开，这是你最后的退路。保管好它，别被苏丹知晓。", "result": {"counter+7000507": 1, "card": [2000366, "已拥有+1"], "global_counter=7200161": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你需要给1金币小费"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
