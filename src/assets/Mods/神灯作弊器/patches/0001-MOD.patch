+{"id": 5204810, "name": "疯癫与幻觉", "text": "就在砖石后面，就在看不见的地方，有东西在沙沙作响，有东西在奔跑，有东西在窥视你的生活！", "tips": "", "mapping_id": 8001004, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["疯狂会带来多种不同的影响", "疯狂数量越多，对你的伤害越大", "三个以上的疯狂会带来死亡或者更糟糕的结局"], "open_conditions": [{"condition": {"any": {"all": {"s5.is": 2000021, "counter.7000561<": 1}, "!s5": 1, "s5.金币": 5, "s5.is": 2000382}}, "tips": "这个东西不解决问题"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s5.is": 2000022, "counter.7000560<": 1}, "result_title": "诅咒的编织方式", "result_text": "很多事情都可以从不同的角度去思考，去解决。诅咒对大多数人来说都是一种痛苦与折磨，但密教徒将其视作由自身的沃土所栽培的果实……现在只需要将其摘下。\n拜铃耶告诉你，这样隐秘的动静绝非扰人的诅咒，而是一种启示……一种接近先知的能力：她将嘴唇贴近你的耳朵，一字一句地把它们翻译了给你……", "result": {"counter+7100005": 1, "counter+7000560": 1, "counter+7100006": 1, "counter+7000563": 1, "counter+7000569": 1}, "action": {}}, {"condition": {"s5.is": 2000021, "counter.7000561<": 1}, "result_title": "一次净化", "result_text": "伊曼把金色的钉子敲入你宅邸内的每一面墙……让它们一个个的安静了下来——他把最后一颗钉子留给了你。当他刺穿你的肩膀之后，一阵不祥的恶臭被排放了出来，你整个人都焕然一新。", "result": {"counter+7100005": 1, "counter+7000561": 1, "s1+魅力": 1, "counter+7000563": 1}, "action": {}}, {"condition": {"s5.金币": 5}, "result_title": "彻底解决", "result_text": "最后，不顾众人的抗议，把家里的墙砸了个稀烂……终于，终于没有东西可以躲在墙后面了！当然，至少在仆人们收拾好家里的残骸之前，也没人敢来你家了……", "result": {"counter+7100005": 1, "counter=7000567": 7, "counter+7000563": 1}, "action": {}}, {"condition": {"s5.is": 2000723}, "result_title": "一次冥想", "result_text": "你知道这不是真实的疾病，而是源于自己心智受损的幻觉。熏香，放松，喝一些混有草药的乳酒，把自己困惑的事情都写在羊皮纸上……最后再洗了个热水澡。\n第二天，你感觉好了很多……不过你也明白，自己没有真正的被治愈。", "result": {"clean.s5": 1, "clean.s2": 1}, "action": {}}, {"condition": {"s5.is": 2000306}, "result_title": "虚假医疗", "result_text": "将药草点燃，熏自己的耳朵……也许是安慰作用吧，这暂时缓解了你的痛苦。", "result": {"counter+7100005": 1}, "action": {}}, {"condition": {"s5.is": 2000382}, "result_title": "虚假医疗", "result_text": "将生命之水滴进耳朵里……也许是安慰作用吧，这暂时缓解了你的痛苦。", "result": {"counter+7100005": 1}, "action": {}}, {"condition": {"!s5": 1, "s2.疯狂=": 1}, "result_title": "睡眠缺乏", "result_text": "每一晚，你都被这样的奇怪动静所惊扰，有时候好似老鼠偷窃，有时候好似公牛在斗殴……这彻底摧毁了你的睡眠。", "result": {"counter+7100005": 1, "s1-魅力": 2}, "action": {}}, {"condition": {"!s5": 1, "s2.疯狂=": 2}, "result_title": "昏聩之症", "result_text": "现在，你脑子里无时无刻都响着那些声音，这让你彻底没法集中精力干任何事情了。", "result": {"counter+7100005": 1, "s1-魅力": 2, "s1-智慧": 2}, "action": {}}, {"condition": {"!s5": 1, "s2.疯狂>=": 3}, "result_title": "彻底安静", "result_text": "最终，这种缓慢的折磨让你崩溃了。你用头撞击墙壁，直到流血，直到头颅开裂，直到死亡……", "result": {"s1-魅力": 2, "s1-智慧": 2, "clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "主角": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "主角"}, "s2": {"condition": {"is": 2000326, "cost.疯狂": [1, 99]}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "疯狂"}, "s3": {"condition": {"any": {"is": 2000844}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "恶？"}, "s4": {"condition": {"any": {"is": 2000848}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "善？"}, "s5": {"condition": {"any": {"is": 2000021, "all": {"type": "item", "cost.金币": 5}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "缓解之道", "pops": [{"condition": {"s5.is": 2000022, "counter.7000560>=": 1}, "action": {"pop.5204810_s5_01.s5": "不行，我已经没法再帮你了，上一次帮你已经是极限了。"}}, {"condition": {"s5.is": 2000021, "counter.7000561>=": 1}, "action": {"pop.5204810_s5_02.s5": "不行，我已经没法再帮你了，上一次帮你已经是极限了。"}}]}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
