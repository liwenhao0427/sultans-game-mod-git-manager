+{"id": 5204903, "name": "魅魔之力", "text": "苏丹对你进献的魅魔非常满意！他哈哈大笑着拍拍你的肩膀，此前君臣之间的小小龃龉就此一笔勾销。", "tips": "", "mapping_id": 8001008, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "看得出来，他现在根本没空跟你计较那些曾经能要了你的命的“小事”了。\n唉！要是能把这个该死的七天不折卡就斩首的规则也忘了就好了。", "result": {"clean.s1": 1, "no_show": {"table.clean.2000680": 99}}, "action": {"global_counter=7200227": 1}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000680}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "苏丹的猜忌"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
