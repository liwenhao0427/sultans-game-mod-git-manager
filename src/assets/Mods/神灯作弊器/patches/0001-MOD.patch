+{"id": 5200505, "name": "宫廷处刑", "text": "应你的要求，苏丹同意你处决阿穆尔，以此抵消一张杀戮卡。", "tips": "", "mapping_id": 8001216, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_21", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["这是根据你的选择产生的一个既成事件，你无法改变或者取消它"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "阿穆尔跪在长阶之下，颤抖着嘴唇，但一句求饶的话都没有说。他知道，一切已经无可挽回了。他不是死于自己的罪过，他没有犯下任何罪。女奴不过一件商品，他有权用任何方式处置她们。他是被你、被你拿出的那张卡片杀死的。直到你斩下他的头颅，他的眼睛也没有闭上。他将永世不绝的怨恨狠狠地钉在你身上，他愿用灵魂诅咒你沦陷不幸的泥沼，永生永世、永生永世！", "result": {"clean.s1": 1, "clean.s2": 1, "card": 2000186, "counter+7000010": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000164}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "法务官阿穆尔被带到了宫廷，颤抖着等待你的处决。"}, "s2": {"condition": {"type": "sudan", "杀戮": 1, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须置入一张配得上法务官的杀戮卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
