+{"id": 5208028, "name": "我都知道了！", "text": "不知道到底是谁走漏了风声，梅姬对你怒目而视。你在内宅和人做过的那场仪式，她全都知道了！", "tips": "", "mapping_id": 8001077, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"card": 2000083, "prompt": {"id": "prompt_5208028_01", "text": "你什么都没有做，梅姬也没什么都没有说。冷漠在你们两人中间劈开更深的隔阂。\n不是说好的是可保内宅安宁的仪式吗？你在心里大骂了盖斯三百次。"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_10", "tag_tips": [], "tag_tips_up": {"tips": ["社交", "隐匿"], "type": "fight_result"}, "tips_text": ["最好哄哄妻子。"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "你能哄好梅姬吗", "type": "fight_result", "type_tips": "你的社交和隐匿为你提供了完整的骰子数量。", "low_target": 1, "low_target_tips": "你至少需要1点成功才能获得胜利。"}}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"r1:社交+隐匿>=": [1, 5]}, "result_title": "", "result_text": "你告诉梅姬，之所以选择别人，是因为你太珍惜她了，不想让任何你之外的人见到她美丽的胴体。你又请她设身处地地想想，难道她想要在那种破破烂烂、脏兮兮的石床上当众做这种事？\n梅姬似乎被你说动了——是你的错觉吗，她好像比平时好哄多了。该不会是那个仪式的效果吧？\n你这么想着，用力地拥抱着她，把最后一丝疑虑也从她的身体里挤了出去。\n你逃过一劫。", "result": {}, "action": {}}, {"condition": {"r1:社交+隐匿<": [1, 5]}, "result_title": "", "result_text": "你的花言巧语并没能掩盖你做过的事，梅姬当着你的面甩上了房门。\n不是说好的是可保内宅安宁的仪式吗？你在心里大骂了盖斯三百次。", "result": {"card": 2000083}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "妻子": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "生气的梅姬"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "这种事只能自己上"}, "s3": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些东西可以帮助你度过危机"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
