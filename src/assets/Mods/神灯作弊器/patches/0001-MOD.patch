+{"id": 5206598, "name": "更进一步", "text": "关于梅姬死去的消息传出去以后，娜依拉前来拜见你。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "娜依拉为除掉了一名排名比她靠前的女人而感到高兴", "result_text": "她把一只沉甸甸的戒指塞进了你的手中，而后，她并没撒手，反而轻轻抚摸着你的手。\n“我都开始相信您对我是真感情了，您甚至会放弃梅姬这样完美的妻子……”她含情脉脉地望着你，“真的，我都有点相信了。就一点点。”\n而你敷衍地笑笑，倒是暗自掂量着那枚纯金的戒指，应该值不少钱。", "result": {"s1+支持": 1, "coin": 10}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000055}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "娜依拉微笑着前来拜访"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
