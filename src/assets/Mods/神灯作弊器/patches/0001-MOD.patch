: 1}, "result_title": "", "result_text": "反复权衡之下，为了避免过于出风头，以及妻子的不满，你婉拒了欢愉之馆的邀请。", "result": {}, "action": {"event_off": 5320518}}], "cards_slot": {"s1": {"condition": {"type": "char", "主角": 1, "生命权杖": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "生命权杖和你"}, "s2": {"condition": {"妓女": 1, "!追随者": 1, "!is": 2000772}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "她在等待你的光临"}, "s3": {"condition": {"type": "sudan", "纵欲": 1, "f:rare-s2.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "品级不高于她的纵欲卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
