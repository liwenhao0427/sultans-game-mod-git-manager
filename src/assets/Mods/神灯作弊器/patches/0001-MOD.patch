+{"id": 5204527, "name": "神之硕鼠", "text": "被你选中的那名富家子弟偷偷来拜访你了：“还记得我吗？”他咧着嘴笑道，“我搞到了一点好东西——嘿，别问是从哪来的，就说要不要吧！”", "tips": "", "mapping_id": 8001300, "once_new": 1, "round_number": 1, "waiting_round": 2, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "你没理会他的挤眉弄眼，他只好灰溜溜地去找别人销赃了。", "result": {}, "action": {"event_on": 5310625}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["侠名超过13点，即可省下10金币"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"have.教领": 1}, "result_title": "开玩笑的", "result_text": "“哪敢收您的钱啊，这都是孝敬给您的！”他谄媚地笑笑，仿佛替你做了一件微不足道的事。", "result": {"clean.s1": 1, "card": 2000986, "s2+回收": 1, "s3+回收": 1}, "action": {"event_on": 5310625}}, {"condition": {"counter.7100004>=": 13, "any": {"s2": 1, "s3": 1}}, "result_title": "", "result_text": "你威胁他不打折就去教会举报，他皱着脸只好答应了。", "result": {"clean.s1": 1, "card": 2000986}, "action": {"event_on": 5310625}}, {"condition": {"s2": 1, "s3": 1}, "result_title": "", "result_text": "区区二十金币，买这么精纯的乙太一点都不亏！他努力地向你推销，而你确实也有这方面需要……没办法，只好掏钱了。", "result": {"clean.s1": 1, "card": 2000986}, "action": {"event_on": 5310625}}, {"condition": {}, "result_title": "", "result_text": "你们最终没谈拢，就此不欢而散。", "result": {"s2+回收": 1, "s3+回收": 1}, "action": {"event_on": 5310625}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"cost.正教的乙太": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "无比精纯的乙太"}, "s2": {"condition": {"type": "item", "cost.金币=": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "10金币"}, "s3": {"condition": {"type": "item", "cost.金币=": 10, "counter.7100004<": 13}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "如果你没法靠道上的名声吓住他，就得多给10枚金币"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
