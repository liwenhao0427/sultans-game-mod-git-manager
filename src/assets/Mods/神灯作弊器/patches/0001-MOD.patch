@@ -0,0 +1 @@
+{"id": 5204503, "name": "忏悔", "text": "在此罪孽堆积之地，你可向祭司忏悔自己的过错，以洁净自己的灵魂和信念。", "tips": "", "mapping_id": 8001201, "once_new": 1, "round_number": 1, "waiting_round": 2, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5310605}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["一个人通常不能重复地进行忏悔", "忏悔通常能累积虔信值"], "open_conditions": [{"condition": {"any": {"all": {"is": 2001024}}}, "tips": "请选择合适的忏悔之人或者应被净化的物品"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [{"condition": {"s1.密教徒": 1}, "result_title": "", "result_text": "为了净化[s1.name]过于庞大而黑暗的罪孽，祭司们将[s1.gender]容纳着异教信仰的人间躯壳焚烧殆尽。", "result": {"clean.s1": 1, "counter+7100005": 1, "s2+虔信": 1}, "action": {"event_on": 5310605}}, {"condition": {"s1.is": 2001024}, "result_title": "", "result_text": "早已被纯净之神驱逐的星灵偶像，早就应当被销毁。", "result": {"clean.s1": 1, "s2+虔信": 2}, "action": {"event_on": 5310605}}], "settlement": [{"condition": {"s1.妻子": 1}, "result_title": "", "result_text": "梅姬为自己的丈夫——为你忏悔。\n她祈求纯净之神保佑你的灵魂，让你经历了这一切之后仍然还是她原来的丈夫……", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000292}, "result_title": "", "result_text": "蒙着面的赛里曼悄悄问祭司，通奸是怎么样的罪名？会受到怎么样的惩罚？\n祭司告诉他，通奸的男女将会被烈火焚烧下体，直到他们的欲望被净化为止。于是他又问祭司，能不能让其中一个代替另一个人受双倍的罪呢？\n祭司叹了口气，觉得无论怎么理解这个男人都没救了。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000014}, "result_title": "", "result_text": "哈比卜请祭司为自己平日杀生的屠刀念了经，又放在鲜花上擦拭，以祈祷那些为了人类口腹之欲而献身的牲畜能够回归纯净之神……显然，他并非第一次做这样的仪式，非常熟练。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000019}, "result_title": "", "result_text": "热娜慷慨地拿出她自己经营珠宝店赚到的金子，额外捐了一大笔钱给纯净者教会，因此，祭司们也就装作没看见热娜在他们身上佩戴的蛋白石首饰上乱瞟的眼睛。", "result": {"s1+灵感": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000054}, "result_title": "", "result_text": "哲巴尔并不是虔诚的信徒，但他同样愿意为了曾经并肩却战死沙场的士兵们祈祷。他总是问不同的祭司，希望得到一个令人满意的，属于老兵们的灵魂归宿——但答案始终不那么尽如人意。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000055}, "result_title": "", "result_text": "娜依拉在静室里发出了呻吟——你就知道她会用什么方法向神忏悔。根据她的说法，隔壁的祭司已经被她勾引到了，但你真的不想去听这种细节。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000056}, "result_title": "", "result_text": "盖斯怎么会有这么多可忏悔的事情！当他回来的时候，你看到他主动接受了净化仪式——也就是被打得遍体鳞伤。", "result": {"s1+equip": 2000098, "s1+虔信": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000057}, "result_title": "", "result_text": "哲瓦德在你的要求下不情不愿地去做了个样子，捐了几个金币——这个和最深情的忏悔效果也差不多。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000061}, "result_title": "", "result_text": "阿迪莱拒绝忏悔，她说自己一生都没有做过后悔的事情，也不认为神能纠正自己……你好说歹说，让她就去做做样子帮自己一个忙……但千真万确，你看到了，一股神圣的力量——管他是纯净者还是别的什么——祝福了阿迪莱的刀刃。", "result": {"s1+魔力": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000062}, "result_title": "", "result_text": "法图娜在忏悔的静室内泣不成声，她就只是这样一直哭泣，最后流出血泪来，好几天眼睛都看不清东西——祭司们都说这是纯净者听到了她的忏悔。", "result": {"s1+equip": 2000098, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000063}, "result_title": "", "result_text": "扎齐伊相信神的存在，但还没有成熟到尊重神的存在。不过，在忏悔回来之后，他非常惊恐地告诉你，那间静室会让人产生可怕的幻觉……", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000064}, "result_title": "", "result_text": "奈布哈尼为了去神殿，专门搭配了半天的衣服，沿路都有贵妇与侍女追着他调情……最后，毫不意外地，他被生气的祭司赶了出来。", "result": {"s1+忏悔": 1}, "action": {}}, {"condition": {"s1.is": 2000065}, "result_title": "", "result_text": "法里斯这辈子一定也犯过很多错误——但他都忘记啦！不过，他可是很想努力地忏悔，好能够帮上你的忙——于是他开始讲自己小时候对一匹马产生了不健康的欲望的事情，这吓得隔墙的祭司摔了一跤……", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000080}, "result_title": "", "result_text": "朱娜有什么好忏悔的呢？甚至没人教给过她任何祷词呢！但用自己的忏悔取悦神听起来是一件不错的事情，朱娜惯于取悦他人，更何况取悦神明呢？\n于是，朱娜思来想去，在纯净之神的静室里脱光了衣服，张开了双臂与双腿——将她的一生就这样坦荡的露出来任神明品味……\n最后，当她听到隔壁传来粗重的呼吸声与呻吟之后，才微笑着结束了这场忏悔。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000081}, "result_title": "", "result_text": "贾丽拉气哄哄地在静室里说了一大堆祭司们的坏话：关于他们是如何舔自己脚说自己的鞭子就是神的抚触之类的……最后，当她说到圣水的时候，墙对面的祭司探出脑袋来求她早点回家……", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000082}, "result_title": "", "result_text": "夏玛生而有罪：他父亲曾经要求纯净之神的祭司们用烙铁烧掉他不应有的部分，再用治愈法术给他堵上——这种身体的畸形对纯净者教会来说确实是不洁的象征。\n不过，舔过她下面的祭司们应该对此有一些不同意见……在祈祷室里，夏玛悄悄会见了几个老朋友，帮你疏通了一下与教会的关系，这事儿就算是办成了。", "result": {"s1+虔信": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000113}, "result_title": "", "result_text": "阿里木有太多太多的罪了……他害怕自己一开始祈祷就会被圣火烧掉哩！\n在你的威逼利诱下，他终于去试了试，他撒了谎，编了一个自己和贵妇人的通奸故事，然后还从路过的祭司那偷了一个金币——这个神不灵，他如此得出了结论。", "result": {"coin": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000123}, "result_title": "", "result_text": "鲁梅拉顺服了你的命令——但你知道她是对神明没有任何崇敬之心的。\n不过，从神殿回来的时候，她告诉你，在那静室的黑暗中，确实有什么东西在聆听大家的心声。", "result": {"counter+7100005": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000195}, "result_title": "", "result_text": "拉伊德有很多事情想要忏悔，但其中最重的罪行为弱小之罪：无法保护所有人，只能眼看不幸发生之罪，明知世界如此多错误，却任由其运转之罪……\n然而，神却并没有回应她，但她却说，自己感觉到了神的痛苦。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000196}, "result_title": "", "result_text": "这对盗匪兄弟懂什么忏悔？不过，越是这样的下三滥，越要宣扬他们忏悔时的虔诚，如此方能彰显神恩如海，神意难测……你的安排深得纯净者教会的欢心。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000197}, "result_title": "", "result_text": "这对盗匪兄弟懂什么忏悔？不过，越是这样的下三滥，越要宣扬他们忏悔时的虔诚，如此方能彰显神恩如海，神意难测……你的安排深得纯净者教会的欢心。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000352}, "result_title": "", "result_text": "出乎意料地，玛希尔去忏悔了……\n据说她在静室中说了一些公式与星空的坐标，还有关于教会乙太收集齐器与月亮之间的神秘联系的推测——这似乎证明了神真的在逐渐接近我们的世界！\n第二天，教会的人专门来拜访你，让你帮忙管住玛希尔的嘴巴……", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.法拉杰": 1}, "result_title": "", "result_text": "法拉杰拒绝向你透露他忏悔的内容，但他表示这样的行为确实能舒缓人的身心……可惜不能经常去忏悔呢。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000460}, "result_title": "", "result_text": "哈桑把自己的各种细碎的琐事编成了一个打油诗，大声歌唱——没多久隔壁的祭司就忍不了了，让人把他赶了出去", "result": {"s1+忏悔": 1}, "action": {}}, {"condition": {"s1.主角": 1, "!s2.is": 2000861}, "result_title": "", "result_text": "你坐在忏悔的静室中，这里只有油灯一盏，象征着黑暗人世里纯净者唯一的救赎。静待片刻，并没有任何神圣显现——于是你开始对着黑暗讲述自己的故事，那些你如何完成，以及打算如何完成苏丹卡的故事。\n在娓娓道来之中，无数的你在黑暗中走来，列坐其次……他们有老者，也有孩童，更多的则是不同表情与身材的青壮年，他们大部分时候沉默不语，有时候则会开口讲述一件关于自己的回忆。在他们身后，有更多，更庞大的形体也悄然落座……安静地听你们讲述着你一生的故事……", "result": {"counter+7100005": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000129}, "result_title": "", "result_text": "据说舞姬在那黑暗的小房间里跳了一支舞，在她离去之后，那里充满了花瓣与芬芳——纯净者教会将其作为一种吉兆大肆宣传。", "result": {"s1+魔力": 1, "counter+7100005": 1, "s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.is": 2000459}, "result_title": "", "result_text": "马尔基娜向神明展示了她的双手——那因为研究刺绣而布满伤口的手指，那因为研磨染料与矿物而粗糙的皮肤，何尝不是一种对神的忏悔呢？\n不过祭司们却对此嗤之以鼻，他们蔑视劳动带来的伤痕，并且嘲笑了马尔基娜的无知……当然，这勉强也算得上一次布道。", "result": {"s1+忏悔": 1, "s2+虔信": 1}, "action": {}}, {"condition": {"s1.读物": 1}, "result_title": "", "result_text": "承载着黑暗知识、不洁思绪的书籍，承载着那些总扑不灭的星灵信仰的书籍，都理应被销毁。", "result": {"clean.s1": 1, "counter+7100005": 1, "s2+虔信": 1}, "action": {}}], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "忏悔的信徒在夕阳下四散离去，教会不染纤尘的石柱沉默地注视着这些被拖长的肮脏影子，不发一言。", "result": {}, "action": {"event_on": 5310605}}], "cards_slot": {"s1": {"condition": {"any": {"all": {"is": 2001024}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "想要忏悔的人或需要净化的物件", "pops": [{"condition": {"s1.is": 2000013}, "action": {"pop.5204503_s1_01.self": "哈，纯净之神？祂算什么？我不会去的，你想都别想。"}}, {"condition": {"s1.is": 2000021, "!s1.密教徒": 1}, "action": {"pop.5204503_s1_02.self": "祭司们会做好该做的事，无需我到场监督。"}}, {"condition": {"s1.is": 2000021, "s1.密教徒": 1}, "action": {"pop.5204503_s1_09.self": "那里再也不是我的容身之所。"}}, {"condition": {"s1.is": 2000114}, "action": {"pop.5204503_s1_03.self": "纯净之神不是我所信奉之主。"}}, {"condition": {"s1.is": 2000461}, "action": {"pop.5204503_s1_04.self": "喵？"}}, {"condition": {"s1.is": 2000369}, "action": {"pop.5204503_s1_05.self": "一个奴隶，有什么资格忏悔呢？纯净者教会最近甚至在宣传奴隶必须依靠主人的恩准灵魂才能得救呢！"}}, {"condition": {"s1.is": 2000371}, "action": {"pop.5204503_s1_06.self": "一个奴隶，有什么资格忏悔呢？纯净者教会最近甚至在宣传奴隶必须依靠主人的恩准灵魂才能得救呢！"}}, {"condition": {"s1.is": 2000370}, "action": {"pop.5204503_s1_07.self": "一个奴隶，有什么资格忏悔呢？纯净者教会最近甚至在宣传奴隶必须依靠主人的恩准灵魂才能得救呢！"}}, {"condition": {"s1.is": 2000861}, "action": {"pop.5204503_s1_08.self": "不能去啊，去了就穿帮了！"}}]}, "s2": {"condition": {"type": "item", "any": {"is": 2000725}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "对纯净之神的信仰"}, "s3": {"condition": {"type": "item", "cost.金币": 3}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "忏悔捐赠3金币"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
