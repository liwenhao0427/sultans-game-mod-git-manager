+{"id": 5206616, "name": "救济日", "text": "有人向你提议做一次公开的救济，为饥饿的灾民提供一些吃食，让他们填饱肚子之余，也能够弘扬你的善名。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {"counter.7000252=": 1}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5320172}}, {"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5320156}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以借机折断苏丹卡，但，你真要怎么做么？"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2.杀戮": 1}, "result_title": "", "result_text": "粮食的施舍吸引了大批流民，混乱和争抢无可避免。无需任何言语，你拔出了佩刀，将眼前任何在你面前溅起沙尘的人砍翻在地。\n最开始，看着四向奔逃的流民你还颇觉兴奋，但砍着砍着，也没了什么趣味，杀再多也不过是一些不懂得反抗的流民。\n于是，你扔下了卷了刃的佩刀，丢下了一地的尸体和碎裂的苏丹卡，无聊地离开了。", "result": {"clean.s2": 1, "counter=7100001": 0, "counter+7100002": 3, "counter+7000240": 1}, "action": {}}, {"condition": {"s2.纵欲": 1}, "result_title": "", "result_text": "粥棚外的告示：“若能将姐妹妻女献出一晚，便可获得一满袋粮食，地点：粥棚后的帐篷内。”\n很快，女人们挤满了你的帐篷，她们围绕着你，青涩地讨好你，就为了一口吃的。\n这个世道就是这样肮脏。卑贱者想活下去，女人靠出卖姿色，男人靠出卖女人。", "result": {"clean.s2": 1, "card": 2000083, "counter=7100001": 0, "counter+7100002": 1, "counter+7000240": 1}, "action": {}}, {"condition": {"!s2": 1}, "result_title": "", "result_text": "流离失所的人们、吃不饱饭的人们排着队来到你的粥棚，他们对你感激涕零，连声高呼你的姓名。那段时间，没有人不知道你的美名。", "result": {"s3+虔信": 1, "counter+7100001": 1, "counter+7000239": 1}, "action": {"event_on": 5320156}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "至少需要花费5枚金币"}, "s2": {"condition": {"type": "sudan", "rare=": 1, "any": {"杀戮": 1, "纵欲": 1}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以在这里折断岩石品质的杀戮或纵欲卡，但你真要这么做吗？"}, "s3": {"condition": {"type": "item", "any": {"is": 2000728}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "善行可令信仰更坚"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
