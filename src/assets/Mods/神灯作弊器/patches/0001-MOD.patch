+{"id": 5400584, "text": "奈布哈尼的离去", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100584}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"table.2000064-追随者": 1, "prompt": {"id": "5400584_prompt_01", "text": "你修建密教基地的事没能瞒住奈布哈尼。他不敢相信你竟已堕入黑暗的深渊，而自己却对此无能为力……最后，他找到你，为你倒了杯酒，自己也斟了一杯。这杯酒之后，他再也没有回到你身边。", "icon": "cards/2000064"}, "success": {"event_off": 5400584}}}]}
