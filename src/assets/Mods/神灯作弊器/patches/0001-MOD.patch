diff --git a/event/trigger_events/5400507.json b/event/trigger_events/5400507.json
new file mode 100644
index 0000000..ac1125d
--- /dev/null
+++ b/event/trigger_events/5400507.json
@@ -0,0 +1 @@
+{"id": 5400507, "text": "妻子的梦", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100507}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400507_option_1", "text": "今天早上，梅姬显得十分苦闷，她说自己做了一个噩梦。梦里她站在一条小船上，身边有一只狗、一条绳索、以及一支竖笛。船在大海上漂着，她感到越来越害怕，但却不知道这三样东西到底要怎么用……她向你寻求安慰，你会如何解释这个梦？", "icon": "cards/2000001", "items": [{"text": "是吉梦", "tag": "op1"}, {"text": "是凶梦", "tag": "op2"}, {"text": "是自省梦", "tag": "op3"}, {"text": "你睡糊涂了", "tag": "op4"}]}, "case:op1": {"card": 2000689, "prompt": {"id": "5400507_prompt_1", "text": "你把她拥入怀中，告诉她一切都会好。\n狗代表忠实的伴侣，绳索代表去往它处的方式，代表出路；而竖笛是妻子最喜欢的乐器，它代表着喜乐与闲暇。哪怕她自感人生如小舟般飘荡在大海上，但有了伴侣、出路和喜悦，她一定会得到幸福。\n听了你的话，她温柔地笑了，眼里噙满了爱意。", "icon": "cards/2000001"}, "event_on": 5320102}, "case:op2": {"table.妻子+激情": 1, "prompt": {"id": "5400507_prompt_2", "text": "你直视着妻子美丽的眼睛，告诉她，这可能是个凶兆。\n狗代表吠叫的小人，绳索代表绞刑，竖笛则代表取悦王者的小丑，这三样东西叠加在一起，就会招来风浪，摧毁这条小船。\n听了你的话，她紧紧抓住你的手臂，问你到底该怎么办。你尽力安慰她，告诉她你会加倍小心，不让这个梦成真。\n你们俩久久依偎在一起，从彼此的体温中获得些许安全感，直到她不再发抖为止。", "icon": "cards/2000001"}, "event_on": 5320102}, "case:op3": {"counter+7100005": 1, "prompt": {"id": "5400507_prompt_3", "text": "你笑着捧住妻子美丽的面庞，告诉她不用担心，这梦只来自于她心底里的焦虑和恐惧，没什么大不了的含义。\n狗儿即可谄媚又可狠咬，绳索即可救人上岸也可将人绞死，竖笛即是她最喜欢的乐器，又是宫廷小丑的最爱。这三样东西，加上在大海中漂浮的小船，都代表她对未来人生的焦虑。\n听了你的话，她把头埋入你的胸膛，嗔怪地问你那该怎么办？你则抚摸着她的头发，告诉她，无论如何都有你在。", "icon": "cards/2000001"}, "event_on": 5320102}, "case:op4": {"counter-7100005": 1, "card": 2000083, "prompt": {"id": "5400507_prompt_4", "text": "你觉得纠缠一个梦的涵义真的很无聊。梦只是梦罢了，再怎么糟糕，难道还能比得过你现在的生活？\n梅姬对你的冷漠非常失望，整整三天都没有再跟你说一句话。", "icon": "cards/2000001"}, "event_on": 5320102}}}]}
