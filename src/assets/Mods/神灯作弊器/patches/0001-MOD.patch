+{"id": 5200745, "name": "研究神秘的锅", "text": "商店老板附赠的锅，藏着什么秘密呢？", "tips": "", "mapping_id": 8001005, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["没有黑暗知识的人进行研究的话，会受到诅咒。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2.黑暗知识": 1}, "result_title": "", "result_text": "这口神秘的锅也许可以用来进行一种奇怪的仪式，下次放进俺寻思内试试。", "result": {"counter+7000084": 1}, "action": {}}, {"condition": {}, "result_title": "", "result_text": "研究不到一会儿，一股莫名的气息萦绕在你心头，使你的肉体和心智都开始变得陌生起来。", "result": {"s2+equip": 2000163}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000466}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "神秘的锅"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "研究者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
