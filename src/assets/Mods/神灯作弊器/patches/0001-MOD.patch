+{"id": 5201002, "name": "苏丹的戏弄", "text": "苏丹听说，你为了奢靡卡的考验，准备了一笔财富……于是他告诉你，现在是时候表现忠诚了。", "tips": "", "mapping_id": 8001008, "once_new": 1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_14", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每回合会扣除一张苏丹的耐心。", "当苏丹的耐心为0时，游戏就会结束。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [{"condition": {"金币": 3}, "result_title": "", "result_text": "人们看到你面不改色向苏丹呈上的那满满一盘黄金……猜测着你真实的财富，带着嫉妒，带着恐惧。\n他们以后和你说话会更加尊敬。", "result": {"clean.s2": 3, "counter+7100003": 1}, "action": {}}], "settlement": [{"condition": {"s2": 1}, "result_title": "", "result_text": "苏丹的耐心在消解。", "result": {"clean.s2": 1}, "action": {}}, {"condition": {"!s2": 1}, "result_title": "", "result_text": "苏丹不一定真的相信流言，但他无法忍受你的不服从。", "result": {}, "action": {}}], "settlement_extre": [{"condition": {"耐心<=": 0}, "result_title": "", "result_text": "你被处死了", "result": {"global_counter=7200005": 1}, "action": {"over": 1}}, {"condition": {"耐心>": 0}, "result_title": "", "result_text": "今天已被你蒙混过去，但苏丹的耐心已经不多了", "result": {}, "action": {"rite": 5201002}}], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": 13}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "13枚金币"}, "s2": {"condition": {"type": "item", "is": 2000170, "cost.耐心": [1, 3]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "苏丹的耐心"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
