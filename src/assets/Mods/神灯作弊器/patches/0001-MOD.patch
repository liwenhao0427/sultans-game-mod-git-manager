@@ -0,0 +1 @@
+{"id": 5206617, "name": "美味的救济日", "text": "又一次，饥饿的穷人们挤在棚外等待着你的施舍。在铁头的建议下，你将今天的救济粥交给小圆来做。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"counter+7000252": 1, "event_on": 5320156, "prompt": {"id": "5206617_prompt_01", "text": "你把这件事忘在脑后，穷人失望地散去。铁头和小圆也没有再提起过这件事，实际上，这本来也不该由奴隶来负责。", "icon": ""}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {"tips": ["智慧", "战斗"], "type": "normal_result"}, "tips_text": ["这是让小圆和铁头成长的机会"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "但就在此时，人群中突然骚动起来", "type": "normal_result", "type_tips": "你的智慧和战斗为你提供了完整的骰子数量。", "low_target": 2, "low_target_tips": "你至少2点成功。"}}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "小圆第一次担此大任，她兴奋得满脸通红，天没亮就起来熬煮这天施的粥品，时刻关注着火候，不停搅拌着，坚持这样才能煮出麦子里面的甜味，即使没有昂贵的糖，也能好喝很多。\n她是对的。啧啧声在人群中渐渐响起，这粥真美味，他们感叹着没喝过这么好的粥——赞美声传来，小圆骄傲地仰起头，又害羞地低下头……", "result": {"s2+魅力": 1, "s2+虔信": 1}, "action": {"counter+7000252": 1}}, {"condition": {"r1:智慧+战斗>=": [2, 5]}, "result_title": "铁头和小圆精准捕捉到了骚乱的源头", "result_text": "那是个高大的老男人，看起来过去应该是雇佣兵，身上满是伤痕。\n铁头走过去，在他反应过来之前，就以绝对的力量把他按在了地上。\n那人怎么挣扎、怎么求饶都没能让这个一声不吭的大块头奴隶松手，终于，他涕泗横流地承认，自己是原来的负责人派来捣乱的，因为他实在咽不下自己被一个微不足道的女奴比下去这口气。\n但不论如何，他应该不敢再搞什么小动作了。没有其他人受伤，也没人敢继续在你这捣乱了。", "result": {"s2+智慧": 1, "s3+战斗": 1, "counter+7100001": 1}, "action": {"event_on": 5320156}}, {"condition": {"r1:智慧+战斗<": [2, 5]}, "result_title": "场面眼看失控，必须做点什么", "result_text": "铁头制服了离他最近的小男孩。他身材瘦弱，一推就倒，偏偏还要上蹿下跳地咒骂你的家族、冲粥棚吐口水。\n铁头抓住了他的腿，把他像拎家禽一样倒着拎了起来。男孩吱哇乱叫地挣扎，但铁头把他越举越高，他离地越来越远，终于，他从咒骂变为哭着求饶，说自己知道感恩了，绝不再闹了。\n铁头将他丢回地面，他大吐特吐，刚刚吃下的美味粥羹都吐了个干净。\n人群一片寂静，接着马上愤怒地炸开了锅。最后还是小圆鼓起勇气挡到了铁头面前，在铁头庞大块头的威慑下，还有小圆手里散发香气的食物的诱惑下，终于重新恢复了秩序。", "result": {"s2+社交": 1, "s3+战斗": 1, "counter+7100004": 1}, "action": {"event_on": 5320156}}], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "至少需要5枚金币"}, "s2": {"condition": {"type": "char", "is": 2000371}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你令小圆负责本次救济日的粥品"}, "s3": {"condition": {"type": "char", "is": 2000369}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你令铁头维持今日的秩序"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
