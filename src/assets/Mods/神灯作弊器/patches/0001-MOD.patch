+++ b/event/trigger_events/5410622.json
@@ -0,0 +1 @@
+{"id": 5410622, "text": "抉择", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5110622}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5410622_option_1", "text": "伊曼提出，他愿意用自己的血为你——为纯净者教会的新教领祝圣。那么，你怎么看？", "icon": ["cards/2000021", null, "cards/2000001"], "items": [{"text": "这是我们的命运", "tag": "op1"}, {"text": "不，你不要死", "tag": "op2"}]}, "case:op1": {"card": 2001095, "table.clean.2000021": 1, "no_prompt": {"card": 2001071}, "counter=7000586": 0, "rite": 5004523, "prompt": {"id": "5410622_prompt_1", "text": "伊曼点点头，没错，这就是你们的命运。就这样，他用自己的血在你身上画了华服与冠冕，它们在伊曼的血流尽的瞬间变成了一道纯白的烈焰，加冕你的身体。\n他没有为自己的死亡而叹息，他知道世人将受更大的苦——纯净之神向来都是让自己的祭司流血以照耀世人的，那么，当祂降临于世，又会让什么流血呢？", "icon": ["cards/2000001", null, "cards/2000021"]}, "event_off": 5410622}, "case:op2": {"rite": 5004524, "prompt": {"id": "5410622_prompt_2", "text": "你想也不想地拒绝了。\n你至此才向他坦白，你非但不希望伊曼死，甚至，你也不想帮助纯净之神降临……想想看吧！一个素来都是让自己的祭司受难、流血以照耀世人的神祇，将信徒逼至痛苦和折磨之尽头的神祇，祂降临之后，又会让什么流血呢？\n伊曼似有所动容，没有再提祝圣的事，只是忧虑仍攀绕在他眉宇之间——神的启示已于梦中降下，这命运，当真是你们能够逃避的么？", "icon": ["cards/2000021", null, "cards/2000001"]}, "event_off": 5410622}}}]}
\ No newline at end of file
diff --git a/event/trigger_events/5410623.json b/event/trigger_events/5410623.json
new file mode 100644
index 0000000..1e7d882
--- /dev/null
+++ b/event/trigger_events/5410623.json
@@ -0,0 +1 @@
+{"id": 5410623, "text": "辨识灵光", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5110623}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5410623_option_1", "text": "这天，你路过纯净者教会时，正看到几位低级僧侣正为民众传递纯净之言。他们的双手都被割得鲜血淋漓，一缕奇妙的白色光芒从其中一名僧侣身上钻了出来，有点像黄昏时刚刚点起的烛火，飘忽着没入跪在他面前的伤者身上。那人的脖子瞬间就不流血了，但伤口并没有愈合，看来还得接受后续的治疗。\n然而，相比这名僧侣，其他人身上的光就太不起眼了……虽说他们以同样的流程完成了工作，但他们转述的纯净之言看起来没多大用，他们跟前的伤者还是在痛苦中呻吟着、扭曲着……\n你问身边的人，为什么他们身上的光辉不一样？可旁人似乎都看不到你说的光晕……\n呃，你应该就这个奇怪的现象问问主祭大人么？", "icon": "common/position_shenmiao_1", "items": [{"text": "我应当追根究底", "tag": "op1"}, {"text": "肯定是我看错了", "tag": "op2"}]}, "case:op1": {"counter+7100005": 1, "rite": 5004525, "prompt": {"id": "5410623_prompt_1", "text": "很好，你决定抽空去拜访主祭大人，问个明白。", "icon": "common/position_shenmiao_1"}, "event_off": 5410623}, "case:op2": {"counter-7100005": 1, "prompt": {"id": "5410623_prompt_2", "text": "你使劲儿揉了揉眼睛，发现刚才看到的应该都是你的错觉——哈哈，确实，好端端的，人身上怎么可能发光呢？", "icon": "common/position_shenmiao_1"}, "event_off": 5410623}}}]}
\ No newline at end of file
diff --git a/event/trigger_events/5410624.json b/event/trigger_events/5410624.json
new file mode 100644
index 0000000..9402e25
