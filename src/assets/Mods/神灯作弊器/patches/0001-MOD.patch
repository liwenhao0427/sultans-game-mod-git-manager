+{"id": 5200744, "name": "看书-禁忌的古书", "text": "阅读可以提升自己，但是这本书真的可以吗……", "tips": "", "mapping_id": 8001005, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["没有黑暗知识的人阅读的话，会受到诅咒。", "对爱读书的少女而言，没有黑暗知识要求。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"any": {"is": 2000123, "s2.黑暗知识": 1}}, "result_title": "", "result_text": "这本怪诞的书教给了你一种奇怪的仪式。", "result": {"clean.s1": 1, "card": [2000491, "已拥有+1"]}, "action": {}}, {"condition": {}, "result_title": "", "result_text": "阅读不到一会儿，一股莫名的气息萦绕在你心头，使你的肉体和心智都开始变得陌生起来。", "result": {"s2+equip": 2000163}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000465}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "怪诞的书"}, "s2": {"condition": {"type": "char", "!动物": 1, "!怪物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阅读者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
