+{"id": 5420036, "text": "痛苦", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120036}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5420036_option_01", "text": "鲁梅拉最近有些神思不属。她像是犹豫了很久才敲响你的书斋，向你叩首，问道：“主人，您认为哪一种的痛苦最令人印象深刻呢？”\n你发现她紧攥着小小的拳头，仿佛下定了决心，要给什么人一个刻骨铭心的教训。", "icon": "cards/2000123", "items": [{"text": "饥饿", "tag": "op1"}, {"text": "幻灭", "tag": "op2"}, {"text": "火焰", "tag": "op3"}]}, "case:op1": {"counter+7000142": 1, "prompt": {"id": "5420036_prompt_01", "text": "是饥饿，你告诉她，那种漫长无尽的焦灼和绝望中，死亡甚至都会成为一种宽恕。鲁梅拉若有所思地点点头，旋即，她望着你的眼睛，下定了决心，“请您允许我去监牢探望我那位父亲。我想，这件事该结束了。”", "icon": ["cards/2000123", "cards/2000001", null]}}, "case:op2": {"counter+7000143": 1, "prompt": {"id": "5420036_prompt_02", "text": "是反复破灭的希望，你告诉她，就如她的母亲……鲁梅拉若有所思地点点头，旋即，她望着你的眼睛，下定了决心，“请您允许我去监牢探望我那位父亲。我想，这件事该结束了。”", "icon": ["cards/2000123", "cards/2000001", null]}}, "case:op3": {"counter+7000144": 1, "prompt": {"id": "5420036_prompt_03", "text": "是火，你告诉她，你最不想回忆起的死亡都与火有关。鲁梅拉若有所思地点点头，旋即，她望着你的眼睛，下定了决心，“请您允许我去监牢探望我那位父亲。我想，这件事该结束了。”", "icon": ["cards/2000123", "cards/2000001", null]}}}}]}
