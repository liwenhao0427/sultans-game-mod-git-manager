+{"id": 5204502, "name": "虔信的审视", "text": "你常需自视己身，以虔诚的心寻求神的音声。", "tips": "", "mapping_id": 8001201, "once_new": 1, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["在此统合虔信的印记，达到3个即可升级思潮"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"f:s1.虔信+s2.虔信+s3.虔信<": 3}, "result_title": "", "result_text": "你还未触及到新的境界，你的祷告无有回应。", "result": {}, "action": {}}, {"condition": {"s1.is": 2000727, "f:s1.虔信+s2.虔信+s3.虔信>=": 3}, "result_title": "", "result_text": "一个神圣的声音在宁静的脑海中轰然响起，它指引着你，望向一个崭新的、完美的、没有罪孽和污浊的陆上神国的构想……", "result": {"clean.s1": 1, "card": 2000728, "counter+7100005": 1, "s2=虔信": 0, "s3=虔信": 0}, "action": {}}, {"condition": {"s1.is": 2000726, "f:s1.虔信+s2.虔信+s3.虔信>=": 3}, "result_title": "", "result_text": "你忽然升起一丝明悟……人生在世间便是有罪的，如果不赎还干净，便无法回到那洁净的圣座跟前。", "result": {"clean.s1": 1, "card": 2000727, "counter+7100005": 1, "s2=虔信": 0, "s3=虔信": 0}, "action": {}}, {"condition": {"s1.is": 2000725, "f:s1.虔信+s2.虔信+s3.虔信>=": 3}, "result_title": "", "result_text": "你闭上双眼，在冰冷的日光和泉涌中伸出手，在这灵犀一点的时刻，你仿佛感觉到了某种……神的触碰。", "result": {"clean.s1": 1, "card": 2000726, "counter+7100005": 1, "s2=虔信": 0, "s3=虔信": 0}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "any": {"is": 2000725}}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "对纯净之神的信仰"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你见证了自己的虔诚之行"}, "s3": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "一位见证了你的虔诚之行的追随者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
