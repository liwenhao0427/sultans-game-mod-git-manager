+{"id": 5200749, "name": "一起玩个够", "text": "如果只有你一个人，也想不出什么又风雅又能多多花钱的好主意，但当奈布哈尼一起来，花钱的好点子就仿佛喷泉一样源源不绝。", "tips": "", "mapping_id": 8001049, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5300211, "prompt": {"id": "5200749_prompt_1", "text": "奈布哈尼白高兴一场，扔下你继续找乐子去。"}}}], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "上城区:[1,6]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["可以借此机会折断一张奢靡苏丹卡", "如果你让奈布哈尼欠下很多人情，也许他会认真的帮助你"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"s3": 1}, "result_text": "你们搞来了好多鲜花，顺便就引来了一大堆姑娘，然后是足够填满好几个澡盆的美酒与流水一样的美食，以及奈布哈尼能让所有人都开心的天赋。\n你们的宴会声量如此之大，以至于苏丹带着随从来看热闹，在奈布哈尼的邀请下，他也跳进酒池里，顺便就拿走了你的奢靡卡，随手折断。", "result": {"counter+7000049": 1, "clean.s3": 1}, "action": {"event_on": 5300253, "event_off": 5300211}}, {"condition": {"!s3": 1}, "result_text": "第二天醒来的时候，你已经失去了记忆，只有空空的钱袋，宿醉的头痛以及和地板上与几个不认识的女人纠缠在一起的奈布哈尼能让你依稀确认昨天的狂欢。\n至少，近期他应该会留在你身边帮忙了……希望这一切都值得。", "result": {"counter+7000049": 1}, "action": {"event_on": 5300253, "event_off": 5300211}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000064}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "奈布哈尼兴致勃勃"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "由你带领他去往奢靡之乡"}, "s3": {"condition": {"type": "sudan", "奢靡": 1, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "奢靡苏丹卡"}, "s4": {"condition": {"type": "item", "cost.金币=": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "玩乐经费10金币"}, "s5": {"condition": {"type": "char", "妓女": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "意料之外的参与者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "c