+{"id": 5208017, "name": "恰当的价码", "text": "你举牌拍下盖斯变卖的全部家当，以十枚金币——也就是与赎回他家世袭头衔相同的价码。", "tips": "", "mapping_id": 8001063, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"rite": 5008061}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "黑街:[1,5]", "icon": "rite_6", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1": 1}, "result_title": "你买下了那些东西", "result_text": "很快，仆人们把你买回来的那些杂物运回了你的仓库。你特别叮嘱他们当心不要磕碰，尽管没有什么贵重品，但毕竟是盖斯那样珍视的东西……", "result": {"counter+7100001": 1, "card": [2000742, "已拥有+1"]}, "action": {"delay": {"id": 52080171, "round": 1, "event_on": 5321027}}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须拿出10枚金币"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
