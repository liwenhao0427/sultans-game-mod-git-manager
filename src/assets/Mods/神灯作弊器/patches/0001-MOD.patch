+{"id": 5206052, "name": "祈福仪式", "text": "梅姬最近表现得十分不安……她有点担心阿迪莱，因此，她决定要进行一场祈福仪式，祈祷阿迪莱能够平安归来，而你答应了梅姬会帮忙。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 7, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"card": 2000083, "counter+7000182": 1}, "action": {"prompt": {"id": "prompt_5206052_01", "text": "你纯粹的拖时间激怒了妻子，梅姬自己请了僧侣过来为阿迪莱祈福，这之后，她好久都没有理你这个信口给了承诺又食言的家伙。"}, "delay": {"id": 52060521, "round": 3, "counter+7000183": 1}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_23", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "你出钱请了纯净者教会的祭司们过来。他们为阿迪莱念了一大段咒文，祈祷她顺利归来，也祈祷她未来的征程必能成功。\n梅姬跪在祭司脚下，奉上了石榴、奶酪和糖浆，祭司又把这些供奉投到火里，传递给神。", "result": {"counter+7100005": 1, "s3+虔信": 1}, "action": {"delay": {"id": 52060522, "round": 3, "counter+7000183": 1}}}], "settlement_extre": [{"condition": {"s1.金币=": 20, "s2": 1}, "result_title": "", "result_text": "为教会捐款也算是“奢靡”，这一点教会专门抗议过，他们认为这是行善，花多少钱购买神明的垂怜都是便宜的，怎么能算奢侈呢。\n但是，总而言之，苏丹觉得这就是浪费钱，他一般不这么浪费，但他很赞赏你花钱的派头。", "result": {"clean.s2": 1, "counter+7100003": 1, "counter+7100001": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": [10, 20]}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你至少需要拿出10枚金币，以完成此仪式"}, "s2": {"condition": {"type": "sudan", "奢靡": 1, "rare<=": 3}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "拿出20枚金币的话，可以折断一张白银及以下品级的奢靡卡"}, "s3": {"condition": {"type": "item", "any": {"is": 2000728}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你需以虔敬的心祈祷"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
