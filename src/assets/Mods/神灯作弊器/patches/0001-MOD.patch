+{"id": 5210024, "name": "果实", "text": "去吧，所有人都等着你完成最后的分配……此时此刻，你有权吃掉最甘美的果实，甚至，吐出属于历史的种子。", "tips": "", "mapping_id": 8001024, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "结局:6", "type": "END", "icon": "rite_ex_2", "tag_tips": [], "tag_tips_up": {"tips": ["改革", "传统"], "type": "normal_result"}, "tips_text": ["一切由你决定", "变革与保守的指数，对应不同的正当性，带来不同的未来", "有些角色需要在特定的组合下才能担当重任"], "open_conditions": [{"condition": {"any": {"!s1.is": 2000954, "all": {"s1.is": 2000954, "any": {"s3.is": 2000054}}}}, "tips": "屠龙苏丹的辅佐者需要是英雄或者贤人"}], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s2.主角": 1, "s1.is": 2000913}, "result_title": "我完成了誓言", "result_text": "你宣布，篡国者已经倒下，故国已经复辟，一切正如誓言。人们欢呼雀跃，尽管他们早已记不清故国的模样", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310491}}, {"condition": {"s2.主角": 1, "s1.is": 2000172}, "result_title": "暴君的统治结束了", "result_text": "而你将仁慈，公正的统治所有人——否则可就要小心了，因为你已经完完全全地把如何造反教给了太多的人。", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310462}}, {"condition": {"s2.主角": 1, "s1.is": 2000910}, "result_title": "革掉压迫者的命", "result_text": "你列举了上一位苏丹的种种恶行，他吸着人民的血、吃着人民的肉、强夺人民的孩子、蹂躏人民的父母，而他维持统治的一切正是来自于人民！现在，暴君被推翻了，新的国家建立了，压迫者的好日子到头了！你会成为站在人民这一边的君主，这个国家属于人民！\n殿堂中的目光充满了犹豫与怀疑，一个不压迫的君王？那是什么？这真的可能吗？这个帝国已经被苏丹们和国王们粗暴地统治了成百上千年，你要开创的新时代……真的能得到你所热爱的人民的支持吗？", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310525}}, {"condition": {"s2.主角": 1, "s1.征服": 1}, "result_title": "游戏结束", "result_text": "你用一张苏丹卡结束了苏丹的游戏。\n在你笑着折断了这张征服卡、并且表示绝对没有下一张以后，群臣才松了一口气，开始一一向你宣誓效忠。", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310478}}, {"condition": {"s2.主角": 1, "s1.is": 2000954}, "result_title": "吾为英雄王", "result_text": "人类是一种慕强的生物，而你正是这世间最强的英雄；你的统治的基础，正是那淌着岩浆般浓血的火龙头颅。", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310534}}, {"condition": {"s2.is": 2000312}, "result_title": "想不到吧", "result_text": "你宣布将废除王权，废除奴隶制，组织国民大会……在这部分的时候即使所有人贵族都充满了疑虑，奈费勒仍然带头鼓掌……随后你喊了他的名字，告诉大家奈费勒先生将以首席发言人的身份与大家一起商讨如何创造未来——哦，看他的表情，毁灭一个国家也值了。", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310521}}, {"condition": {"s2.is": 2000009}, "result_title": "血脉传承", "result_text": "你告诉大家，苏丹的血脉继承人将在你忠诚的监护下继续统治这个国度，什么都没有变，但什么又都变得更好了。\n萨达尔尼坐在铺着厚毛皮垫子的王座上，她腹中的孩子是正当的统治者、未来的苏丹。", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310483}}, {"condition": {"s2.is": 2000010}, "result_title": "血脉传承", "result_text": "你告诉大家，苏丹的血脉继承人将在你忠诚的监护下继续统治这个国度。\n话音未落，莎姬已经轻快地跳到了王座上，像猫找到了舒适的位置一般。\n“苏丹在这里”，她甜蜜地抚摸着自己仍然平坦光洁的小腹：“他很快就会来了。”——说这话的时候，她看着的是你。", "result": {"s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "global_counter=7200250": 1, "event_on": 5310487}}, {"condition": {"s2.is": 2000013}, "result_title": "你的名字", "result_text": "在所有人的见证下，你宣布希尔希纳王子完成了复辟，他夺回了自己的国家、自己的权柄，以及自己的真名。所有人，以希尔希纳之名欢呼吧！", "result": {"s2.uprare": 1, "s2+苏丹": 1}, "action": {"steam_achievement": "ACHIEVEMENT_007", "event_on": 5310495}}, {"condition": {"s3.主角": 1, "s1.is": 2000913}, "result_title": "非你不可", "result_text": "希尔希纳百般挣扎着、不愿意登上王位，他害怕自己会变成被你们推翻的苏丹那样的人——为了打消他的抵抗，你只得自己当了宰相，你许诺会贴身监督他的行为。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {"steam_achievement": "ACHIEVEMENT_011"}}, {"condition": {"s3.主角": 1, "s1.is": 2000172}, "result_title": "我亲自守护", "result_text": "你向所有人示范了何为王者般的仁慈与气度：作为胜者，你并没因对败者的血脉斩尽杀绝。\n你的行为十分高洁，遗憾的是，很多人都认定你之所以放过王家子嗣，肯定是因为你自己跟前苏丹的王妃有一腿……", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {"steam_achievement": "ACHIEVEMENT_011"}}, {"condition": {"s3.主角": 1, "s1.is": 2000910}, "result_title": "我将鼎力相助", "result_text": "你亲手组织了一场革命，又亲手将其引向成功。这当然给了古老帝国以新生的希望，却也向所有人示范了，一个国家会被多么轻易地推翻……", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {"steam_achievement": "ACHIEVEMENT_011"}}, {"condition": {"s3.主角": 1, "s1.征服": 1}, "result_title": "由我亲自守护", "result_text": "你向所有人示范了何为王者般的仁慈与气度：作为胜者，你并没因对败者的血脉斩尽杀绝。\n你的行为十分高洁，遗憾的是，很多人都认定你之所以放过王家子嗣，肯定是因为你自己跟前苏丹的王妃有一腿……", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {"steam_achievement": "ACHIEVEMENT_011"}}, {"condition": {"s3.is": 2000312, "s1.is": 2000172}, "result_title": "最合适的人", "result_text": "“奈费勒当宰相”——帝国俗语，意味“正确的人做正确的事”。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000312, "s1.is": 2000910}, "result_title": "我们将携手", "result_text": "在革命成功的狂热兴奋气氛之中，你把奈费勒拽上了高台，向所有人宣布，他就是这个国家的宰相。\n现在，为大家讲两句吧，奈费勒先生。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000312, "s1.征服": 1}, "result_title": "最合适的人", "result_text": "你知道，奈费勒真正关心着这个国家，胜过你，胜过其他所有人……这应该是最好的安排了。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000312, "s1.is": 2000954}, "result_title": "统治国家不能只依靠勇武", "result_text": "奈费勒可不会因为你杀了一条长翅膀会喷火的爬虫就崇拜你，所以他才适合当宰相。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000061, "s1.is": 2000954}, "result_title": "", "result_text": "感谢您的信任！我将誓死辅佐你。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000054, "s1.is": 2000954}, "result_title": "", "result_text": "感谢您的信任！我将誓死辅佐你。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000349, "s1.is": 2000913}, "result_title": "运用自如", "result_text": "还得是阿卜德，在被宣布继承宰相的职位之后，他立即用前朝的姿势行了礼——动作实在是过于流畅自然了，就好像他之前几十年每天都这么做一样。", "result": {}, "action": {}}, {"condition": {"s3.is": 2000349, "s1.is": 2000172}, "result_title": "运用自如", "result_text": "还得是阿卜德，在被宣布继承宰相的职位之后，他立即痛陈苏丹过去恶行，并且精妙地把所有人，当然包括他自己——从里面摘了出去。现在，坏人只有一个，而他已经死了——真棒！", "result": {}, "action": {}}, {"condition": {"s3.is": 2000349, "s1.is": 2000910}, "result_title": "运用自如", "result_text": "阿卜德激情地发表了一个简短的演说——他显然非常熟悉奈费勒的各种理论，而经过了他的嘴，这些粗糙的，令贵族们不安的言论纷纷被抹上了蜜，镀上了金……大家立即就对未来没那么担心了!", "result": {}, "action": {}}, {"condition": {"s3.is": 2000349, "s1.征服": 1}, "result_title": "运用自如", "result_text": "还得是阿卜德，在被宣布继承宰相的职位之后，他立即痛陈苏丹过去恶行，并且精妙地把所有人，当然包括他自己——从里面摘了出去。现在，坏人只有一个，而他已经死了——所以，活着的我们就尽情享受吧！", "result": {}, "action": {}}, {"condition": {"s3.is": 2000349, "s1.is": 2000954}, "result_title": "运用自如", "result_text": "阿卜德在接过宰相之位的同时就呈上了他为你拟定的国号和尊号，后者长达……让我数数……一百七十四个单词。", "result": {}, "action": {}}, {"condition": {"s3.is": 2000021}, "result_title": "迎接纯净之国", "result_text": "伊曼恭顺地接受了宰相之位，纯净者在这个帝国愈发根深蒂固，洁净的芳香弥漫整个王庭。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"s3.is": 2000022}, "result_title": "迎接奇迹之国", "result_text": "拜玲耶笑着应下了宰相之位，密教徒们扬眉吐气——他们当天晚上就把纯净者的圣殿涂满了臭泥。", "result": {"s3.uprare": 1, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"!s3.主角": 1, "!s3.is": 2000022, "any": {"!s1.is": 2000954, "!s3.is": 2000054}}, "result_title": "啊？", "result_text": "[s3.name]目瞪口呆，这真是一个令人诧异的决定——[s3.gender]显然还没准备好", "result": {"s3.uprare": 3, "total.宰相-宰相": 1, "s3+宰相": 1}, "action": {}}, {"condition": {"!s4": 1}, "result_title": "信仰自由", "result_text": "你宣布这个国家不再有国教，人们可以自由选择自己信奉哪位神明。许多虔信者都对你的决定很不满意，他们过去彼此憎恨，现在则开始一起恨你了。", "result": {"counter+7000450": 1}, "action": {}}, {"condition": {"s4.is": 2000728}, "result_title": "这个国家将继续侍奉纯净之神", "result_text": "你高声宣布纯净者教会在这次政变中的功绩，赞美他们是教化者，治愈者，引导者！这一点保持不变让很多人安了心，至少你并没有打算推翻原来的一切。", "result": {"counter+7000451": 1}, "action": {}}, {"condition": {"s4.is": 2000412}, "result_title": "这个国家将受到创造之神的庇护", "result_text": "很多人都第一次听说这个神，人们议论纷纷，你甚至听到了“她们吃小孩”和“他们能壮阳”……等等不太明智的私语。扶植一个新神是一个不错的象征，告诉大家你将会改变一切——哪怕是天上的事物。", "result": {"counter+7000452": 1}, "action": {}}, {"condition": {"s4.is": 2000723}, "result_title": "我们将普及无神论", "result_text": "你告诉所有人，神绝不仁慈，人绝不该将希望交到神的手中；因此，你禁止了所有教会的活动，这个国家推行无神论。人们议论纷纷，有些人觉得你疯了，另一些人则更让你生气——他们认为你就是新的神。", "result": {"counter+7000453": 1}, "action": {}}, {"condition": {"s5.is": 2000955}, "result_title": "谁赞成，谁反对？", "result_text": "君主生来就是要互相厮杀的，就好比狮群领袖一生只落败一次，就是它被新领袖杀死的那次。你站在苏丹的尸体边说完了自己要说的话，所有人都低下了自己的头，兽群接受了新的领袖。", "result": {"counter+7000454": 1}, "action": {}}, {"condition": {"s5.is": 2000956}, "result_title": "还是新的好", "result_text": "人们惊骇地注视着你身边那关着苏丹的笼子——他现在已经不是一个君主了，只是一团可悲的肉块。你让支持你的人站在左边，于是，没人站在右边。", "result": {"counter+7000455": 1}, "action": {}}, {"condition": {"s5.is": 2000957}, "result_title": "于是他也可以出发了", "result_text": "你说完了，显然，不管你说了什么，都不可能令所有人都满意。但你对士兵打了个手势——让他们开始拉着苏丹的链条，送他踏上流放之旅……\n曾经的君主缓缓穿过曾经敬拜他，吹捧他，迎合他，以至于让他堕落至斯的群臣，他们只是沉默地看着，一个跟上去的人也没有。", "result": {"counter+7000456": 1}, "action": {}}, {"condition": {"counter.7000496>=": 1, "s5.is": 2000958}, "result_title": "谁赞成，谁反对？", "result_text": "你说完了，显然，不管你说了什么，都不可能令所有人都满意。但你身边就是苏丹的尸体……或者是被你玷污的，曾经是苏丹的一团东西。人们总是与仁者狡辩，刁难智者，诘难信士——但从来都对怪物放的每一个屁保持恭顺和赞美。\n于是，在这不堪的污秽之旁，你的事业就这么成了。", "result": {"counter+7000457": 1}, "action": {}}, {"condition": {"counter.7000496<": 1, "s5.is": 2000958}, "result_title": "呃……", "result_text": "你说完了，显然，不管你说了什么，都不可能令所有人都满意。但你身边就是被镣铐和锁链束缚住的人体，他虚弱且疲惫，浑身血渍和污浊，却兴致盎然地注视着这一切。他没有发话，其他人也不敢发出反对的声音，只是在下面蹊跷地交换眼神——你们又在玩什么新游戏？", "result": {"counter+7000457": 1}, "action": {}}, {"condition": {"!主角": 1, "have.妻子": 1}, "result_title": "你忘记了自己？", "result_text": "人们注意到，你没有为自己安排一个席位，你把所有的果实都分给了别人。而当你离去的时候，人们沉默地望着你，有崇敬、有讥笑、有哀伤……而你则毫不在乎。", "result": {"counter+7000449": 1}, "action": {"steam_achievement": "ACHIEVEMENT_001", "over": 202}}, {"condition": {"!主角": 1, "!have.妻子": 1}, "result_title": "你忘记了自己？", "result_text": "人们注意到，你没有为自己安排一个席位，只是将果实分给了众人——而你对此甚至懒得做任何解释，就这么飘然离去……没有人敢阻止你。", "result": {"counter+7000449": 1}, "action": {"over": 205}}, {"condition": {"主角": 1, "s5.is": 2000960}, "result_title": "", "result_text": "你升入光辉之中。", "result": {"counter+7000458": 1}, "action": {}}, {"condition": {"主角": 1, "s5.is": 2000961}, "result_title": "", "result_text": "你遁入黑暗之道。", "result": {"counter+7000459": 1}, "action": {}}, {"condition": {"主角": 1, "!s5.is": 2000961, "f:改革-传统<=": 2, "f:传统-改革<=": 2}, "result_title": "维持平衡", "result_text": "你用缜密而复杂的方式安排了这个帝国的政治格局，确保每个阶级、每种信仰都可以从新帝国中得到一定的满足。但是，满足所有人的国家一定就能长治久安么？", "result": {"counter+7000446": 1}, "action": {}}, {"condition": {"主角": 1, "!s5.is": 2000961, "f:改革-传统>": 2}, "result_title": "变革已来", "result_text": "你设计了一个充满不安与变化的时代。风险与机遇共存，你会是把握住命运的那个人么？", "result": {"counter+7000447": 1}, "action": {}}, {"condition": {"主角": 1, "!s5.is": 2000961, "f:传统-改革>": 2}, "result_title": "守成之人", "result_text": "你对旧帝国的事务几乎没有做任何改动，这当然让你得到了许多保守派的支持，但是，这也让你继承了拖垮旧帝国的许多顽疾。", "result": {"counter+7000448": 1}, "action": {}}], "cards_slot": {"s1.is": {"condition": {"any": {"type": "sudan"}, "正当性": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "正当性"}, "s2": {"condition": {"type": "char", "any": {"主角": 1, "all": {"s1.is": 2000913, "is": 2000013}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "选择一位领袖"}, "s3": {"condition": {"any": {"all": {"s4.is": 2000412, "is": 2000022}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "选择一位辅佐者", "pops": [{"condition": {"s1.is": 2000954, "!s3.is": 2000054}, "action": {"pop.5210024_s3_01.self": "这个光荣的位置应该留给陪伴你征伐恶龙的战友"}}]}, "s4": {"condition": {"type": "item", "any": {"all": {"is": 2000723, "cost.消耗品=": 1, "!s3.is": 2000022}, "is": 2001025}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "国家所扶植的信仰"}, "s5": {"condition": {"any": {"is": 2000958, "all": {"s2.主角": 1, "is": 2000961}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "让所有人都害怕你的东西"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
