角": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你需要亲自前往"}, "s4": {"condition": {"type": "sudan", "rare<=": 3, "杀戮": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "杀戮卡……但是应该放入哪一品级？"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
