+{"id": 5421173, "text": "祭品", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121173}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5421173_option_1", "text": "拜铃耶让你看了看她沾满黑色汁水的双手，“我们正在召唤的那位非常贪吃，它一定会喜欢这些香喷喷的祭品的。”\n呃……要用纯净者的祭司们当祭品去召唤邪灵吗？如果你真的这么做了，恐怕纯净者的信徒们会视你为魔鬼，但当然……被你召唤出来的邪灵、还有拜铃耶，她们一定会很开心。", "icon": "cards/2000001", "items": [{"text": "那还等什么？", "tag": "op1"}, {"text": "还是放了吧", "tag": "op2"}]}, "case:op1": {"counter+7000572": 1, "no_prompt": {"total.2001101+已拥有": 1}, "total.2000021=支持": 0, "table.2000021+反对": 3, "total.2000021-追随者": 1, "prompt": {"id": "5421173_prompt_1", "text": "拜铃耶捂着嘴笑了起来，仿佛一早知道你会这么选。\n听说了这件事之后，伊曼默默地离开了你的队伍。", "icon": "cards/2000001"}, "success": {"event_off": 5421173}}, "case:op2": {"counter-7100003": 1, "counter-7100001": 1, "prompt": {"id": "5421173_prompt_2", "text": "拜铃耶耸了耸肩——你抓来的人，你说了算。\n不过祭司们一点也没领你的情，他们不光不领情，出去之后还在民间和贵族们中间大肆渲染你和密教徒之间的关系……", "icon": "cards/2000001"}, "success": {"event_off": 5421173}}}}]}
