+{"id": 5420268, "text": "宫廷-索要妃子-监听是否适用了纵欲卡", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120268}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"table.clean.2001020": 1, "event_on": 5320269, "prompt": {"id": "5420268_prompt_01", "text": "你早该想到的，除了与自己最喜爱的大臣进行纵欲的攀比，还有什么更能激发苏丹的兴致呢？在你折断这张纵欲卡的当晚，莎姬就得到了君主的宠爱……但愿计划能一切顺利。", "icon": "cards/sudan"}}}]}
