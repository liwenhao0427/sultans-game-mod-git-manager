+{"id": 5200723, "name": "宰相的召见", "text": "阿卜德再次派仆人来，召你到府上一叙。他的事未必十分要紧，但他不喜欢被人忽视。", "tips": "", "mapping_id": 8001165, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"s1=支持": 0, "s1+反对": 1, "counter-7100003": 1, "prompt": {"id": "5200723_prompt_01", "text": "宰相阿卜德讨厌被忽视的感觉，这让他觉得很没面子。他一定会在宫廷中抓住一切机会向苏丹进谗言的，你要当心了。", "icon": "cards/2000349"}}, "action": {}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_14", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["如果不去的话，恐怕日后宫廷中会遭到宰相的攻讦。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1}, "result_title": "", "result_text": "你猜到阿卜德一定是为穆尔台兹来找你的，事实也确乎如此。那个懦夫不知哪里来的胆子，竟敢扬言要报复苏丹，即使是一句酒后的戏言，作为苏丹最忠诚的仆人，阿卜德也决不允许这样僭越的事发生。他决定派你去给穆尔台兹一个教训——一个一生一次的教训。", "result": {"card": 2000040}, "action": {"rite": 5000724}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000349}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿卜德怒火中烧"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须亲自前去"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
