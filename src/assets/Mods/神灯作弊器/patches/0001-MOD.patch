+{"id": 5210008, "name": "集结部队", "text": "当你开口下令之后，无数人行动了起来。像所有重大决定一样，这一切已经无法停止了——而一切又尚未开始。不过，有一件事是很好的：你不用再关心苏丹游戏的倒计时了，现在生死的倒计时掌握在你自己的手中。", "tips": "", "mapping_id": 8001187, "final_pin": false, "once_new": -1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 1, "location": "结局:1", "type": "END", "icon": "rite_ex_2", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["倒计时结束后，所有普通仪式都会被关闭"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1.倒计时=": 5}, "result_title": "彗星袭月", "result_text": "传令兵们匆匆越过旷野，要把暗号传递给荒野中的兄弟——今夜的道路异常清晰，但他们不敢抬头看那闪烁的凶星与扭曲的幻月。", "result": {"clean.s1": 1}, "action": {"rite": 5210008}}, {"condition": {"s1.倒计时=": 4}, "result_title": "群鸦云集", "result_text": "在最后的自由闲暇，你与百夫长们一起穿过街道，无声地指点地形，盘算着军队通行的道路——无论你走到哪里，都有好几百只乌鸦在房檐上，高塔上，天空上静静跟随，专注万分。", "result": {"clean.s1": 1}, "action": {"rite": 5210008}}, {"condition": {"s1.倒计时=": 3}, "result_title": "混沌前奏", "result_text": "一个晚上发生了九起谋杀案，牧羊人抱怨今天凌晨同时有十四头母羊流产，欢愉之馆的客人突然变成了平日的七倍，而苏丹今天一口气处死了三名无辜的宫廷艺人。", "result": {"clean.s1": 1}, "action": {"rite": 5210008}}, {"condition": {"s1.倒计时=": 2}, "result_title": "闪电与雷霆", "result_text": "暴风雨持续了一整夜。巨大雷电如同怪兽一般撕裂天穹，将城市的影子照映出群魔的怪形。你在担心自己的队伍会受到天气的影响——但第二天万里无云，骄阳似火炙烤大地。", "result": {"clean.s1": 1}, "action": {"rite": 5010025}}, {"condition": {"s1.倒计时=": 1, "s2.征服": 1}, "result_title": "天无二日", "result_text": "当地平线的尽头出现了你的旗帜之后，战争的消息终于传到了青金石大厅。\n据说当时残阳似血，浸透宫廷……苏丹发出了狂喜的笑声，而你则命令士兵明日随着朝阳一起发动进攻。", "result": {"counter+7000439": 1, "clean.rite": 1, "clean.s1": 1}, "action": {"event_off": 1, "delay_off": 1, "rite": 5010010, "event_on": 5310435, "counter+7000436": 1, "total.侍奉苏丹-侍奉苏丹": 1, "total.侍奉苏丹2-侍奉苏丹2": 1, "total.火焰大王-火焰大王": 1, "total.追随的人-追随的人": 1, "total.奈布哈尼准备银趴-奈布哈尼准备银趴": 1}}, {"condition": {"s1.倒计时=": 1, "!s2.征服": 1}, "result_title": "天无二日", "result_text": "当地平线的尽头出现了你的旗帜之后，战争的消息终于传到了青金石大厅。\n据说当时残阳似血，浸透宫廷……苏丹发出了狂喜的笑声，而你则命令士兵明日随着朝阳一起发动进攻。", "result": {"counter+7000439": 1, "clean.rite": 1, "clean.s1": 1}, "action": {"event_off": 1, "delay_off": 1, "rite": 5010020, "event_on": 5310435, "counter+7000436": 1, "total.侍奉苏丹-侍奉苏丹": 1, "total.侍奉苏丹2-侍奉苏丹2": 1, "total.火焰大王-火焰大王": 1, "total.追随的人-追随的人": 1, "total.奈布哈尼准备银趴-奈布哈尼准备银趴": 1}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000914, "cost.倒计时": [1, 5]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "倒计时"}, "s2": {"condition": {"any": {"type": "sudan"}, "正当性": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "谋反的思潮"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
