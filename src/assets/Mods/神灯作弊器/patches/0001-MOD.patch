+{"id": 5400509, "text": "躲雨的人", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100509}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400509_option_1", "text": "暴雨将至，一群过路的商旅希望能在你的屋檐下歇脚。他们风尘仆仆，每一个人都显得很疲惫。但你注意到他们披风的下摆带着隐约血迹，而货物裹着的遮布下隐隐有兵刃的轮廓。他们绝不是寻常商人那么简单……你决定？", "icon": "cards/2000001", "items": [{"text": "逮捕他们", "tag": "op1"}, {"text": "杀人越货", "tag": "op2"}, {"text": "友善接纳", "tag": "op3"}]}, "case:op1": {"counter+7100003": 1, "counter-7100004": 1, "prompt": {"id": "5400509_prompt_1", "text": "你认定他们是潜伏城中的逆贼，于是假意邀请他们加入你的酒宴，暗中却派人通知了捉贼人。很快，他们被一网打尽，而你对苏丹的忠诚也得到了证明。", "icon": "cards/2000001"}}, "case:op2": {"coin": 2, "prompt": {"id": "5400509_prompt_2", "text": "你假意邀请他们加入你的酒宴，却在他们松懈的那一刻痛下杀手。精疲力竭的旅人们没怎么抵抗，就变为刀下亡魂。可惜这些穷酸鬼的货物里只有一点点粮食和破烂的兵器，只能说聊胜于无。", "icon": "cards/2000001"}}, "case:op3": {"counter+7100004": 1, "prompt": {"id": "5400509_prompt_3", "text": "他们可能是叛贼，也可能是盗匪，但此时此刻，在你眼中，他们只是渴望休息的旅人。你接纳了他们，给他们安排了一顿温暖的晚餐和可供安眠的睡床。离开前，他们万分感激你的帮助。", "icon": "cards/2000001"}}}}]}
