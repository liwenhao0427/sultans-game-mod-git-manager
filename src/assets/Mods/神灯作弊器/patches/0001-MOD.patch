+{"id": 5420540, "text": "祈福仪式", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120540}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"card": 2000083, "prompt": {"id": "5420540_prompt_01", "text": "看你沉吟不决的样子，梅姬一言不发地转身离开了房间。她自己拿出了些私房钱请了祭司和僧侣过来为阿迪莱祈福，而你在一边冷眼旁观，冷嘲热讽说这纯属浪费钱，她有这些钱，还不如拿来支持你的事业。\n你们为此大吵了一架，这之后好些天，你们都没话可聊。", "icon": "cards/2000083"}, "event_off": 5420540, "delay": {"id": 54205401, "round": 3, "counter+7000183": 1}}}]}
