+{"id": 5210040, "name": "审判烈焰", "text": "柴薪被点燃，世界被撕裂……而你也不能控制这裂隙的方向——无论是谁被献祭，你也无能为力。", "tips": "", "mapping_id": 8001528, "once_new": 1, "round_number": 0, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:11", "icon": "rite_19", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["点燃你的异教徒，无论他是谁，你也无法拒绝"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "世界在[s2.gender]的哀鸣中出现了裂隙", "result_text": "狩猎异端的祭司们抓到了[s2.name]，这是神的选择……在象征着审判异端，征服思想的火刑中，你折断了这张征服卡……柴堆上燃起了超乎想象的圣焰，那烈火升腾到空中，漂浮在神圣的圆弧之间……破坏着世界的完整性——快了，神很快就能降临了！别难过，别悲伤，苏丹的游戏已经免除了这份罪孽！", "result": {"clean.s2": 1, "clean.s1": 1, "card": [2001036, "塔+1", "已拥有+1"], "counter+7000579": 1}, "action": {"rite": 5010041}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "sudan", "征服": 1, "塔": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "征服卡"}, "s2": {"condition": {"type": "char", "any": {"all": {"s1.rare=": 4, "any": {"is": 2001089, "all": {"is": 2000082, "rare=": 4}}}}}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "看看谁来了。"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
