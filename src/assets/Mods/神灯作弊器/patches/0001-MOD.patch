+{"id": 5200783, "name": "金屋藏娇", "text": "索拉薇儿住在你名下一处不甚秘密的房产内，每日过得惬意潇洒——当然，这建立在你定期给她一笔钱的基础上。", "tips": "", "once_new": 0, "round_number": 5, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "奇珍:12", "type": "TREASURE", "icon": "rite_5200783", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每七天，她会吸取你3枚金币，并为你提供1点侠名。", "如果多次没有获得金币，她会逃离这作宅邸。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"s3": 1, "s3.金币": 3}, "result_text": "索拉薇儿快乐地生活在自己的房子里。不知道是不是错觉，有几次你好像看到有陌生男人出入其中。", "result": {"counter+7100004": 1}, "action": {"rite": 5200783}}, {"condition": {"any": {"!s3": 1, "s3.金币<": 3}, "counter.7000324>=": 2}, "result_text": "见你不愿意支持她奢侈的生活，索拉薇儿自然是去另谋出路了。", "result": {"counter-7100004": 5, "s1-纳入收藏": 1, "s1-追随者": 1, "s2-金屋藏娇": 1, "card": 2000083}, "action": {"event_on": 5300286}}, {"condition": {"any": {"!s3": 1, "s3.金币<": 3}}, "result_text": "拜托！我只要3枚金币而已！\n索拉薇儿对你没有支持她的生活表示十分不满。", "result": {"counter+7000324": 1}, "action": {"rite": 5200783}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000772, "纳入收藏": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "索拉薇儿"}, "s2": {"condition": {"type": "item", "金屋藏娇": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "金屋藏娇"}, "s3": {"condition": {"type": "item", "cost.金币": 3}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你必须拿出3枚金币作为她的每周开销"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
