+{"id": 5206618, "name": "赏赐", "text": "铁头将他的石餐盒献给了你，虽然是个微不足道的东西，但他的顺服让你满意。那么，你要随手赏他点什么吗？", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_1", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "你慷慨地赏赐了铁头1枚金币。他再次向你叩首感谢，然后慢吞吞地去了仆人们住的地方。", "result": {}, "action": {"event_on": 5320160}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "1枚金币对奴隶而言也已是足够的恩典"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
