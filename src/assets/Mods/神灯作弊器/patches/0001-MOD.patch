+{"id": 5200768, "name": "奴隶交易（废弃）", "text": "你选择那位娇弱美少女", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 2, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"counter-7100003": 1, "prompt": {"id": "5200768_prompt_01", "text": "你随口答应之后，忘记了这件事，把奈布哈尼抛在脑后，让他有点生气。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "上城区:[1,6]", "icon": "rite_6", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "你买下了娇弱美少女。", "result_text": "“亲爱的，你自由了。”奈布哈尼格外温柔地说，他亲自替她解开了镣铐，“我会烧掉你的奴隶纸，还你自由人的身份，你可以自由自在地生活了。”\n“可是……可是……”少女睁大了眼睛，她似乎无比的惊恐，“可是我——我不想自由的生活——我想您买下我！我来伺候您！我……请您别抛下我！”\n奴隶贩子在一旁解释说，这位少女是某地妓院里出生的孩子，从小就受了欢愉之女的全部训练，是她母亲把她交到奴隶贩子手里来的……\n奈布哈尼似乎有些尴尬，他看看你，又看看少女。", "result": {"counter+7000307": 1}, "action": {"event_on": 5300276}}], "settlement_extre": [{"condition": {"s3": 1, "s2.金币>=": 6}, "result_title": "", "result_text": "你向奈布哈尼表示自己会付全款，他笑着看向你手中的奢靡卡，表示自己不会阻止你的慷慨。", "result": {"clean.s3": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000772}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "娇弱美少女"}, "s2": {"condition": {"type": "item", "cost.金币": [3, 6]}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "3金币即可，若置入6金币，则可折断一张奢靡卡"}, "s3": {"condition": {"type": "sudan", "奢靡": 1, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以借此折断一张不高于奴隶品级的奢靡卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
