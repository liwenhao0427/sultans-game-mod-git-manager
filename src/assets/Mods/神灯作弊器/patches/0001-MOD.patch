@@ -0,0 +1 @@
+{"id": 5420243, "text": "奈费勒--脏兮兮的空椅子", "is_replay": 0, "auto_start_init": [1], "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120243}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"event_off": 5320091, "option": {"id": "5420243_option_01", "text": "宰相因为沉迷男妓而绑架奈费勒大人、反被后者所杀的故事在宫廷里传开了，这是现在最脍炙人口的段子，很多人挤眉弄眼地把那个宴会里发生的情事拿出来说了又说，每个人都有自己的版本。\n苏丹在津津有味地听了几十个版本之后，终于想起他需要一个新宰相的事：“阿卜德的故事固然精彩，但他留下的这把脏兮兮的椅子总得有人坐，[player.name]，你觉得谁比较合适？”\n不知道为什么，苏丹点名向你发问。呃……你总觉得这里有个不小的陷阱在等着你……恐怕当这个宰相要处理的麻烦事比你想的要多得多得多……", "icon": ["", "cards/2000001", "cards/2000312"], "items": [{"text": "我当仁不让", "tag": "op1"}, {"text": "让奈费勒来", "tag": "op2"}, {"text": "沉默不语", "tag": "op3"}]}, "case:op1": {"steam_achievement": "ACHIEVEMENT_011", "table.主角+宰相": 1, "table.主角.uprare": 1, "table.主角+社交": 1, "table.主角+魅力": 2, "counter+7100003": 3, "coin": 20, "prompt": {"id": "5420243_prompt_01", "text": "你拍着胸脯说乐意为苏丹分忧，又说了一大堆恭维的话。他眯着眼睛笑了：“也不是不行，你总比之前那条好色的老狗有本事点。”他点点头，“阿卜德的领地会因为他的丑闻而被剥夺一半，充入国库。剩下的赏给你了。”\n你对苏丹又是一阵感恩戴德，等他施施然离去，朝臣们纷纷迎上来恭喜，说着各种恭维的话。偌大的宫殿，你看不见一颗没有低下的头颅——除了奈费勒。他眼瞳幽深而安静，朝你微微摇头，接着便离开了。\n你一下子冷静了下来。也许当这个宰相，未必是一件多好的事……", "icon": "cards/2000001"}, "event_on": 5320092, "card": [2000676, "数量+20"]}, "case:op2": {"table.2000312+宰相": 1, "table.2000312.uprare": 1, "table.2000312+社交": 1, "table.2000312+魅力": 2, "prompt": {"id": "5420243_prompt_02", "text": "你极力向苏丹举荐奈费勒，表现得仿佛迫不及待地想看见奈费勒倒霉，因为你知道宰相每天要面对多少乌七八糟的烂摊子。\n“多好的缘分，”你嬉笑着说，“一名男妓把我们两位宰相联系在了一起。我建议奈费勒当上宰相之后，好好奖赏那个祸国殃民的男人呢。”\n苏丹听完也笑了，“不错。”苏丹眯着眼睛审视着奈费勒，点了头，“阿卜德的领地会被剥夺一半充入国库，剩下的一半就赏给你了，奈费勒卿。从今天起，你就是我的宰相。”\n奈费勒沉着脸向苏丹行了大礼，接过了宰相的印章。", "icon": "cards/2000001"}, "event_on": 5320244, "event_off": 5320084, "clean.rite": [5006572, 5006573, 5006574, 5006575, 5006576, 5006577, 5006578, 5006579, 5006580, 5006581, 5006582, 5006583, 5006584]}, "case:op3": {"steam_achievement": "ACHIEVEMENT_011", "table.主角+宰相": 1, "table.主角.uprare": 1, "table.主角+社交": 1, "table.主角+魅力": 2, "counter+7100003": 3, "prompt": {"id": "5420243_prompt_03", "text": "不管你是出于惶恐、害怕还是一时的犹豫，你的沉默反而激起了苏丹的兴致。他不由分说地点了你的名字，命令你暂时代为处理宰相留下的烂摊子，然后施施然离开了觐见厅。\n只留你一个人无所适从、手足无措地面对阿卜德留下的那把脏兮兮的椅子，还有那些没个头的政务、收不完的尾巴、怎么填也填不满的赤字填坑……", "icon": "cards/2000001"}, "card": [2000676, "数量+20"], "event_on": 5320244}}}], "auto_start": false}
