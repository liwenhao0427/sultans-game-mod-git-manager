@@ -0,0 +1 @@
+{"id": 5200663, "name": "绝地探索", "text": "麦娜尔的能力引起了苏丹的兴趣，她告诉苏丹，她希望能去探索遥远的沙海对岸的一座传说中隐藏在群山之中的雄城。这无疑是一场异常危险的冒险，而她这一次，没有上门找你帮忙。", "tips": "", "mapping_id": 8001202, "once_new": 0, "round_number": 5, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "野外:[1,6]", "icon": "rite_4", "tag_tips": [], "tag_tips_up": {"tips": ["体魄", "生存"], "type": "normal_result"}, "tips_text": ["这是一场极度危险的冒险，麦娜尔不愿拖你下水", "如果她独自上路，几乎没有可能活着回来"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "不论探险者怀着怎样的心事，死亡的阴影都已在狂乱的风沙中晃动……", "type": "normal_result", "type_tips": "你的体魄和生存为你提供了完整的骰子数量。", "low_target": 5, "low_target_tips": "至少需要5点成功才会有结果。"}}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"!s2": 1}, "result_title": "你没有派人跟随", "result_text": "从那以后，你再也没听说麦娜尔的消息。她一定死在了这场探险之中，但你隐隐猜到……这正是她的选择，也正是她的反抗。", "result": {"clean.s1": 1}, "action": {}}], "settlement_extre": [{"condition": {"s2": 1}, "result_title": "", "result_text": "麦娜尔没想到你会来。她看起来非常低落，再也没有第一次探险时的兴奋了。\n她告诉你，她的梦想就是探索这个世界，将它们如实地记录在她的地图——那张被修正过的羊皮卷上，你们找到的绿洲所在之处被烫成了一个焦黄的空洞——麦娜尔伤感地摇摇头，她没想到自己为他们带来的只有灾难。她勉强地笑着说，“其实我本来没想着再回来的……可你来了……也许这是命运的安排。”\n你想宽慰她这不是她的错，可又能说什么呢？", "result": {}, "action": {}}, {"condition": {"s2": 1, "r1:体魄+生存>=": [5, 5]}, "result_title": "你们克服了磨难", "result_text": "你们沉默着，强打着精神，穿过重重烟沙迷雾，艰难地越过了死亡地带，红色的山峦伫立在远方，狭长的山谷犹如天神劈下的剑痕，尽头伫立着的，是一座雄伟的城市。\n无数商队在此地汇集，交换物资，到处都是秩序井然的繁荣景象。你们逛得眼花缭乱，忍不住买了好些稀罕玩意儿。离开时，麦娜尔回望那天堑般的山谷，喃喃自语，“这里地势易守难攻……对吧？”她顿了顿，苦笑着摇摇头，对你说，“不论如何，谢谢你。”", "result": {"s1+支持": 1, "s2+体魄": 2, "s2+生存": 2, "card": [2000365, "已拥有+1"], "counter+7100001": 1}, "action": {"event_on": 5300154}}, {"condition": {"s2": 1, "r1:体魄+生存<": [5, 5]}, "result_title": "你没能改变什么", "result_text": "狂乱的风沙给了你们严峻的考验，你从未如此清晰地看到死亡的面容。然而，等你醒来时，一切已经风平浪静。救下你的商人说，当时他们循着驼铃声找到了你——只有你一个人。\n是啊，你想起来了，绝境之中，麦娜尔把最后一袋口粮和水交给了你，接着释然地、平静地微笑着迎接死亡的到来，仿佛她早已预见此刻，仿佛她一直在等待着此刻……\n你将麦娜尔的死讯带回城市，苏丹对她没能完成任务深感遗憾，但他的注意力很快就被转移到别的地方去了——更美丽的女人，更新奇的游戏，更值得抢夺的财富……再也没有人记得麦娜尔的名字。", "result": {"clean.s1": 1, "s2+equip": 2000098, "coin": 2}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000069}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "麦娜尔不愿拖你下水"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以亲自、或派人协助她完成这场艰苦的探险"}, "s3": {"condition": {"type": "item", "cost.消耗品=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你最好准备一些消耗品，以备万全"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
