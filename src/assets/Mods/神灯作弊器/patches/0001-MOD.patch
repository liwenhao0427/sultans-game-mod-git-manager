+{"id": 5400514, "text": "神秘的符号", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100514}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400514_option_1", "text": "你治下的农夫们忧心忡忡，因为最近家门附近被人画上了很多神秘的符号……也许英明的老爷您能发现些什么？", "icon": "cards/2000001", "items": [{"text": "这是神秘符文", "tag": "op1"}, {"text": "这是小偷记号", "tag": "op2"}, {"text": "张贴广告要收税", "tag": "op3"}, {"text": "别来烦我", "tag": "op4"}]}, "case:op1": {"counter+7100005": 1, "prompt": {"id": "5400514_prompt_1", "text": "你去了农夫们说的地点，发现那些复杂的神秘符文隐隐有着某种不可言传的规律……盯着看得越久，它们便越像是能够回应你一般，闪烁着，飘动着，呼唤着你……噢，不，现在不行……你连忙强行移开视线，让人将这些符文拓印下来带回书房，你要好好研究研究……", "icon": "cards/2000001"}}, "case:op2": {"counter+7100001": 1, "counter-7100004": 1, "prompt": {"id": "5400514_prompt_2", "text": "你断定这是小偷们做的记号，这样的代表家中白天只有一个女人，那样的代表明天可以动手……总之，你告诫大家提高警惕的同时，命人将这些符文尽数抹去了。", "icon": "cards/2000001"}}, "case:op3": {"counter+7100003": 1, "coin": 1, "prompt": {"id": "5400514_prompt_3", "text": "竟然有人敢在你的庄园附近乱涂乱画，张贴广告？你命令卫兵在墙边蹲守，抓到乱涂乱画的便征收一银币的税……那符文从此以后再也没有出现过了。有类似苦恼的贵族们醍醐灌顶，纷纷效仿，也算赚了点零花钱。", "icon": "cards/2000001"}}, "case:op4": {"counter+7100002": 1, "counter-7100001": 1, "prompt": {"id": "5400514_prompt_4", "text": "农夫只要干好种田的事就行了，管这么多有的没的？你将他们打了一顿赶出去，让他们别拿这种鸡毛蒜皮的小事来烦你，可是事情并没有得到真正的解决……他们的田地莫名减产，可没有人敢再惹怒你。他们想尽一切办法、甚至卖掉年幼的女儿，才凑够了今年的税款……\n如此冷漠的统治令你臭名远扬。", "icon": "cards/2000001"}}}}]}
