+{"id": 5421064, "text": "证婚人", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121064}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5421064_option_1", "text": "法尔达克最近有些苦恼。\n他虽不愿被困在首都，但他的父亲却认为这是一个绝佳的机会。\n“他希望我能尽快娶妻，最好是什么名门之女，好在首都扎下根……”法尔达克叹着气，“但我……唉，您觉得呢？我应该这么做吗？”", "icon": "cards/2000350", "items": [{"text": "当然，我甚至可以为你介绍", "tag": "op1"}, {"text": "不，这样是不会得到幸福的", "tag": "op2"}]}, "case:op1": {"counter+7000346": 1, "counter+7000366": 1, "rite": 5008060, "no_prompt": {"table.2000350-事件提示": 1}, "prompt": {"id": "5421064_prompt_1", "text": "政治联姻嘛，这事你熟，全世界都是这么做的。你甚至还主动提出，你可以给他介绍一些合适的女人……法尔达克欲言又止，最后还是没有拒绝你的热情。", "icon": "cards/2000350"}, "success": {"event_off": 5421064}}, "case:op2": {"counter+7000346": 1, "counter+7100004": 1, "no_prompt": {"table.2000350-事件提示": 1}, "prompt": {"id": "5421064_prompt_2", "text": "这种事问你？他该好好问问自己的心才对！\n听你这么说，法尔达克的眼睛微微发亮，但想起父亲强硬的模样，又黯淡下去。“您说得对，我再多想想吧。”", "icon": "cards/2000350"}, "success": {"event_off": 5421064}}}}]}
