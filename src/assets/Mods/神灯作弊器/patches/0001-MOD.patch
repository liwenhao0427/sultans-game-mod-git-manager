+{"id": 5208112, "name": "阁楼里的笑声", "text": "在你和布缇娜的默许下，妓女们经常光顾你的舍馆，她们做食客们的生意，她们的名声也为你引来更多三教九流的人物，怎么不是一种互利互惠呢。", "tips": "", "mapping_id": 8001143, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_13", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["合伙生意交替开始，每隔四天会开张一次"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "妓女们在舍馆的餐厅吃过饭后，有一些客人会立即跟着她们登上阁楼的楼梯……在没有客人的时候，有时候她们也会邀请哈比卜，有时候她们也会邀请你，一起分享肉体与秘密。", "result": {"counter+7000491": 1, "loot": 6001059}, "action": {"delay": {"id": 52081121, "round": 4, "rite": 5321118}}}], "cards_slot": {"s1": {"condition": {"type": "char", "any": {"is": 2000789, "妓女": 1}}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "今天来此“工作”的女士"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
