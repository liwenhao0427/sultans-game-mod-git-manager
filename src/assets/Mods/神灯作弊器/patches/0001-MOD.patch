+{"id": 5200672, "name": "严厉刑罚", "text": "针对这些胆敢逃跑的刁民，你认为有必要颁布和实施严厉的、针对性的法案。你决心召集法学者进行研讨，然后以雷霆手段抓捕、惩罚那些犯人，以免今后还有人效仿。", "tips": "", "mapping_id": 8001008, "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_20", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["法案的起草者至少要有5点智慧", "法案的实施者至少要有5点体魄"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "你派遣了处理这种事情的专家", "result_text": "在你的干预和影响下，无数法学者汇聚一堂，畅所欲言，很快，在当地试行了一套严厉的法案。\n你们建立了身份确认制度，然后大肆搜查来历不明之人。逃亡的农民被抓捕后，将会被鞭打、刺面、予以罚款并遣返原籍，藏匿他们的人也将被罚款，而检举者则可以领取一定的赏金。\n很快，农民们被大批抓获、遣返，最后只能走投无路地将地产抵给当地的贵族寻求庇护。贵族们对此非常高兴，他们给你送了不少礼物，因为你是他们坚定的好朋友。", "result": {"counter+7100002": 1, "coin": 5}, "action": {"event_on": 5300165}}], "cards_slot": {"s1": {"condition": {"type": "char", "智慧": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "法案的起草者至少要有5点智慧"}, "s2": {"condition": {"type": "char", "体魄": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "法案的实施者至少要有5点体魄"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
