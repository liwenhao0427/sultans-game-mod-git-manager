+{"id": 5200720, "name": "宰相的召见", "text": "阿卜德派仆人来，召你到府上一叙。他的事未必十分要紧，但他不喜欢被人忽视。", "tips": "", "mapping_id": 8001165, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"s1=支持": 0, "s1+反对": 1, "counter-7100003": 1, "prompt": {"id": "5200720_prompt_01", "text": "宰相阿卜德讨厌被忽视的感觉，这让他觉得很没面子。他一定会在宫廷中抓住一切机会向苏丹进谗言的，你要当心了。", "icon": "cards/2000349"}}, "action": {}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_14", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["如果不去的话，恐怕日后宫廷中会遭到宰相的攻讦。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"counter.7000067>=": 1}, "result_title": "你及时地响应了他的传唤", "result_text": "阿卜德很满意你的殷勤。烧了半支蜡烛那么久的东拉西扯后，他终于漫不经心地告诉你，穆尔台兹今天没有按时出现在宫廷里。阿卜德微笑着，眼睛里却闪着恶意的光辉。“穆尔台兹是陛下最关心的臣子。你去找他谈谈吧。明天我希望能在苏丹的黄金宫殿上见到他——今后的每天都要。可不要让我失望啊。”", "result": {"card": 2000035}, "action": {"rite": 5000721}}, {"condition": {"counter.7000067<": 1}, "result_title": "你及时地响应了他的传唤", "result_text": "阿卜德很满意你的殷勤。烧了半支蜡烛那么久的东拉西扯后，他终于漫不经心地告诉你，穆尔台兹今天没有按时出现在宫廷里。阿卜德审视着你，话声中带着敲打的意味，眼睛里闪着恶意的光辉。“穆尔台兹是陛下最关心的臣子。你去找他谈谈吧。明天我要在苏丹的黄金宫殿上见到他——今后的每天都要。你可不要让我失望啊。”", "result": {"card": 2000035}, "action": {"rite": 5000721}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000349}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "宰相阿卜德正在传唤你"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须亲自前去"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
