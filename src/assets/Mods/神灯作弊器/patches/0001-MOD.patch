+{"id": 5210050, "name": "恶之华", "text": "你肩负着神圣的使命，要去播种这颗神明的种子……小心啊，被选中的使徒，如果等待的太久，那么它可能会在你体内生根发芽。", "tips": "", "mapping_id": 8001543, "once_new": 1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 1, "location": "黑街:[1,9]", "icon": "rite_19", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你必须在神的耐心耗光前完成祂的任务。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [{"condition": {"!s1": 1, "any": {"!s2": 1, "!s3": 1, "!s4": 1, "!s5": 1, "!s6": 1, "!s7": 1}}, "result_title": "盛开", "result_text": "你耽搁了太多时间，那黑暗的种子在你心中停驻过久……它吸收你的心灵，扎根长成——以至于盛开。\n你的血肉都化作了花朵，而灵魂则化为了恶臭，那创造种子的神明亦乐见于此。毕竟，无论用何种形式，祂的形体都来到了这世界上。", "result": {}, "action": {"over": 34}}, {"condition": {"s1": 1, "any": {"!s2": 1, "!s3": 1, "!s4": 1, "!s5": 1, "!s6": 1, "!s7": 1}}, "result_title": "每一天，种子都在躁动", "result_text": "那是一个不断重复的梦，祂像最温柔的农妇一般教你耕种。一遍又一遍地，你学习着创造生命的秘密，好让祂再次诞生……那歌唱的天使，那统治世界的金冠，那虔信的仆从，那智慧的念珠，都是你必须准备好的东西——祂将以此再次君临世界。", "result": {"clean.s1": 1}, "action": {"rite": 5210050}}], "settlement": [{"condition": {"s2": 1, "s3": 1, "s4": 1, "s5": 1, "s6": 1, "s7": 1}, "result_title": "宫缩", "result_text": "血池中，泡沫里，一个巨大的人形缓缓盘踞。祂在呼吸，隔着那血色的薄膜，你看到那双黑暗的眼睛缓缓睁开了……血从裂隙里缓缓渗出——神明已经迫不及待地想要降生。", "result": {"counter+7000636": 1}, "action": {"clean.rite": 1, "event_off": 1, "delay_off": 1, "total.2000024=上朝": 0, "total.2001019+冻结": 1, "total.sudan+冻结": 1, "total.2000680+冻结": 1, "sudan_pool.sudan+冻结": 1, "enable_auto_gen_sudan_card": false, "rite": 5010059}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2001122, "cost.耐心": [1, 99]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "神的耐心"}, "s2": {"condition": {"type": "item", "is": 2001123}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "神之卵"}, "s3": {"condition": {"type": "item", "is": 2001126}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "神之苗床"}, "s4": {"condition": {"type": "item", "is": 2001039, "诞生": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "侍奉祂的天使"}, "s5": {"condition": {"type": "item", "is": 2001040, "诞生": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "纪念祂的圣物"}, "s6": {"condition": {"type": "item", "is": 2001041, "诞生": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "崇拜真神的凡人"}, "s7": {"condition": {"type": "item", "is": 2001042, "诞生": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "统治大地的威权"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
