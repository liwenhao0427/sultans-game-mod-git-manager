+{"id": 5200662, "name": "一个人的绝地探索", "text": "你听说麦娜尔又一次出发了，苏丹命令她穿过一片沙漠，找寻一座传说中的山中之城。她没有找任何赞助，离开时只带了一只骆驼。", "tips": "", "mapping_id": 8001202, "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_4", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["她将独自出行，等待她的命运又会是什么？"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "你听说那名制图师失去了踪迹，也许迷失在茫茫沙漠，也可能早已死去，苏丹对她没能完成任务深感遗憾，但他的注意力很快就被转移到别的地方去了——更美丽的女人，更新奇的游戏，更值得抢夺的财富……再也没有人记得麦娜尔的名字，再也没有人知道她怀着怎样的心情远行。", "result": {"clean.s1": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000069}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "麦娜尔离开了"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
