+{"id": 5206637, "name": "强取", "text": "苏丹的护卫跟着你来到家门口，可怜的小圆，她还不知道等待着她的会是什么。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_16", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你什么都做不了"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "被带走时，小圆哭得昏天黑地，你的妻子忍不住也一起哭了。你无力地揽着她的肩膀，深深地自责。\n苏丹对你的识趣非常满意，赏了你一点指头缝里的金子。", "result": {"coin": 5, "clean.s1": 1}, "action": {"event_on": 5320186}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000371}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "小圆已被你许诺献给苏丹"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
