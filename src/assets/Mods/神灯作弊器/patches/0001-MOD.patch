+{"id": 5206613, "name": "帝国勇士排行榜", "text": "这种闲书能够丰富阅读者的谈资，但最好别被老婆发现哦。", "tips": "", "mapping_id": 8001005, "once_new": 0, "round_number": 3, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_7", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2.妻子": 1}, "result_title": "", "result_text": "梅姬对这本书的不满、对不得不应付那些追着她问东问西的贵夫人的不满、对你们床笫间情事根本没有书中所写那么完美的不满，一下子全都爆发了。\n这都是你自找的。", "result": {"clean.s1": 1, "s2+社交": 3, "card": 2000083, "pop.5206613_01.s2": "怎么，还要我夸夸你吗？"}, "action": {}}, {"condition": {"s2.is": 2000055}, "result_title": "", "result_text": "娜依拉翻弄着书页，发出哗啦啦的声音。她看起来对这份成果颇为自得。", "result": {"clean.s1": 1, "s2+社交": 2, "pop.5206613_02.s2": "怎么样亲爱的，对我的文笔还满意吗？"}, "action": {}}, {"condition": {"s2.主角": 1}, "result_title": "", "result_text": "你有了不少和朋友们聊天的新话题。", "result": {"clean.s1": 1, "s2+社交": 2, "pop.5206613_03.s2": "……真不愧是我！！"}, "action": {}}, {"condition": {}, "result_title": "", "result_text": "[s2.name]有了不少和朋友们聊天的新话题。", "result": {"s2+社交": 2, "pop.5206613_04.s2": "人不可貌相……"}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000704}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "正在阅读的书"}, "s2": {"condition": {"type": "char", "!动物": 1, "!怪物": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阅读者"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
