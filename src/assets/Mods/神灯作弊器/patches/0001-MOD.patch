+{"id": 5210014, "name": "直面苏丹", "text": "苏丹端坐于黄金王座之上，仍然忠于他的近卫则侍立于侧。和以往一样，青金石大厅浓厚的阴影与辉煌的光在他身上交织……为其编织出了难测的妆容。但是，当你真的推开大门的时候，他的喉头鼓动，表达出了难以掩饰的兽性喜悦。", "tips": "", "final_pin": false, "from_pins": [{"rite_id": 5010013, "controls": [[100, 100]], "resolution": 50, "width": 20, "arrow_length": 100, "arrow_angle": 40, "start_reserve": 0.08, "color": [207, 187, 161, 255], "dashed": true}], "mapping_id": 8001016, "once_new": -1, "round_number": 0, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "结局:6", "type": "END", "icon": "rite_ex_2", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["这是变身阶段，战斗还没开始，别紧张"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "一个令苏丹愉悦的游戏", "result_text": "你拔出武器，大声挑战着苏丹——并率先踏入了他的厅堂之中。如果你不这样做，其他人根本不敢以叛逆者的身份踏入青金石大厅……战斗已经从黎明进行到傍晚，落日将血色涂抹在你们之间。每走一步，每接近一步苏丹，都能感觉到影子，火焰，甚至那廊柱们都随着被挤压的气氛在疯狂摇曳旋转……近卫们纹丝不动，而苏丹在为你鼓掌——他的影子在不断膨胀……", "result": {"s1=战斗": 7, "s1=体魄": 7, "s1=魅力": 7, "s1=生存": 7, "s1=智慧": 7}, "action": {"event_on": 5310420}}, {"condition": {}, "result_title": "为了你，他全副武装", "result_text": "苏丹站了起来，仿佛配合着你们一步一步接近的速度——他拿起了自己的征战之剑，让侍卫给自己套上了盔甲，又在其他武器之间稍加迟疑，选择了另一柄轻薄但扭曲的弯刀。\n在他做这些事情的时候，你们的队伍没有说话，也没有冲刺，仿佛有某种默契一般，维持着朝觐的行走节奏，慢慢来到了大厅中央。", "result": {"s1+s3": 1, "s1+s4": 1, "s1+s5": 1}, "action": {}}, {"condition": {}, "result_title": "光与影之兽", "result_text": "“朕接受你的挑战，叛逆者。”苏丹这么说着，离开了他盘踞已久的王座，一步步地走下台阶……每一步，他的影子都在膨胀，他反射的光都更加瑰丽，他的身形甚至好像都在变得更加高大。\n身后有人已经无法自持，你听到了踉跄后退与武器掉落的声音，但现在没有空隙去呵斥或者鼓舞同伴了，你需要鼓起全部勇气和力量才能面对眼前的敌人：一头猛兽终于从束缚他，腐化他，折磨他的囚笼里被你释放了出来。", "result": {"s1+s2": 1}, "action": {}}, {"condition": {"s6.is": 2000064, "s6.苏丹的近卫": 1}, "result_title": "他是为众剑所吻的王子", "result_text": "奈布哈尼唱诵着，那是苏丹曾经的名号——掌握了所有十三种剑术流仪的王血方能被冠予的尊号。", "result": {"s6+s7": 1, "s6+equip": 2000915}, "action": {}}, {"condition": {"s8.is": 2000054, "s8.苏丹的近卫": 1}, "result_title": "他是先登的冠军", "result_text": "哲巴尔唱诵着，那是苏丹第一次夺城时先王赐予的荣耀。", "result": {"s8+s9": 1, "s8+equip": 2000915}, "action": {}}, {"condition": {"s12.is": 2000065, "s12.苏丹的近卫": 1}, "result_title": "他是狮子猎人", "result_text": "法里斯唱诵着，那是所有曾经独自猎杀雄狮的武士才能使用的徽记。", "result": {"s12+s13": 1, "s12+equip": 2000915}, "action": {}}, {"condition": {"s10.is": 2000012, "s10.苏丹的近卫": 1}, "result_title": "他是战士王", "result_text": "赛里曼唱诵着，那是苏丹加冕时的尊号，也是众神的祝福——不具天命者，将无法在他面前举起武器。", "result": {"s10+s11": 1, "s10+equip": 2000915}, "action": {}}, {"condition": {"s6.is": 2000923, "s6.苏丹的近卫": 1}, "result_title": "他是为众剑所吻的王子", "result_text": "近卫唱诵着，那是苏丹曾经的名号——掌握了所有十三种剑术流仪的王血方能被祝福的尊号。", "result": {"s6+s7": 1, "s6+equip": 2000915}, "action": {}}, {"condition": {"s8.is": 2000925, "s8.苏丹的近卫": 1}, "result_title": "他是先登的冠军", "result_text": "近卫唱诵着，那是苏丹第一次夺城时先王赐予的荣耀。", "result": {"s8+s9": 1, "s8+equip": 2000915}, "action": {}}, {"condition": {"s12.is": 2000926, "s12.苏丹的近卫": 1}, "result_title": "他是狮子猎人", "result_text": "近卫唱诵着，那是所有曾经独自猎杀雄狮的武士才能使用的徽记。", "result": {"s12+s13": 1, "s12+equip": 2000915}, "action": {}}, {"condition": {"s6.is": 2000064, "!s6.苏丹的近卫": 1}, "result_title": "这是反叛的利刃", "result_text": "奈布哈尼拿拔出了这对双刃——这是近卫御赐的武器，但他很少使用，因为它们在吞噬血肉时会发出欢欣的笑声。", "result": {"s6+s7": 1, "s6+追随者": 1}, "action": {}}, {"condition": {"s8.is": 2000054, "!s8.苏丹的近卫": 1}, "result_title": "暴君当受死刑", "result_text": "哲巴尔举起了他成名的斩首斧——只收割最强大战士的头颅。", "result": {"s8+s9": 1, "s8+追随者": 1}, "action": {}}, {"condition": {"s10.is": 2000012, "!s10.苏丹的近卫": 1}, "result_title": "感受我的敌意", "result_text": "这是敌意之刃，当有人心怀恶意接近时，剑刃会发出幽幽蓝光——自从苏丹的游戏开始以来，它从未熄灭过。", "result": {"s10+s11": 1, "s10+追随者": 1}, "action": {}}, {"condition": {"s12.is": 2000065, "!s12.苏丹的近卫": 1}, "result_title": "我将向君主冲锋", "result_text": "法里斯将这把无比华丽的弯刀指向了苏丹——从前，光靠这把刀就可以调动一千名骑士，现在，哪怕孤身一人他也要发起冲锋。", "result": {"s12+s13": 1, "s12+追随者": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000024}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "苏丹"}, "s2": {"condition": {"type": "item", "is": 2000915}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "连阳光与影子都是属于苏丹的"}, "s3": {"condition": {"type": "item", "is": 2000916}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "摧残王者之刃"}, "s4": {"condition": {"type": "item", "is": 2000917}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "他不需要防护，但需要展现威仪"}, "s5": {"condition": {"type": "item", "is": 2000918}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "摧残弱者之刃"}, "s6": {"condition": {"any": {"is": 2000923}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "苏丹的近卫"}, "s7": {"condition": {"is": 2000919}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "伊喀尔与胡塞"}, "s8": {"condition": {"any": {"is": 2000925}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "苏丹的近卫"}, "s9": {"condition": {"is": 2000920}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "斩首斧"}, "s10": {"condition": {"is": 2000012}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "苏丹的近卫"}, "s11": {"condition": {"is": 2000921}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "琉璃锋"}, "s12": {"condition": {"any": {"is": 2000926}}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "苏丹的近卫"}, "s13": {"condition": {"is": 2000922}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "骑兵之刃"}, "s14": {"condition": {"type": "char", "主角": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "面对苏丹吧！"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
