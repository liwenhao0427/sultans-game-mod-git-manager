+{"id": 5208116, "name": "丝绒暗室", "text": "你将阁楼改造为一个权谋密谈的暗室，厚重的帷幕给了人一种安全感，仿佛什么都可以谈论，什么都有机会发生。", "tips": "", "mapping_id": 8001147, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_8", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每隔5天会开张一次"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s1.追随者<": 1, "s2.追随者<": 1}, "result_title": "", "result_text": "两名贵族在这个房间里喝酒、闲谈，并未察觉有些值得注意的情报已经落到了你的耳中。", "result": {"loot": 6001062}, "action": {}}, {"condition": {"!s1.密教徒": 1, "!s2.密教徒": 1, "any": {"s1.追随者>=": 1, "s2.追随者>=": 1}}, "result_title": "", "result_text": "话题在刻意的引导之下流转，你期待着能够从中找到更有价值的东西。", "result": {"loot": 6001063}, "action": {}}, {"condition": {"any": {"all": {"s2.追随者>=": 1, "s2.密教徒": 1}}}, "result_title": "", "result_text": "话题在刻意的引导之下流转，你期待着能够从中找到更有价值的东西。", "result": {"loot": 6001064}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "!苏丹": 1, "!主角": 1, "贵族": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "密会的贵族"}, "s2": {"condition": {"type": "char", "!苏丹": 1, "!主角": 1, "贵族": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "密会的贵族"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
