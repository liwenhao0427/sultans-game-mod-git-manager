+{"id": 5400269, "text": "利用", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100269}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400269_option_1", "text": "只要稍微想想就知道，这是一个极好的把柄，只要把它呈给苏丹就能揭发哲巴尔，说不定，你有机会除掉苏丹的左膀右臂……\n又或者，你可以借此声明你杀死了那名厉害的拳斗士，大大扬名？你要怎么选？", "icon": "cards/2000001", "items": [{"text": "要挟哲巴尔", "tag": "op1"}, {"text": "呈给苏丹", "tag": "op2"}, {"text": "拿去黑街扬名", "tag": "op3"}]}, "case:op1": {"prompt": {"id": "5400269_prompt_1", "text": "既然这是个重要的把柄，那你自然可以拿它要挟哲巴尔，只是，你打算向他索要怎样的报酬呢？", "icon": "cards/2000001"}, "rite": 5000761, "failed": {"prompt": {"id": "5400269_prompt_4", "text": "看来哲巴尔现在正忙，无法回应你的邀请。明天再试试吧。", "icon": "cards/2000054"}}, "event_off": 5400269}, "case:op2": {"prompt": {"id": "5400269_prompt_2", "text": "既然如此决定了，可在权力的游戏里将其献给苏丹。", "icon": "cards/2000001"}, "event_off": 5400269}, "case:op3": {"rite": 5000763, "prompt": {"id": "5400269_prompt_3", "text": "可以当做击败著名拳斗士的证据，拿到黑街去炫耀。", "icon": "cards/2000001"}, "event_off": 5400269}}}]}
