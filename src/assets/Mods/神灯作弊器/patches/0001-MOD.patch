+{"id": 5200511, "name": "无法追溯的罪行", "text": "你手段尽出，终于拿到了确凿的罪证，知道凶手的身份，然而……", "tips": "", "mapping_id": 8001218, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "黑街:[1,5]", "icon": "rite_20", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "罪人已死", "result_text": "你得到的证据指向法务官阿穆尔，他的邪行在城中引起轩然大波，然而可惜的是，他在得到应有的惩戒、赎还所有罪恶之前就已死去。无数善良的市民、诗人和画师涌入黑街，悼念这七十七名枉死的女奴，讴歌她们的美丽、刻画她们的折磨、传颂她们的痛苦。这些诗歌和画作让一些人乘势名声鹊起，身价倍增，很快被贵族们竞相招揽。他们离开后，黑街慢慢恢复了冷清，就像什么也没有发生过。至于那些含恨的少女们该如何告慰？没有人在乎；如何平息她们的怨恨？反正不会是这样的方式。", "result": {"counter+7100004": 1, "clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000137}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "尚未失效的罪证"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
