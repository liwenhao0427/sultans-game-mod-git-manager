+{"id": 5421022, "text": "盖斯声望事件-归还", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121022}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"coin": 10, "prompt": {"id": "5421022_prompt_01", "text": "盖斯拿出了一个旧旧的钱袋，里面是他紧巴巴凑出来的10金币。他说什么都要把这钱还给你。\n“我不希望我们的友谊有太多其他的负担。”他认真地说，“我想要提醒自己，也希望您知道，我追随您并非出于恩情，而是我的心做出的选择。”", "icon": "cards/2000056"}, "success": {"event_off": 5421022}}}]}
