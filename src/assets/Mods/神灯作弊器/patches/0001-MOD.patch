+{"id": 5206043, "name": "梅姬的秘方", "text": "梅姬给了你一罐据说能消除疤痕、保护皮肤的药膏，也许你可以找个人来试试它的功效。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["药膏只有一次使用次数，可永久增加1点魅力。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1": 1, "s2": 1}, "result_title": "", "result_text": "这份药膏效果非常好，[s1.name]皮肤变得更好了。不过，你可不敢朝梅姬再多要几份送给自己的追随者们，毕竟……这是梅姬的秘方……", "result": {"clean.s2": 1, "s1+魅力": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你可以亲自，或者找任意追随者来试试这罐药膏的功效。"}, "s2": {"condition": {"type": "item", "is": 2000670}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "梅姬的独门秘方"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
