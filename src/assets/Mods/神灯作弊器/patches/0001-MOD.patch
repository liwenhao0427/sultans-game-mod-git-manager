+{"id": 5204833, "name": "造物主的影子", "text": "你看着这幅画，越看越感觉到，那影子要转头过来看你……如果你将其定义，就可以将这影子纳入自己的力量。", "tips": "", "mapping": 8001004, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_8", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["放入不同的理念，得到不同的奖励"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"any": {"s2.is": 2000412}}, "result_title": "祂是万物之源", "result_text": "你看到了造物主所做的工——那超越神明的至尊，至慈的书写者一笔一划地描绘万物。\n而创造之神就是祂涂抹这个世界的颜料。我们的一切，乃至于万物都源于祂，甚至我们也都是祂身体的一部分……这个世界诞生于祂的污痕，也终将归于祂。", "result": {"clean.s1": 1, "card": 2000724, "counter+7100005": 1}, "action": {}}, {"condition": {"any": {"s2.is": 2000728}}, "result_title": "祂修正世界", "result_text": "你看到了造物主所做的工——那超越神明的至尊，至慈的书写者在一遍又一遍地修改自己的作品……而祂正是使用纯净之神将一切恢复空白。没有祂的力量，世界将充满错误，杂乱无章，祂就是法则，祂也将成为终焉。", "result": {"clean.s1": 1, "s2+虔信": 1, "counter+7100005": 1}, "action": {}}, {"condition": {"s2.is": 2000723}, "result_title": "世界的根源", "result_text": "你看到了造物主所做的工——那超越神明的至尊，至慈的书写者在创作时的样子。而我们现在所崇拜的神明，不过是祂手上的工具……世界源于有理性的创造，而非混沌与权力，这个想法深深地鼓舞了你。", "result": {"clean.s1": 1, "s2+回收": 1, "card": 2000723}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2001062}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "《月之暗面》"}, "s2": {"condition": {"any": {"is": 2000723}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "理性，正教或密教的思潮"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
