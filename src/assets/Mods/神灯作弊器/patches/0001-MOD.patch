+{"id": 5200504, "name": "幕后真凶", "text": "你掌握着法务官犯罪的确凿证据，同时，这也是能够拿捏他、令他为你所用的把柄。", "tips": "", "mapping_id": 8001008, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_12", "tag_tips": [], "tips_text": ["根据你的选择，可能会开启后续不同的仪式"], "open_conditions": [{"condition": {"any": {"s2": 1, "s3": 1}}, "tips": "你打算如何对待这位法务官？"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1}, "result_title": "你决定杀死这个罪人……", "result_text": "阿穆尔在你亮出的证据面前痛哭流涕，丑态百出，祈求着你的原谅。然而，能够决定是否原谅他的人早已死去，你能做的，不过是将他送到她们的面前。", "result": {"s1+决斗标记": 1, "s2+决斗标记": 1}, "action": {"rite": 5000512}}, {"condition": {"s3": 1}, "result_title": "他应当为我所用……", "result_text": "阿穆尔在你亮出的证据面前痛哭流涕，丑态百出，祈求着你的原谅。那双苍老的眼睛里混杂着错愕、不甘和恐惧，但如你所料的那般，唯独没有悔恨。没关系，你不需要他悔恨，你需要的是他臣服。\n法务官颤抖着向你深深地低下头颅。他把你想知道的一切都告诉了你，包括那座宅邸深处的邪恶仪式的功效，包括能够主持那一仪式的女术士的行踪……", "result": {"s1+支持": 5, "s1+追随者": 1, "s1=反对": 0, "counter+7000019": 1}, "action": {"event_on": 5300007}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000164}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你掌握了法务官阿穆尔的行踪"}, "s2": {"condition": {"type": "char", "!s3": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "选择1：你可以派遣任意追随者，或者亲自诛杀罪案的真凶"}, "s3": {"condition": {"type": "char", "!s2": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "选择2：你可以派遣任意追随者，或者亲自和法务官聊聊，威胁他为你所用"}, "s4": {"condition": {"is": 2000137}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须置入道具【尚未失效的罪证】"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
