灵感": 0}, "action": {}}, {"condition": {"r1:智慧+灵感>=": [3, 5]}, "result_title": "", "result_text": "漂亮的饰品！", "result": {"global_counter+7200184": 1, "loot.已拥有+1": 6000054, "s1=灵感": 0}, "action": {}}, {"condition": {"r1:智慧+灵感>=": [1, 5]}, "result_title": "", "result_text": "勉强可用的饰品。", "result": {"global_counter+7200184": 1, "loot.已拥有+1": 6000053, "s1=灵感": 0}, "action": {}}, {"condition": {"r1:智慧+灵感<": [1, 5]}, "result_title": "", "result_text": "一无所获，下次再接再厉", "result": {"s1=灵感": 0}, "action": {}}], "settlement_extre": [{"condition": {"s3": 1, "s3.消耗品": 1, "!s3.is": 2000723}, "result_title": "", "result_text": "你提供的制作材料并没有用处。", "result": {"s3+回收": 1}, "action": {}}, {"condition": {"s3": 1, "!s3.消耗品": 1}, "result_title": "", "result_text": "你提供的制作材料并没有用处。", "result": {}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000019}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "珠宝商人热娜"}, "s2": {"condition": {"type": "item", "cost.金币": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "需要5金币"}, "s3": {"condition": {"type": "item", "any": {"!可堆叠": 1, "cost.可堆叠": 1}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "特殊的制作的材料"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
