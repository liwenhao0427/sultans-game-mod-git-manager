+{"id": 5400602, "text": "讽刺的歌", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100602}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400602_option_1", "text": "附近的另一个氏族豢养的诗人这段时间总是在写诗讽刺你，像苍蝇似的挥之不去，不胜其烦。", "icon": "cards/2000001", "items": [{"text": "隔空对骂", "tag": "op1"}, {"text": "与之决斗", "tag": "op2"}, {"text": "大加赞赏", "tag": "op3"}, {"text": "求助苏丹", "tag": "op4"}]}, "case:op1": {"counter-7100003": 1, "prompt": {"id": "5400602_prompt_1", "text": "你气得暴跳如雷，疯狂地咒骂那名诗人。你气急败坏的模样令人们印象深刻，更何况那名诗人马上又写了一首诙谐幽默的讽刺诗回击你……你的名字在很长一段时间内都伴随着人们的笑声。", "icon": "cards/2000001"}}, "case:op2": {"counter+7100003": 1, "counter-7100001": 1, "prompt": {"id": "5400602_prompt_2", "text": "那名诗人根本没料到你会找上门来决斗，他不善刀兵，输得毫无悬念。你冷笑着将弯刀从他心脏里抽出来，环视四周，只看到一双双畏惧的眼睛。很好，再也没有人敢讽刺你了。你突然懂得了苏丹，恐惧就是最好的统治。", "icon": "cards/2000001"}}, "case:op3": {"card": 2000476, "prompt": {"id": "5400602_prompt_3", "text": "你找来了那名诗人的原稿，觉得他写得真心不错，诙谐幽默，笔锋辛辣，还带着点哲理……你的大加赞赏出乎所有人的意料，而那名诗人听说之后，也写了一首新诗，夸奖你的肚量。", "icon": "cards/2000001"}}, "case:op4": {"rite": 5006501, "prompt": {"id": "5400602_prompt_4", "text": "他怎敢这么对你？你必须让他付出代价！杀死一名诗人，那个氏族还会培养新的诗人，这远远不够……你下定了决心，带着一张征服卡来到宫廷之上，希望苏丹能够帮助你，派兵将那个氏族彻底地抹去。", "icon": "cards/2000001"}}}}]}
