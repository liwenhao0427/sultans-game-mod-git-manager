+{"id": 5208051, "name": "欢快的访客", "text": "家仆带着奇怪的表情向你通报，有位年轻绅士希望见见你。", "tips": "", "mapping_id": 8001077, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1}, "result_title": "一位新的支持者", "result_text": "是快脚。他现在叫阿木剌·图斯，这是哲瓦德为他买的家族和名字，这样他才能名正言顺的跟阿鲁米娜结婚。\n他对你百般感激，态度非常谦恭，和他跋扈的妻子截然相反。据他说，哲瓦德一开始非常不乐意招一个曾经的奴隶做女婿，但渐渐地，即使是他也承认，全世界可能只有快脚能承受阿鲁米娜的脾气了。\n你拍拍他的肩膀，祝他和阿鲁米娜幸福。", "result": {"counter+7100003": 1, "loot": 6000057, "counter+7000503": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000794}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿木剌·图斯"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "让一个人接待阿木剌·图斯"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
