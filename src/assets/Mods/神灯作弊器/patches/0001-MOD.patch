+{"id": 5400501, "text": "偷盗的仆人", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100501}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400501_option_1", "text": "在厄运降临的时候，你和妻子就遣散了大部分仆人，避免这场残酷的游戏波及他们。可惜，并非人人都完全领受你们的善意，其中一个人偷走了一笔钱……好在他刚准备花掉就被抓住了。", "icon": "cards/2000001", "items": [{"text": "这钱是我给他的", "tag": "op1"}, {"text": "就用他的身体来抵罪吧", "tag": "op2"}, {"text": "留下钱，让他滚", "tag": "op3"}]}, "case:op1": {"counter+7100001": 1, "counter-7100002": 1, "prompt": {"id": "5400501_prompt_1", "text": "你放走了他，也许是因为慈悲，也许是因为疲惫。", "icon": "cards/2000001"}}, "case:op2": {"card": [2000534, "已拥有+1"], "prompt": {"id": "5400501_prompt_2", "text": "你把他关在仓库里，等你抽到杀戮或者纵欲卡的时候就可以用了。", "icon": "cards/2000001"}}, "case:op3": {"coin": 3, "prompt": {"id": "5400501_prompt_3", "text": "你留下了钱，因为你需要它。你放走了他，因为你对残暴与愤怒失去了兴趣。", "icon": "cards/2000001"}}}}]}
