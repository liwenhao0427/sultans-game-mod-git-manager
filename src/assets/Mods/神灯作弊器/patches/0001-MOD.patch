+{"id": 5400609, "text": "分羊", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100609}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400609_option_1", "text": "有两个人在城里起了争执，一个宣称是邻居窃走了他的羊，邻居却说是他抛弃了生病的羊羔，如果不是自己收留医治，羊早就死在荒漠里了……他们请你评理，这羊该归谁所有？", "icon": "cards/2000001", "items": [{"text": "原主人", "tag": "op1"}, {"text": "邻居", "tag": "op2"}, {"text": "归我所有", "tag": "op3"}, {"text": "宰羊分食", "tag": "op4"}]}, "case:op1": {"counter+7100004": 1, "prompt": {"id": "5400609_prompt_1", "text": "你表示自己支持原主人的主张。这羊本来就是他的，不论中间有什么曲折，都不改变它的归属。原主人大喜过望，拍着你的肩膀跟你称兄道弟了起来。", "icon": "cards/2000001"}}, "case:op2": {"counter+7100001": 1, "prompt": {"id": "5400609_prompt_2", "text": "医治病羊耗费的钱财和心力，足以让你支持这只羊归邻居所有。邻居感谢你的公正，满意地抱着心爱的小羊离开了。", "icon": "cards/2000001"}}, "case:op3": {"counter+7100002": 1, "prompt": {"id": "5400609_prompt_3", "text": "呵呵，既然被我碰上了，这羊就归我所有了！\n你大声笑着，命仆人将那头羊牵走，只留下那两人在原地面面相觑，不知所措……", "icon": "cards/2000001"}}, "case:op4": {"counter+7100003": 1, "prompt": {"id": "5400609_prompt_4", "text": "你们做了这么多年的邻居，何必为这点小事伤了和气？\n你微笑着拉住两人的手搭在一起，命令仆人将那只羊当街宰杀，烤熟。香料烘托着油脂的芳香，紧紧包裹着被烤至微焦的鲜嫩羊肉……这滋味足以让世界上最凶恶的人放下干戈了！\n他们重归于好，异口同声地称赞你的睿智与贤明。", "icon": "cards/2000001"}}}}]}
