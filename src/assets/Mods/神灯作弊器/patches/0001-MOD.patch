+{"id": 5400554, "text": "我叫小薇", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100554}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"prompt": {"id": "5400554_prompt_01", "text": "你好！因为我打赌输了，所以我留下来陪您玩！你可以叫我小薇！\n在你面前的妖精格外的娇小，她能躲在人的袖子里，也可以如同落叶一般拂过面颊而不被人注意！应该会很有用……嘿！你手里那枚金币是从哪来的！", "icon": "cards/2000432"}, "event_off": 5300556}}]}
