@@ -0,0 +1 @@
+{"id": 5410624, "text": "选光者", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5110624}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5410624_option_1", "text": "由于你对纯净者的虔诚信仰和无私奉献——以及你此前表现出来的对神光的敏锐，教会邀请你来主持今年的神光检定会，简单来说，就是看谁神光强就选谁来当僧侣或者祭司啦。\n不过这种事通常都伴随着复杂的政治斗争，而且教会一向不会给你什么报酬，所以，你要蹚这浑水么？", "icon": "common/position_shenmiao_1", "items": [{"text": "接受", "tag": "op1"}, {"text": "拒绝", "tag": "op2"}]}, "case:op1": {"no_prompt": {"card": 2001096}, "rite": 5004526, "prompt": {"id": "5410624_prompt_1", "text": "你接受了这个任务，并且着重强调，你不是为了什么谢礼才接受的，而是出于对纯净者的虔信。\n祭司连呼“那当然”，离开前，他给了你两个名额，这意味着你能够在接下来的仪式中为教会甄选两名祭司。", "icon": "common/position_shenmiao_1"}, "event_off": 5410624}, "case:op2": {"prompt": {"id": "5410624_prompt_2", "text": "你委婉地拒绝了使者，说你最近忙于苏丹的游戏，实在无法脱身。大概是你看错了吧，但这名使者似乎松了口气。", "icon": "common/position_shenmiao_1"}, "event_off": 5410624}}}]}
