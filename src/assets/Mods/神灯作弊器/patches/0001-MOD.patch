+{"id": 5208095, "name": "一罐蜜饯", "text": "一罐男人专享的蜜饯！梅姬特地让人为你做的！还有谁没吃过？哈哈哈哈哈！", "tips": "", "mapping_id": 8001130, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_18", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以与自己的追随者一起享用"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s1": 1, "s2": 1}, "result_title": "就你有老婆？", "result_text": "大家翻着白眼看你疯狂显摆，一个接一个迅速把这罐蜜饯吃了个精光。", "result": {"s2+隐匿": 1, "s3+隐匿": 1, "s4+隐匿": 1, "s5+隐匿": 1, "clean.s1": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000941}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "一罐蜜饯"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你馋了"}, "s3": {"condition": {"type": "char", "追随者": 1, "!主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以邀请任何一位朋友共同品尝"}, "s4": {"condition": {"type": "char", "追随者": 1, "!主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以邀请任何一位朋友共同品尝"}, "s5": {"condition": {"type": "char", "追随者": 1, "!主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以邀请任何一位朋友共同品尝"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
