+{"id": 5200855, "name": "共襄盛举", "text": "“啊，我已经替你安排好了，”苏丹高兴地说，“未来五天里所有人都可以免费出入欢愉之馆，看上哪个姑娘都没问题，全部免费，也就是说，全部由你出钱——这是为了赞誉我的伟大统治，你肯定不会有意见吧，[player.name]卿？", "tips": "", "mapping_id": 8001506, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_22", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["每天进贡10金币，否则杀头，一共有5天"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"!s1": 1}, "result_title": "扫兴的东西", "result_text": "你出钱请大家嫖妓的善举（？）为苏丹赢得了不少好名声，遗憾的是，你实在是掏不出钱了。苏丹处死你的时候，那些没来得及享受免费福利的人们冲你的尸体丢了不少石头。", "result": {}, "action": {"over": 8}}, {"condition": {"s1": 1, "s2.倒计时>": 1}, "result_title": "就差搓出火星子了", "result_text": "你掏了钱，大家又能免费爽一天了。欢愉之馆前所未有的忙碌，城市里所有妓女、男妓、娈童还有所有之前干过这些活儿又想要捞点外快的人，全被布缇娜女士组织到了一起。她下定决心要掏空你的钱袋。城市的生产和商业几乎完全停滞了，人们挤着排队，谁还顾得上干活！快点，快交钱，整座城市的嫖客都正等着呢！", "result": {"clean.s1": 1, "clean.s2": 1}, "action": {"rite": 5200855}}, {"condition": {"s1": 1, "s2.倒计时=": 1}, "result_title": "累了", "result_text": "城里哪怕是最老，最廉价的妓女也直不起腰来了，你掏空了半个城市的子孙袋，他们也掏空了你的钱包……至少接下来城市的治安会好上一段时间。", "result": {"clean.s1": 1, "clean.s2": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.金币=": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "金币"}, "s2": {"condition": {"type": "item", "is": 2001058, "cost.倒计时": [1, 5]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "还有几天来着"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
