+{"id": 5208128, "name": "如露散", "text": "梅姬的葬礼之后，哈比卜一言不发地消失了。", "tips": "", "mapping_id": 8001113, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_8", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s1": 1}, "result_title": "", "result_text": "哈比卜消失得很突然。他没有回到你的领地上去继续干活，也没有交待舍馆的接替者，他就这么一言不发地离开了，像是从未存在过一样。", "result": {"clean.s1": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"is": 2000014}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "悲伤的哈比卜"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
