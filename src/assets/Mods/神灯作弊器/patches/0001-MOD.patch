+{"id": 5200794, "name": "天下武学验证战？", "text": "你战胜了挑战者，而那名妓女，也如她单方面的约，来邀请你了来着……", "tips": "", "mapping_id": 8001278, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"event_on": 5300212, "prompt": {"id": "5200794_prompt_01", "text": "不不不，还是算了。你劝说那名妓女直接去找奈布哈尼，毕竟，他也是挑战的胜利者。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {"tips": ["体魄", "魅力", "社交"], "type": "normal_result"}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "武学验证！", "type": "normal_result", "type_tips": "你的体魄、魅力与社交为你提供了完整的骰子数量", "low_target": 3, "low_target_tips": "你至少需要3点成功获得“胜利”"}}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"r1:体魄+魅力+社交>=": [3, 5]}, "result_title": "三个人能玩的花样比两个人多多了", "result_text": "美丽的妓女拉着你和奈布哈尼一起入席，说着娇滴滴的柔媚情话，让场面丝毫不显尴尬。气氛烘托到了这份上，你们当晚谁也没有离开她的闺房。\n据说，那天晚上，这名妓女和世界上最强悍的两位勇士对天下种种武学进行了精细的验证，试遍了种种出招的姿势……总之，你在黑街的妓女们当中、在她们颇有权势的恩客们当中……都狠狠出名了。", "result": {"counter+7100003": 2}, "action": {"counter+7000652": 1, "event_on": 5300212}}, {"condition": {"r1:体魄+魅力+社交<": [3, 5]}, "result_title": "这对你来说有点太刺激了", "result_text": "美丽的妓女拉着你和奈布哈尼一起入席，说着娇滴滴的柔媚情话，让场面丝毫不显尴尬。气氛烘托到了这份上，你们当晚谁也没有离开她的闺房。\n在这之前你还没试过三个人一起，尤其是其他两位都是如此热情、如此深情的模样……\n据说，那天晚上，这名妓女和世界上最强悍的两位勇士对天下种种武学进行了精细的验证，试遍了种种出招的姿势……每每提起这段情事，她总是掩唇微笑，态度暧昧，反而让人们对你更加好奇，最近来你家附近闲逛的闲汉好像都变多了……", "result": {"counter+7100004": 1}, "action": {"counter+7000652": 1, "event_on": 5300212}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000789}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "名声大振的妓女"}, "s2": {"condition": {"type": "char", "is": 2000064}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "你怎么也在？"}, "s3": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty