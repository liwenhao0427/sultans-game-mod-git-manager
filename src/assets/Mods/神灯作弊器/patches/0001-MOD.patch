+{"id": 5204504, "name": "仪式的助手", "text": "纯净者教会正在准备一场祝神仪式，你可以派遣几位长相过关的追随者去协助他们。", "tips": "", "mapping_id": 8001201, "once_new": 1, "round_number": 3, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "5204504_prompt_01", "text": "没有你的帮助，仪式依然进行得非常顺利。你只是失去了一个在教会跟前刷脸的机会而已。", "icon": "common/position_shenmiao_1"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["虔信将显现在第一个人身上"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "端正貌美、富有亲和力的人在哪里都吃得开，你的帮助减轻了祭司们的负担。你在教会里的声望增加了。", "result": {"s1+虔信": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "!怪物": 1, "!动物": 1, "魅力>=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "魅力不小于5的人"}, "s2": {"condition": {"type": "char", "!怪物": 1, "!动物": 1, "魅力>=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "魅力不小于5的人"}, "s3": {"condition": {"type": "char", "!怪物": 1, "!动物": 1, "魅力>=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "魅力不小于5的人"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
