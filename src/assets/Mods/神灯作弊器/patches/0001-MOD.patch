@@ -0,0 +1 @@
+{"id": 5400502, "text": "欠钱的朋友", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100502}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400502_option_1", "text": "之前，在你还风光的时候，借给过朋友一笔钱，现在，到了你困难的时候，他却找出种种理由推脱……而他新买的宝石戒指在你面前晃动，格外碍眼。", "icon": "cards/2000001", "items": [{"text": "愤怒地转身离去", "tag": "op1"}, {"text": "找机会敲他闷棍", "tag": "op2"}, {"text": "在宫廷上羞辱他", "tag": "op3"}, {"text": "免了他的债", "tag": "op4"}]}, "case:op1": {"card": 2000038, "prompt": {"id": "5400502_prompt_1", "text": "你拂袖而去，心里甚至有点哀伤——你们的友谊就这样被几个金币买断了……不过从另一个方面来说，你只花了几个金币就认清了他的真面目，这未尝不是件好事……", "icon": "cards/2000001"}}, "case:op2": {"card": [2000535, "已拥有+1"], "prompt": {"id": "5400502_prompt_2", "text": "不管他找什么借口，你都不断点头——反正你的心已经离开了，去到了他回家必经之路的一段小巷里。过去，你们经常勾肩搭背从那里经过，今晚，你会在这里收回自己的债务。", "icon": "cards/2000001"}}, "case:op3": {"counter+7100002": 1, "counter+7100003": 1, "prompt": {"id": "5400502_prompt_3", "text": "你不准备和他私下争论了。所有难听的话，你要当着整个宫廷说。人们乐意在这样鸡毛蒜皮的小事上支持你——你为他们带来了多么有趣的笑话！", "icon": "cards/2000001"}}, "case:op4": {"counter+7100001": 1, "counter+7100003": 1, "prompt": {"id": "5400502_prompt_4", "text": "你笑着拍了拍他的肩膀，告诉他，自己已经得了苏丹的恩宠，以后用不上这样的小钱了。\n他那奸猾的臭脸总算是露出了一点惊疑的神色……至少在很长一段时间里，他都不会来找你麻烦了吧。", "icon": "cards/2000001"}}}}]}
