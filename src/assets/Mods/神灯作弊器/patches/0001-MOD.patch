+{"id": 5204521, "name": "异端之战", "text": "你是与纯净者教会决裂的异端，被祭司们驱逐的不信之徒，然而，多么可笑啊！你的使命已得神授，你是祂在陆上的代言人，那么，现在是时候证明了——谁才是异端？谁当执掌那纯净、洁白的权柄？", "tips": "", "mapping_id": 8001531, "once_new": 1, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {"tips": ["魔力", "魅力", "战斗", "体魄"], "type": "fight_result"}, "tips_text": ["先进行魔力与魅力的对抗，再进行战斗和体魄的对抗", "对方会死守正教的位置"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "神圣的真言构成了第一道阻拦你的屏障", "type": "fight_result", "type_tips": "你的魔力与魅力属性为你提供的骰子数量受对方影响", "low_target": 3, "low_target_tips": "你至少需要3点成功才能获得胜利。"}, "r2": {"text": "很多祭司惊惧间四散溃败，但更多的，依然认为这不过是你惯来耍弄的邪术——他们坚定地迎向你的刀锋，与你的队伍拼杀在了一起！", "type": "fight_result", "type_tips": "你的战斗与体魄属性为你提供的骰子数量受对方影响", "low_target": 3, "low_target_tips": "你至少需要3点成功才能获得胜利。"}}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"r1:魔力+魅力-e(魔力+魅力)<": [3, 5]}, "result_title": "虫豸相争", "result_text": "当那些纯净之言化为利剑刺穿你的心胸，你只觉得可笑——你该去问吗，为什么神赐予你正义之名，却用这样捉弄你？\n你的耳畔只有一片谎言笼罩的寂静——你在濒死的极度痛楚中，却再未听见祂的只言片语。", "result": {"clean.s6": 1, "clean.s5": 1, "clean.s4": 1, "clean.s3": 1}, "action": {}}, {"condition": {"r1:魔力+魅力-e(魔力+魅力)>=": [3, 5]}, "result_title": "得天所授", "result_text": "他们张开嘴，却发不出任何声音。纯净者将他们抛弃了，祂用你的喉咙，只说了一句话——天地间，只这一句话还有资格发出声音——\n<size=+10><font=\"TitleSDF\"><b>吾将降临</b></font></size>", "result": {}, "action": {}}, {"condition": {"r1:魔力+魅力-e(魔力+魅力)>=": [3, 5], "r2:战斗+体魄-e(战斗+体魄)<": [3, 5]}, "result_title": "虫豸相争", "result_text": "纯净者教会的主祭和祭司们镇压了这次可笑的叛乱，清洗了所有参战的异端。\n不自量力的人啊，你倒下的那一刻，难道还在乞求、还在奢望神的怜悯吗？", "result": {"clean.s6": 1, "clean.s5": 1, "clean.s4": 1, "clean.s3": 1}, "action": {}}, {"condition": {"r1:魔力+魅力-e(魔力+魅力)>=": [3, 5], "r2:战斗+体魄-e(战斗+体魄)>=": [3, 5]}, "result_title": "", "result_text": "你无情地屠戮了每一个负隅顽抗的人——每一个自以为信仰坚贞，实则早已偏离正道的人。他们的血被茉莉花水冲散，纯白的石板上重新变得洁净如新。你就踏着这样的罪孽、这样的杀业，迈步走向教会最深处的祭坛。然后对着所有臣服于你的、战战兢兢的信徒，再一次高声宣告、再一次重复你所聆听到的启示——\n<size=+10><font=\"TitleSDF\"><b>神将降临，神将令世界就此完美。</b></font></size>", "result": {"clean.s1": 1, "clean.s2": 1, "s3.uprare": 1, "s3=图片": 1, "s3+魅力": 2, "s3+魔力": 2, "s3+社交": 2, "s3+equip": 2000098, "counter+7100003": 2, "counter+7100005": 2, "s3+教领": 1, "counter+7000591": 1}, "action": {}}, {"condition": {"r1:魔力+魅力-e(魔力+魅力)>=": [3, 5], "r2:战斗+体魄-e(战斗+体魄)>=": [3, 5], "s8": 1}, "result_title": "", "result_text": "这场血腥的清洗赢得了苏丹的认可。他甚至公开认可了你的纯净者教领的名号，微笑着，戏谑着，等待你把这场好戏继续演下去。", "result": {"clean.s8": 1}, "action": {}}, {"condition": {"r1:魔力+魅力-e(魔力+魅力)>=": [3, 5], "r2:战斗+体魄-e(战斗+体魄)>=": [3, 5], "s8": 1, "counter.5000579<": 1}, "result_title": "裂隙", "result_text": "冥冥之中，有一道裂隙已被撕开，有一重罪孽，已由这张卡片领受。", "result": {"card": [2001036, "已拥有+1"], "counter+5000579": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000021}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "异端者主祭"}, "s2": {"condition": {"type": "item", "is": 2001092}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "异端的军队"}, "s3": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须亲自率队征伐异端"}, "s4": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以委派一名追随者协助作战"}, "s5": {"condition": {"any": {"type": "char"}, "部队": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "响应你号召的圣战队伍"}, "s6": {"condition": {"any": {"type": "char"}, "部队": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "响应你号召的圣战队伍"}, "s7": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "在作战中派得上用场的消耗品"}, "s8": {"condition": {"type": "sudan", "征服": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以借机折断任意一张征服卡"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}