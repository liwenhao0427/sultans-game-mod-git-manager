+{"id": 5206051, "name": "阿迪莱正在冒险", "text": "阿迪莱正在龙巢附近确认巨龙的踪迹……", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "野外:[1,14]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"counter.7000183<": 1}, "result_title": "", "result_text": "阿迪莱仍未有音信传回。", "result": {}, "action": {"rite": 5206051}}, {"condition": {"counter.7000183>=": 1}, "result_title": "", "result_text": "阿迪莱回来了。她身上又多了一些伤口，问起时，她满不在乎地说，自己在近距离观察龙巢的时候险些被巨龙发现，还好她摆脱了恐惧滚下山坡，这才逃出生天。\n梅姬认定这是祈福仪式起了作用。她高兴地拥抱了阿迪莱，向她诉说自己的担忧。阿迪莱看起来也不轻松，不过，她的眼睛里更多的是坚定与兴奋。\n“那真的是龙！那个怪物！！”她紧紧地抓住梅姬的手，“梅姬，我真不知道该怎么谢你。听着，我会杀了那条龙，把它的脑袋献给你，我保证！”\n", "result": {"s1+魔力": 1}, "action": {"event_on": 5320541}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000061}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿迪莱正在冒险"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
