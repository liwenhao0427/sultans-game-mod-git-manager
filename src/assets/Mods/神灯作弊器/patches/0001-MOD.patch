15": {"condition": {"type": "char", "!食客": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "任命传令官，他的隐匿与生存会帮助之后的战斗"}, "s16": {"condition": {"type": "char", "!食客": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "任命旗手，他的魅力会帮助之后的战斗"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
