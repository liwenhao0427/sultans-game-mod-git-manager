+{"id": 5200674, "name": "促成谈判", "text": "山匪凭借着对地势的熟悉和来去如风的快马，很难强行收服，而他们选择掠劫商队，无非是因为山中没有耕地，无法满足日常所需。你决定派遣你认可的“外交官”和他们谈判。", "tips": "", "mapping_id": 8001174, "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["为了确保成功，和山匪谈判的人员至少需要6点社交属性。", "上下打点关系至少需要6枚金币"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "你安排双方进行谈判", "result_text": "你用金钱开道，带着当地的商会头目和沙匪头目见上了面。\n你用高超的谈判技巧说服了双方各退一步，商队将向沙匪缴纳一定的钱财和日用品，沙匪则提供保护和向导，确保商路通常。\n后来，那条通往东方的商路越发繁荣，你的事迹也在当地成了一桩美谈。", "result": {"counter+7100004": 1, "counter+7000070": 1}, "action": {"event_on": 5300166}}], "cards_slot": {"s1": {"condition": {"type": "char", "社交": 6}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "和山匪谈判的人员至少需要6点社交属性"}, "s2": {"condition": {"type": "item", "cost.金币": 6}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "6枚金币是必要的打点费用"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
