+{"id": 5400547, "text": "处置猎奴人", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100547}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400547_option_1", "text": "你姑且相信他把知道的都说出来，既然这样，那他现在也没用了。芮尔舔了舔嘴唇，问你，现在可以吃掉他的肝了吗？她忍好久了。", "icon": ["cards/2000771"], "items": [{"text": "就……就交给你了，注意点形象", "tag": "op1"}, {"text": "放了吧，不值得", "tag": "op2"}]}, "case:op1": {"table.2000771+体魄": 2, "table.clean.2000971": 1, "prompt": {"id": "5400547_prompt_1", "text": "你朝芮尔点了点头，接着自己走出了房间，不想见证这一残忍而原始的场面。", "icon": ["cards/2000771"]}, "event_off": 5400547}, "case:op2": {"prompt": {"id": "5400547_prompt_2", "text": "既然他配合你说出了他知道的东西，那么，从道义上来说你也不该如此苛待他。你提出把他放走，反正他背叛了自己的主人，又有那么多仇家、那么多盯着他的人，这一切够他受的了……\n芮尔勉强认可了你的说法。", "icon": ["cards/2000771"]}, "event_on": 5300548, "event_off": 5400547}}}]}
