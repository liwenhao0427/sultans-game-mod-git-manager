+{"id": 5208055, "name": "归乡之径（作废）", "text": "制图师在你家拜访时，质子恰好也上门来表达对你的感激之情。简短交谈几句之后，制图师兴奋的谈起她知道一条通往质子国度的小路。这条路要穿越沙漠和山谷，十分艰险，但却能隔绝开苏丹的视线……\n质子若有所思。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "5208055_prompt_0", "text": "你没有理会上门拜访的法尔达克，他只好独自离开了。"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_16", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [{"condition": {"any": {"s3": 1, "s4": 1}}, "tips": "需要接待法尔达克。"}], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s3": 1, "!s4": 1}, "result_title": "鼓励法尔达克", "result_text": "你们提到了一条险峻的，只有山狮与羚羊才知道的小路……你提醒质子，他能否逃跑取决于苏丹是否还在意他，而不是一条道路。但他仍然看到了希望。质子决定在【下次上朝时】候向苏丹提出请求。", "result": {"counter+7000351": 1, "card": 2000853}, "action": {}}, {"condition": {"s4": 1, "!s3": 1}, "result_title": "警告法尔达克", "result_text": "你警告制图师管好自己的嘴巴，苏丹的耳目无处不在……质子非常失望，但他知道你可能是对的。", "result": {"counter+7100003": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000350}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "法尔达克"}, "s2": {"condition": {"is": 2000069}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "麦娜尔"}, "s3": {"condition": {"type": "char", "!s4": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "鼓励法尔达克"}, "s4": {"condition": {"type": "char", "!s3": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "警告法尔达克"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
