+{"id": 5206041, "name": "举世无双的爱", "text": "你将举世无双、独一无二的荣耀赠给了梅姬，这足以让梅姬忘记你做过的大部分错事。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 7, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["本事件会定时开启，消除妻子的不满"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1": 1}, "result_title": "", "result_text": "你跪在地上捧着这颗巨龙的眼珠献给她的画面，时常出现在梅姬的睡梦中。很多个半梦半醒的夜晚，你能依稀感觉到，梅姬满含柔情的嘴唇情难自禁地吻在你的面颊上。", "result": {"clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "cost.不满": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "也许你们曾有龃龉"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
