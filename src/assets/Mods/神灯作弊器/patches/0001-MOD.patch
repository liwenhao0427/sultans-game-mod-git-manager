+{"id": 5200810, "name": "帮派斗争", "text": "你的势力已经深入黑街，需要一个代言人，豺狼众是这里的传统势力，而芮尔……最近不知道从哪突然冒出来的野蛮人，正带着一群人和他们斗。你打算支持谁呢？", "tips": "", "mapping_id": 8001284, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {"clean.s1": 1, "clean.s2": 1}, "action": {"prompt": {"id": "5200810_prompt_01", "text": "黑街的帮派争斗跟你有什么关系？你选择了袖手旁观。不久后，你从偶然闲谈中得知那个不知天高地厚的女蛮子死在了一次火拼中，她的势力自然也随之土崩瓦解。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "黑街:[2,5]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {"tips": ["战斗"], "type": "fight_result"}, "tips_text": ["投资你想投资的帮派势力吧"], "open_conditions": [], "random_text": {}, "random_text_up": {"r1": {"text": "事到如今已经无人关心对错", "type": "fight_result", "type_tips": "芮尔和她的匪帮的战斗属性所提供的骰子数量受到豺狼帮的影响", "low_target": 2, "low_target_tips": "芮尔至少需要2点成功才能击败豺狼帮。"}}, "random_effect": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"!s3": 1, "!s4": 1, "!s5": 1, "!s6": 1, "!s7": 1, "!s8": 1}, "result_title": "你选择了袖手旁观", "result_text": "黑街的帮派争斗跟你有什么关系？不久后，你从偶然闲谈中得知那个不知天高地厚的女蛮子死在了一次火拼中，她的势力自然也随之土崩瓦解。", "result": {"clean.s1": 1, "clean.s2": 1}, "action": {}}, {"condition": {"any": {"s3": 1, "s4": 1, "s5": 1, "s6": 1, "s7": 1, "s8": 1}}, "result_title": "一个麦饼引发的血案", "result_text": "谁也说不清楚这场风波最开始源于怎样鸡毛蒜皮的小事，在你注意到的时候，它已经演化成了黑街新旧势力不死不休的战争。", "result": {}, "action": {}}, {"condition": {"any": {"s3": 1, "s4": 1, "s5": 1, "s6": 1, "s7": 1, "s8": 1}, "r1:战斗-e(战斗)>=": [2, 5]}, "result_title": "谁还敢看不起烂泥巴", "result_text": "那个女人简直就是个疯子。她一边砍人，一边挖肝，就这么热腾腾血淋淋地塞进嘴里，喊着谁也听不懂的话，豺狼帮被她吓得闻风丧胆，一个比一个逃得快，他们老大在后面气得破口大骂，喊得声嘶力竭，最后还是成了女蛮子的补品。现在谁还敢惹烂泥帮的人啊，先摸摸自己有几个肝吧。", "result": {}, "action": {}}, {"condition": {"any": {"s3": 1, "s4": 1, "s5": 1}, "r1:战斗-e(战斗)>=": [2, 5]}, "result_title": "谢了！", "result_text": "一战成名之后，芮尔找到了你。“我又欠你一个人情了！”她非常豪爽地拍着你的肩膀，大咧咧地把你揽到一边，领着你去见自己那帮瘦弱但是凶狠的小弟，让他们认认你的脸，大有“以后大姐头罩你”之意。", "result": {"counter+7000466": 1}, "action": {"rite": 5000812, "event_on": [5300540, 5300542, 5300545, 5300550]}}, {"condition": {"any": {"s3": 1, "s4": 1, "s5": 1, "s6": 1, "s7": 1, "s8": 1}, "r1:战斗-e(战斗)<": [2, 5]}, "result_title": "你算老几", "result_text": "豺狼帮的势力在这几条街区早已根深蒂固，芮尔再怎么凶狠，可她的每一个动向都被豺狼帮掌握，每一次突击都像打在了棉花上。最后，她的手下被各个击破、彻底吞没，她本人亦已筋疲力竭，被豺狼帮的人活捉……这之后的下场，还用猜吗。", "result": {"clean.s1": 1, "clean.s2": 1}, "action": {}}, {"condition": {"any": {"s6": 1, "s7": 1, "s8": 1}, "r1:战斗-e(战斗)<": [2, 5]}, "result_title": "你很有眼光", "result_text": "尽管你的帮助在这场战斗中的影响微乎其微（他这么认为），事后，豺狼帮的老大还是向你表达了谢意：“有机会的话，期待下次合作。”", "result": {"s6+纳入收藏": 1}, "action": {"global_counter+7210025": 1, "rite": 5000811}}], "cards_slot": {"s1": {"condition": {"is": 2000771, "芮尔": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "芮尔"}, "s2": {"condition": {"type": "item", "is": 2000965}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "芮尔麾下的匪帮"}, "s3": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以为芮尔提供一些有用的物资"}, "s4": {"condition": {"type": "item", "cost.金币=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以为芮尔提供一些金币"}, "s5": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以为芮尔提供一些人手"}, "s6": {"condition": {"type": "item", "is": 2001057}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "盘踞在黑街根深蒂固的帮派"}, "s7": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "你可以为豺狼帮提供一些有用的物资"}, "s8": {"condition": {"type": "item", "cost.金币=": 5}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "你可以为豺狼帮提供一些金币"}, "s9": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 1, "text": "你可以为豺狼帮提供一些人手"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"