result": {}, "action": {}}, {"condition": {"r1:智慧+生存>=": [4, 5], "s2.is": 2000019}, "result_title": "", "result_text": "这次淘书的经历为热娜提供了珠宝的设计灵感。", "result": {"s2+灵感": 1}, "action": {}}, {"condition": {"counter.7000117<": 6}, "result_title": "", "result_text": "在过去，书曾经是一个逃避现实的好地方，毕竟那里充满了故事与虚构之物。而现在，你身在故事中心，在一切纸页上都只能看到暗喻，讽刺，提醒你现实的荒诞与不讲情理。", "result": {"counter+7000117": 1}, "action": {}}, {"condition": {"counter.7000117>=": 6, "counter.7000200<": 34, "any": {"counter.7000330<": 3, "counter.7000330>": 3}}, "result_title": "", "result_text": "一件值得注意的事情发生了。", "result": {"counter=7000117": 0, "counter+7000200": 1}, "action": {"event_on": 5300601}}], "cards_slot": {"s1": {"condition": {"is": 2000199, "书店老板": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "书店老板"}, "s2": {"condition": {"type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "派个追随者跟随", "pops": [{"condition": {}, "action": {"choose": {"pop.5202036_s2_01.s1": "找！找！找！"}}}]}, "s3": {"condition": {"type": "item", "cost.金币": 3}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "淘书的钱得你来付"}, "s4": {"condition": {"type": "item", "any": {"all": {"cost.消耗品=": 1, "!金币": 1}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些道具或许能在沟通中派上用场"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
