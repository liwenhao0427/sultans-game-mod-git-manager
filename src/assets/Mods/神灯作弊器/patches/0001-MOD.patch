+{"id": 5400351, "text": "是我做的", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100351}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"prompt": {"id": "5400351_prompt_1", "text": "你听说，最近有一名女仆似乎因为良心不安，去找盖斯自首了——你现在才知道，原来负责那名税吏案件的官员就是盖斯——她自称为了有机会嫁给自己的主人，一时鬼迷心窍，想办法杀害了自己的主母和小主人……盖斯又惊又怒，连夜展开审讯。据说最后斩首的时候，税吏恳请亲手行刑，处死这名罪恶滔天的女仆……\n你轻轻叹了口气。这便是那名女仆做出的选择。", "icon": "cards/2000001"}, "event_off": 5400351}}]}
