+{"id": 5208092, "name": "贵族也想吃", "text": "很快，你的舍馆里厨子极佳的消息不胫而走，就连贵族们都听说了，他们一再向你暗示，想让你安排他们去尝尝。", "tips": "", "mapping_id": 8001127, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"counter-7100004": 2, "prompt": {"id": "5208092_prompt_01", "text": "你没理会这些贵族，他们都四处传扬，说看来你的舍馆也不过如此。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_18", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s3.主角": 1, "s2.金币=": 5}, "result_title": "你亲自招待了他", "result_text": "5枚金币足够哈比卜端上一份合宜的套餐了。这名嘴馋的贵族对餐食、还有你对他的尊重非常满意，在朝堂上说了你不少好话。", "result": {"counter+7100003": 1}, "action": {}}, {"condition": {"s3.主角": 1, "s2.大餐": 1}, "result_title": "你亲自招待了他", "result_text": "哈比卜的手艺那还用说？这名嘴馋的贵族对餐食、还有你对他的尊重非常满意。很快，黑街上的人们就开始传，说你的舍馆里招待大家的都是平时贵族老爷们吃的菜色！这令你的舍馆更是名噪一时。", "result": {"clean.s2": 1, "counter+7100004": 1}, "action": {}}, {"condition": {"s3.is": 2000014, "s2.金币=": 5}, "result_title": "你给了哈比卜一笔钱", "result_text": "5枚金币足够哈比卜端上一份合宜的套餐了。这名嘴馋的贵族打着饱嗝，满意地离开了。\n当然，他来黑街舍馆这种地方吃饭已经是屈尊降贵，就别指望他回报你什么了。", "result": {}, "action": {}}, {"condition": {"s3.is": 2000014, "s2.大餐": 1}, "result_title": "你让哈比卜招待他", "result_text": "哈比卜的手艺自然了得，他甚至能把回锅的冷饭冷菜弄得谁也尝不出有问题。这名嘴馋的贵族打着饱嗝满意地离开了，大家都一边称赞哈比卜的机智，一边笑话那人是装出来的美食家。你听说了之后哭笑不得地问起，哈比卜也只是恭顺地回答说，他看不惯此人大摇大摆地对你予取予求的样子。", "result": {"counter+7100004": 1}, "action": {}}, {"condition": {"s3.is": 2000014, "!s2": 1}, "result_title": "你告知了那名贵族舍馆的地点", "result_text": "但是你“忘记”提前交代，所以哈比卜“以为”他也跟之前那帮闹事者一样是来混饭吃的——只是穿的衣服料子好一点，长相斯文一点……\n这一次，哈比卜吸取了此前的教训，毫不留情地用平底锅把他打了出去，那个贵族的惨叫附近三条街的居民都听得到。", "result": {"s3+战斗": 1, "counter+7100004": 1}, "action": {}}, {"condition": {"s3.主角": 1, "!s2": 1, "counter.7100003>=": 8}, "result_title": "就凭你也敢命令我？", "result_text": "你斜睨着那名贵族，冷哼着迈步离开了。\n很快，黑街上的人们就开始传，说你的舍馆里招待大家的，都是贵族老爷都吃不上的菜色！这令你的舍馆更是名噪一时。", "result": {"counter+7100004": 1}, "action": {}}, {"condition": {"s3.主角": 1, "!s2": 1, "counter.7100003<": 8}, "result_title": "就凭你也敢忤逆我？", "result_text": "那名贵族看你面露难色，马上就冷笑起来：“算了，那种地方，我也不是真想吃。”\n他头也不回地走了，事后和同僚们说了不少你的坏话。", "result": {"card": 2000168}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2001004}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "他说什么都想吃上你家舍馆的饭"}, "s2": {"condition": {"type": "item", "any": {"cost.金币": 5, "大餐": 1}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你可以拿出任意一份大餐招待他或者拿出5枚金币买食材现做"}, "s3": {"condition": {"any": {"is": 2000014, "主角": 1}, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你可以亲自招待，或者交给哈比卜处理"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
