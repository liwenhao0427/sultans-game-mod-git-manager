+{"id": 5200584, "name": "黄金体验", "text": "莎姬回馈给你钱财，在朝堂上支持你……但你们都知道，这不是她能给你的最好的东西，而你，值得最好的东西……", "tips": "", "mapping_id": 8001034, "once_new": 0, "round_number": 1, "waiting_round": 7, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"counter-7100003": 1, "prompt": {"id": "5200584_prompt_01", "text": "她是想要报答你的，但你的忽视同样刺伤了她的自尊。", "icon": "cards/2000010"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_13", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["为了报答你，她将给你最美妙的一夜。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "快乐的巅峰", "result_text": "冒着被苏丹发现的危险，你们在一处莎姬安排的宅邸秘密相会了。\n莎姬什么都没说，只是张开双臂抱住了你，而后，她蠕动着，向下求索着……当她的肉体包裹住你的肉体，你的灵魂也接纳了她的灵魂……你看到她曾经被神明一遍遍折磨的噩梦，看到她无知而贪婪地向未知的存在献祭许愿，看到她侍奉苏丹，看到她在妓院里攀附权贵，看到她在奴隶市场中挺起双乳，看到她逃离父亲的房间……\n你体验到了她的生命，体验到了这只有苏丹，宰相，妓院的打手，奴隶主，人贩子，她的父亲……才享受过的肉体技艺——每个男人对她来说都是阶梯，她踏过他们，变得更强大，更熟练，更完美，而你和她一起，沿着这阶梯达到了最高处。", "result": {"s2+魅力": 2, "s1+激情": 1}, "action": {}}], "settlement_extre": [{"condition": {"s3": 1}, "result_title": "最后，只剩下宁静", "result_text": "只有今晚，你忘却了一切，因为你已经饮下甘露，那是以凡人的生命与梦所酿造的琼浆，即便是神明，也可以从中得到一份慰藉。", "result": {"clean.s3": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000010}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "莎姬"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "只有你可以", "pops": [{"condition": {}, "action": {"pop.5200584_01.s1": "什么都不要问……"}}]}, "s3": {"condition": {"type": "item", "is": 2000326, "cost.疯狂": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "给予你某种平静"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
