@@ -0,0 +1 @@
+{"id": 5421025, "text": "过时不候III", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121025}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5421025_option_1", "text": "因为疏忽，又或者，因为一时资金紧张，你错过了这个头衔，而盖斯得知这个消息时，已经完全没有时间去筹钱了——他只能看着自家荣耀的头衔再度流落到了别人的口袋。\n听说他的母亲因为接受不了这样的结果一病不起，盖斯也因此变得有些消沉……\n“请不要道歉，朋友，我很感谢您为我做的这一切。我只是不理解……”他忍不住低声向你寻求答案，“在您看来，家族的头衔，过往的荣耀，真的有这么重要么？”", "icon": "cards/2000056", "items": [{"text": "很重要", "tag": "op1"}, {"text": "不重要", "tag": "op2"}, {"text": "这因人而异", "tag": "op3"}]}, "case:op1": {"prompt": {"id": "5421025_prompt_1", "text": "你毫不犹豫地告诉他，过往的荣耀当然是很重要的，我们不能够忘记，正是我们的姓氏、还有我们祖先的努力，让我们拥有了站在此地的资格。\n说到这里，你又一时语塞……自责了起来，都是因为你，害他错过了这样的良机。\n“没事的。”他微笑着摇摇头，反而宽慰起你来，“只要还活着，就总有机会，不是么。”\n你们之后又聊了些别的，但世袭头衔的事，终究是无疾而终了。", "icon": "cards/2000056"}, "success": {"event_off": 5421025}}, "case:op2": {"table.2000056+命运的羁绊": 1, "prompt": {"id": "5421025_prompt_2", "text": "你直视着他的眼睛，告诉他，如果那些虚名很重要，那么你当初就不会站出来斥责苏丹了。但时光倘若倒流，你依然会这么选。\n你顿了顿，接着又移开目光，赶忙补充道：“我很抱歉……我是说，我不是因为认为这不重要，才没有告诉你那个消息，实际上，我本想直接把头衔买下来给你的，只是没料到会……”\n“您不必为这种事道歉……”他怔了好一会儿，才喟叹道，“而且，您说得对，我也认为这不重要……我们……我们是同类人。”他轻轻握了一下你的臂膀，脸上带着一丝难得的轻松笑意。\n从未有过地，你们的灵魂在此刻是如此的贴近，仿佛已然水乳交融。", "icon": "cards/2000056"}, "success": {"event_off": 5421025}}, "case:op3": {"delay": {"id": 54210251, "round": 2, "event_on": 5321073}, "prompt": {"id": "5421025_prompt_3", "text": "你犹豫着，拿不定主意。\n“也许这因人而异吧，有的人认为这比灵魂和生命还重要，有的人则轻贱它，抛弃它犹如抛弃一件衣服……” \n“是吗。”盖斯失望地低下了眼。模棱两可的命运中，他找不到答案。", "icon": "cards/2000056"}, "success": {"event_off": 5421025}}}}]}
