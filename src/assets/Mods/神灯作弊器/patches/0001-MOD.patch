+{"id": 5206050, "name": "夫妻正应如此", "text": "你竭尽所能地帮助了梅姬。你们仿佛回到刚刚成婚的时候、还在热恋的时候，看向同一个未来，走向同一个未来。这感觉真是美妙极了。", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_6", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["可以趁机消除1个妻子的不满"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s1": 1}, "result_title": "", "result_text": "在终于卸下重担、完成嘱托的疲惫夜里，梅姬依偎在你怀里睡得无比香甜，仿佛忘掉了一切烦忧。", "result": {"clean.s1": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000083}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "倘若你们之间曾有过龃龉……"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
