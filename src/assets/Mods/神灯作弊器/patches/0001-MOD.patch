+{"id": 5208132, "name": "能吃吗？好吃吗？怎么吃？", "text": "如果你提供恰当的灵感来源或者优秀食材，这位技艺精湛的厨师很乐意为你做一顿大餐。", "tips": "", "mapping_id": 8001152, "once_new": 0, "round_number": 1, "waiting_round": 1, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"counter-7000520": 1}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_18", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"s2.is": 2000304}, "result_title": "手抓鳄鱼饭", "result_text": "即使是还没长大的小鳄鱼，它的肉也足够喂饱好几个成年人了。雪白的鳄鱼皮挂上浓稠的汤汁，看起来格外诱人。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001006}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000202}, "result_title": "熏狮子全餐", "result_text": "将这头凶兽扒皮剔骨的哈比卜有时候眼神看起来比狮子还要恐怖一点。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001007}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000382}, "result_title": "生命布丁", "result_text": "调入生命之水做成的布丁闻起来有一股醇厚的酒香。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001008}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000215}, "result_title": "荒野一锅炖", "result_text": "哈比卜成功复刻出《猎人故事集》里阐述的经典菜肴，不过把那些在荒野中因地制宜信手取用的食材换成了更美味的品种。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001009}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000221}, "result_title": "草药炖大雁", "result_text": "哈比卜按照《草药学入门》中的记载复刻出来的菜式，据说这样最能激发这种禽肉中蕴含的药性。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001010}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000223}, "result_title": "烤全驼", "result_text": "这道菜做得颇不容易，首先挖一个能容得下整只骆驼的大坑就已经几乎费尽了馋这一口的食客们的力气……", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001011}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000236}, "result_title": "精力套餐", "result_text": "哈比卜一口咬定这就是《如何取悦你的爱人》给他带来灵感做出来的。他极力劝说你品尝，并且保证绝对没有下毒。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001012}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000226}, "result_title": "仙人掌蛋糕", "result_text": "哈比卜以《沙漠之书》为灵感烤制的蛋糕，带着一股水果的特殊清香。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001013}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000210}, "result_title": "圣餐饼", "result_text": "哈比卜以《圣训六十篇》为灵感复刻的圣餐饼。味道不重要，重要的是虔诚的心。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001014}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000211}, "result_title": "国王烤肉", "result_text": "哈比卜以《宫廷礼仪指南》为灵感复刻的异国美食，搭配它食用的不是好喝的美酒或者茶水，而是一整套无比精致、优雅、复杂的餐桌礼仪。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001015}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000212}, "result_title": "饼夹一切", "result_text": "哈比卜为忙碌得几乎没时间吃饭的官员们发明了一道方便的餐点。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001016}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000213}, "result_title": "蜂蜜蛋饼", "result_text": "哈比卜复刻了《艾娃日记》里据说是作者临终前最想吃的餐点。它质朴、平凡，却温暖。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001017}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000797}, "result_title": "老派花园大餐", "result_text": "哈比卜复刻了《老花园》中诗人所描绘的老派花园大餐，愿有情人终成眷属。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001049}, "action": {"global_counter+7200207": 1}}, {"condition": {"s2.is": 2000803}, "result_title": "禽肉炒蘑菇", "result_text": "哈比卜依据《荒野集》的记载做出来的菜式，这道菜做法和用料都颇朴实简单，唯一的难点在于辨别这些蘑菇到底能不能吃。", "result": {"clean.s3": 1, "clean.s2": 1, "counter-7000520": 1, "card": 2001050}, "action": {"global_counter+7200207": 1}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000014}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哈比卜"}, "s2": {"condition": {"type": "item", "any": {"is": 2000213, "all": {"is": 2000382, "cost.可堆叠=": 1}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "恰当的灵感来源或者优秀食材"}, "s3": {"condition": {"type": "item", "cost.金币": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "需要10金币"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
