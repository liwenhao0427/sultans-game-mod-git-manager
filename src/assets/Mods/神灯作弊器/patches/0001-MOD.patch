+{"id": 5208050, "name": "赘婿的金币", "text": "阿鲁米娜小姐和她的父亲一起来拜访你，哲瓦德看起来精疲力竭、咬牙切齿，但他显然拗不过自己的宝贝女儿。他们提出要买走你的一个奴隶，脚程最快的那个。开价是二十枚金币……这些钱买一头成年大象都还有得找，对一个成年奴隶来说，显然物超所值。", "tips": "", "mapping_id": 8001103, "once_new": 0, "round_number": 1, "waiting_round": 5, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "prompt_5208050_01", "text": "你没有理会哲瓦德和阿鲁米娜，“我过几天再来！”阿鲁米娜很坚持。", "icon": "cards/2000774"}, "delay": {"id": 52080501, "round": 7, "event_on": 5321055}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "自宅:[2,12]", "icon": "rite_6", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"!s3": 1}, "result_title": "快脚是我最好的奴隶，我离不开快脚", "result_text": "你随便用一些蹩脚的借口拒绝了这位骄纵的大小姐，从小到大她的人生都几乎没有遭受到如此坎坷，这让她暴跳如雷，在女儿还没做出什么过分的举动之前，哲瓦德连拖带拽拉走了她，这位父亲看上去面色轻松了不少，还偷偷塞给你一袋金币。那之后，快脚闷闷不乐了一段时间，但他依旧会经常在晚上偷偷出门，凌晨才回家……", "result": {"s2=支持": 0, "s2+反对": 3, "coin": 10, "counter+7000339": 1}, "action": {}}, {"condition": {"s3": 1}, "result_title": "很棒的交易", "result_text": "你让他们带走了快脚。狠狠地拍了拍他的肩膀，告诉他为了二十个金币，他最好满足新主人的一切要求……等等各种令年轻人发抖的怪话，直到阿鲁米娜把他从你身边拽走为止。", "result": {"s3-追随者": 1, "counter+7000339": 1, "counter+7000460": 1, "counter+7100001": 1, "coin": 20}, "action": {"delay": {"id": 52080502, "round": 5, "event_on": 5321056}}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000057}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哲瓦德"}, "s2": {"condition": {"type": "char", "is": 2000774}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "阿鲁米娜"}, "s3": {"condition": {"type": "char", "is": 2000370}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "可以置入快脚，或者空置拒绝赎身。"}, "s4": {"condition": {"cost.2000813": [1, 99], "!已拥有": 1}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "哲瓦德允诺给你20枚金币，作为快脚赎身费"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
