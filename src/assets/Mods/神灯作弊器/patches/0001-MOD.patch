+{"id": 5202022, "name": "为朱娜赎身", "text": "朱娜的欲望和心灵都寄托在你身上了，她再也不是那个有耐心抚慰众多迷茫男子的朱娜了……她再也不想与你分开，期待你能够彻底占有自己……", "tips": "", "mapping_id": 8001310, "once_new": 0, "round_number": 1, "waiting_round": 10, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "prompt_5202022_01", "text": "你答应了朱娜，但你没有履行自己的诺言，一个妓女又能怎样呢？"}, "event_on": 5300305}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_22", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以选择花这笔钱为她赎身，也可以选择无视。", "在这里你可以折断一张对应品级的奢靡卡，当然也可以是杀戮卡。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {"!s4": 1}, "result_title": "朱娜值得", "result_text": "她成为了你的人。依偎在你的怀抱中，享受着从未有过的安全感。\n你的手指轻轻拂过她的脸庞，脖颈……那种触目惊心，令你们迷醉的触电感消失了。她的双瞳里只有你的影子，不像以往那样被唤起疯狂。\n那种神秘，可怕又诱人的激情正在消退，仿佛诅咒被解除了一般，你在她的呼吸之间感到了幸福。", "result": {"global_counter=7200162": 1, "s1+追随者": 1, "s1-妓女": 1, "s2+魅力": 1, "counter+7000417": 1, "card": 2000083}, "action": {}}, {"condition": {"s4.奢靡": 1}, "result_title": "你借此折断了一张奢靡卡", "result_text": "苏丹要求所有睡过朱娜的廷臣向你祝贺，这真是一个难熬的上午……但至少，她已经在家中等待你归来。", "result": {"global_counter=7200162": 1, "s1+追随者": 1, "s1-妓女": 1, "s2+魅力": 1, "counter+7000417": 1, "clean.s4": 1}, "action": {}}, {"condition": {"s4.杀戮": 1}, "result_title": "花了一大笔钱为她赎了身，但你似乎另有所图", "result_text": "最后一枚金币落袋，契约书被按上了手印，她现在属于你了……这是一个聪明的女人，她能够理解你的眼神——但依然无所畏惧。\n“动手吧”，她呼唤道：“拿走我的全部。”……\n苏丹对这个故事赞叹不已，反复夸奖你的创意，品位与智慧。", "result": {"clean.s1": 1, "clean.s4": 1, "global_counter=7200162": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000080, "激情": 3}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "爱你的，朱娜"}, "s2": {"condition": {"主角": 1, "type": "char"}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "这种事情也没法拜托别人是吧。"}, "s3": {"condition": {"type": "item", "cost.金币": 10}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "10金币"}, "s4": {"condition": {"type": "sudan", "any": {"奢靡": 1, "杀戮": 1}, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "奢靡或者杀戮"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
