+{"id": 5421037, "text": "剑盾的仪式说明", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5121037}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5421037_option_1", "text": "盖斯解读了这份仪式图纸。\n他告诉你，这是往日的王者们在出征前进行的仪式。具体说来，它需要举行仪式的人派出一支军队，前往帝国建立之初的心脏位置，在那里净身、焚香、演练，持续五天时间，而后返程。\n这仪式已经多年无人进行过，但它在帝国很多居民的心中都留有光辉的残影，现在重新做一次，一定能为你赢得不小的影响力。\n这一次，他看向你的眼睛里充满了期待：“我可以为您准备仪式所需的材料。”", "icon": "cards/2000056", "items": [{"text": "筹备仪式", "tag": "op1"}, {"text": "还是算了", "tag": "op2"}]}, "case:op1": {"no_prompt": {"table.2000759-事件提示": 1}, "rite": 5008029, "prompt": {"id": "5421037_prompt_1", "text": "很好。你认可他的说法。那就这么办吧", "icon": "cards/2000001"}, "success": {"event_off": 5421037}}, "case:op2": {"no_prompt": {"table.2000759-事件提示": 1}, "prompt": {"id": "5421037_prompt_2", "text": "“再说吧。”你想了想，认为现在条件还不成熟。\n盖斯点点头，“那么，有需要的时候，您可以随时召唤我。”", "icon": "cards/2000001"}, "success": {"event_off": 5421037}}}}]}
