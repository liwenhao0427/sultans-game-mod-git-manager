+{"id": 5200664, "name": "暗潮涌动", "text": "麦娜尔找到了那座传说中的富庶城市，而苏丹对此极有兴趣。有一些事在暗中进行，令一切滑向深渊，而你对此无能为力。", "tips": "", "mapping_id": 8001203, "once_new": 0, "round_number": 3, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "野外:[9,14]", "icon": "rite_17", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以先下手为强，也可以置之不理，但不论如何，没有人能改变苏丹的主意。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"s2": 1}, "result_title": "你决定使用征服卡", "result_text": "你已经观察到军队的异动，知道苏丹已经向那座城市派兵了。毁灭已经无法逆转，既然如此，何不令它发挥最后一点作用？\n你拿出一张刻画着王权的卡片，恳请苏丹给你一个为他开疆扩土的机会。苏丹哈哈大笑着同意了。\n你作为指挥官，拿到了麦娜尔献给苏丹的地图——你忽然注意到，地图上标注的地点是错误的，但这难不倒亲历了那场探险的你。你命令大军把那座顽固的城市团团围困，直等到城内山穷水尽，才终于攻破了它。为了报复他们无谓的拖延，你将市民屠戮殆尽，财物洗劫一空。而这片被践踏的土地，再也没有任何被标记在地图上的价值。", "result": {"clean.s1": 1, "clean.s2": 1, "counter+7100002": 1, "coin": 10}, "action": {"event_on": 5300170}}, {"condition": {"!s2": 1}, "result_title": "你没有趁火打劫", "result_text": "你听闻苏丹的军队出征了，但他们费劲千辛万苦找到那座城市、潜入其中时，那里早已人去楼空，仿佛你们所见的繁荣是一场海市蜃楼。你忽然想起离开之前麦娜尔曾和商人们说过很久的话。一个近乎不可能的猜想在你脑海中盘旋……也许不久之后，会得到验证。", "result": {"clean.s1": 1}, "action": {"event_on": 5300155}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000365}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "繁荣的城市"}, "s2": {"condition": {"type": "sudan", "征服": 1, "f:rare-s1.rare<=": 0}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "也许你可以借机用掉一张征服卡，但……"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
