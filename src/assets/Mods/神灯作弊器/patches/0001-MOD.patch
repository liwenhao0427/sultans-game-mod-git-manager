: 1, "text": "哲巴尔应该在吧？"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须亲自上阵"}, "s3": {"condition": {"type": "item", "cost.消耗品=": 1, "!金币": 1, "情报": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "有些情报或许能在战斗中帮上忙"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
