+{"id": 5203007, "name": "放你自由", "text": "有什么事正暗中发生。", "tips": "", "mapping_id": 8001207, "once_new": 0, "round_number": 1, "waiting_round": 0, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 1, "auto_result": 0, "location": "商业区:[10,19]", "icon": "rite_10", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["这是一个突然发生的不幸，你已经来不及做阻止，只能接受结果"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "", "result_text": "梅姬和一个男人离开了，带走了你全部的钱。这件事并非全无征兆，你望着那幢空荡荡的宅邸，想着过往的种种，心中半是愤怒，半是无力，隐约地，还有一丝莫可名状的解脱——你诚然早已背叛了你们曾经的爱，如今她也背叛了你，这很公平，不是么？再也不需要那无用的愧疚和担忧了！你失去了梅姬，你拥有了自由。", "result": {"clean.s1": 1, "clean.s2": 1, "global_counter+7200003": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"妻子": 1, "type": "char"}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "妻子"}, "s2": {"condition": {"is": 2000014}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "厨子"}, "s3": {"condition": {"type": "item", "cost.金币": [1, 9999]}, "open_adsorb":0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你的全部财产"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
