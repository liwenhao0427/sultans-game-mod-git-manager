+{"id": 5400274, "text": "燃烧的奴隶市场", "is_replay": 0, "auto_start_init": [1], "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100274}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"counter+7000464": 1, "event_on": 5300538, "no_prompt": {"table.clean.2000770": 1, "table.clean.2000851": 1, "table.clean.2000852": 1}, "prompt": {"id": "5400274_prompt_1", "text": "你听说了一则无关紧要的传闻，据说这天在奴隶市场，有一名奴隶在交易过程中挣脱了绳索，不仅杀了自己的主人，还放火烧了大半条街区……", "icon": ["", "common/position_pingming_2", ""]}, "success": {"event_off": 5400274}}}], "auto_start": false}
