@@ -0,0 +1 @@
+{"id": 5206636, "name": "下次还敢吗？", "text": "你带着苏丹卡敲响了这个不自量力的贵族的家门，你倒要好好问问他，他哪来的胆子调戏你的追随者——哪怕只是一名女奴？", "tips": "", "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"prompt": {"id": "5206636_prompt_01", "text": "你放出来的话让那名贵族胆战心惊了几天，但接下来，却没等到你实质性的动作。他大概以为你不过是狐假虎威，说说而已，于是很快又重新在朝堂上活跃起来。", "icon": "cards/2000001"}, "event_on": 5320185}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {"tips": ["体魄", "战斗"], "type": "normal_result"}, "tips_text": ["如果打算利用征服卡威胁他的话，带上军队才有说服力"], "open_conditions": [{"condition": {"any": {"s3.杀戮": 1, "s3.纵欲": 1, "all": {"s3.征服": 1, "s4.部队": 1}}}, "tips": "缺少启动事件的关键卡牌"}], "random_text": {}, "random_text_up": {"r1": {"text": "无奈，你拔出了佩剑。而他也不可能坐以待毙", "type": "normal_result", "type_tips": "你的体魄和战斗为你提供了完整的骰子数量。", "low_target": 3, "low_target_tips": "你至少需要3点成功"}}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {}, "result_title": "", "result_text": "你把手里的苏丹卡拍在他脸上，问他是不是想尝尝它们的滋味。男人脸上的神色扭曲了一瞬，紧攥起拳头。但紧接着，他向你低头了。\n“请您见谅。”他低声下气地向你道歉，心里却仍是不甘心的，“但这不能怨我，是您的女奴先勾引我的。她那么漂亮，又在那么多人里看了我一眼，如果不是对我有意思……”\n在你冰冷的注视下，他吞下了后面的话语，没再多说什么。\n事情似乎就这样结束了。", "result": {}, "action": {}}, {"condition": {}, "result_title": "然而，这事被苏丹知道了", "result_text": "苏丹饶有兴致地问清了当时你拿出的是一张什么苏丹卡，然后命令你执行它。\n他要你知道，他允许你玩这场游戏，他赐予你种种权力，但终究，他才是这一切的主人，而你是负责取悦他的玩物，仅此而已。", "result": {}, "action": {}}, {"condition": {"s3.杀戮": 1, "r1:战斗+体魄>=": [3, 5]}, "result_title": "", "result_text": "他倒在你的利刃之下，结束了他老鼠一样猥琐的、可悲的生命。苏丹的笑声中，你不得不承认，你的心中对他其实没有多少悲悯——这是个不值得同情的男人。\n你替小圆堂堂正正地解决了这件事，回家的时候，梅姬拥抱了你。她从未觉得你如此可靠过。", "result": {"clean.s1": 1, "clean.s3": 1, "card": 2000689, "counter+7100004": 1}, "action": {"counter+7000258": 1}}, {"condition": {"s3.杀戮": 1, "r1:战斗+体魄<": [3, 5]}, "result_title": "", "result_text": "你死了。大家都在嘲笑你，为了一个卑贱的奴隶而死。只有妻子和认同你的追随者们为你哭泣。", "result": {"clean.s2": 1}, "action": {}}, {"condition": {"s3.纵欲": 1}, "result_title": "", "result_text": "尽管你其实并不情愿，但事已不得不为。那个男人吓得跳起来，在宫廷上四处躲闪、逃避，最后，被侍卫们七手八脚地按在地上，还在拼命挣扎、求饶，哭得让那张本就不好看的脸更是面目可憎，双腿之间还淌下了臭烘烘的可疑液体。\n唉，这是何苦。不像你，你早已习惯了接受这一切……庆幸吧，至少他可以不用死了。\n这种男人的滋味实在乏善可陈……捏着鼻子草草了事之后，你那哭丧着的脸，终于让苏丹露出了微妙的笑容。就连梅姬听说之后都不忍苛责你。还能说什么呢……至少你真的帮小圆摆平了这件事。\n听说后来，那个贵族没脸再呆在首都，连夜收拾家当离开了这座城市。说真的，你才是想连夜离开的那个人吧。", "result": {"clean.s1": 1, "clean.s3": 1, "counter+7100004": 1}, "action": {"counter+7000258": 1}}, {"condition": {"s3.征服": 1}, "result_title": "你的军队随即出动", "result_text": "他的家族，他的领地，他的尊严，他平日里可以吹嘘的一切，都被无情地踏平了。苏丹笑了，这是他最乐意看到的场景，更何况，他还看到了你的军队——噢，军队！他就像是看到一个孩子在玩一件他早就玩厌了的破玩具一样。一直到你离开宫廷，苏丹的目光依然刺在你的后背。他要在你玩得最兴头上的时候再将之踩碎，等着吧……哈哈。\n尽管带来了无数的血腥，你还是出面替小圆摆平了这件事。梅姬没有过多地埋怨你……要怪，就怪苏丹吧。", "result": {"clean.s1": 1, "clean.s3": 1, "counter+7100003": 1, "coin": 5}, "action": {"counter+7000258": 1}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2000738}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "自不量力的贵族"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你必须亲自出面"}, "s3": {"condition": {"type": "sudan", "f:rare-s1.rare<=": 0, "any": {"杀戮": 1, "纵欲": 1, "征服": 1}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你可以利用一张白银品级的杀戮、纵欲或者征服威吓他"}, "s4": {"condition": {"any": {"部队": 1, "all": {"type": "item", "cost.消耗品=": 1, "!金币": 1}}}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "如果你想利用征服卡，就必须要有一支军队，否则可以在此放入任何有助益的消耗品"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
