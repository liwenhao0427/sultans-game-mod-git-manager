@@ -0,0 +1 @@
+{"id": 5400272, "text": "被偏爱的与被冷落的", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100272}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400272_option_1", "text": "被欢愉之女冷落的寻欢客愤怒地指着被她们偏爱的男人——奈布哈尼——赌上男人的全部尊严，要求和他进行决斗。你要插手这次的纠纷吗？", "icon": "cards/2000001", "items": [{"text": "劝说被冷落的人", "tag": "op1"}, {"text": "劝说被偏爱的人", "tag": "op2"}, {"text": "作壁上观", "tag": "op3"}]}, "case:op1": {"counter+7100001": 1, "prompt": {"id": "5400272_prompt_1", "text": "你走到被冷落的男人跟前，小声提醒他，奈布哈尼可是苏丹跟前的铁卫，全帝国知名的剑客，他向这样的人提出决斗，是否稍微有点不智？\n你话说到一半，男人的腿已经开始哆嗦了……你又对他说，在这种级别的剑客面前认输的人不知道有过多少，这并不算什么污点，正相反，人们反而会称赞他敢于挑战。而且，有什么比空掷生命更不体面的呢？何必要为了一时的气不过，就赌上自己的一切？\n男人丢下剑，冲你和奈布哈尼都深鞠了一躬，而后落荒而逃。\n人们都松了一口气，欢愉之女们很有默契的绝不会再提起这场半途而废的决斗。\n你临走时，奈布哈尼冲你笑着，挥了挥手。\n“干得漂亮，你总能说服别人，无论是一个不受女人欢迎的孬种，还是苏丹。”", "icon": "cards/2000001"}, "event_on": 5300212}, "case:op2": {"counter+7100003": 1, "prompt": {"id": "5400272_prompt_2", "text": "你走到奈布哈尼身边，拍拍他的肩膀，示意他留意周遭那些焦急又担忧的欢愉之女。如果他出点什么事，这些女孩该多么伤心啊！他何必要为了一场虚荣的决斗而辜负这么多的爱呢？\n奈布哈尼哈哈大笑起来：“你说得对，[player.name] ，你总有办法说到人们的心坎里去，无论是我，还是苏丹！好啦，我的朋友，我向你道歉，不该占着美丽的小鱼儿太久——”\n他躬身冲被冷落的男人行了个礼——既然有了个台阶，那个男人当然求之不得，两人就此握手言和。", "icon": "cards/2000001"}, "event_on": 5300212}, "case:op3": {"rite": 5000766, "prompt": {"id": "5400272_prompt_3", "text": "你什么都没做，只是与其他人一起袖手旁观。\n那男人在奈布哈尼的剑下就连三招都没挺过，他被利刃正中心脏，倒下时满脸都是眼泪。\n早就在一边等着的医师冲上来为他救治，但你早就见过将死之人的面孔，那正与他现在的面孔一般。\n即使是在众人见证下的决斗，即使奈布哈尼是苏丹的铁卫、是大贵族家的世子，但这种事情多少也会影响他的声誉……接下来的几天里，他大概不会出现在城市里。", "icon": "cards/2000064"}, "clean.rite": 5000713, "event_off": 5300211}}}]}
