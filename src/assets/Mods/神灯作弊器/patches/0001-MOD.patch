+{"id": 5400178, "text": "先到先得", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5100178}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"option": {"id": "5400178_option_1", "text": "你们徜徉在黑街上，打量着一个又一个销赃的地摊，或是可疑的小店。终于，有位老妇人的摊子引起了你们的兴趣……但就在书店老板伸手去拿她面前那本看起来很有趣的书时，斜地里伸过来另一只手，一把按住了它。这位横刀夺爱的买书人是个满脸横肉的强盗，他显然对书并没什么兴趣……一个黑街常见的伎俩，无非是想讹钱罢了。", "icon": ["common/position_shangye_1", "", ""], "items": [{"text": "和他争抢", "tag": "op1"}, {"text": "看看今天带的卡", "tag": "op2"}]}, "case:op1": {"counter+7100004": 1, "card": 2000558, "prompt": {"id": "5400178_prompt_1", "text": "按照黑街的规矩，你直接砍断了他的那只手……他像个受惊的牲口一样落荒而逃，但他的血也把书毁了大半。事后，书店老板一个劲儿地埋怨你，为什么不用杀戮卡吓唬吓唬他，哪怕是纵欲卡也行啊！", "icon": ["common/position_shangye_1", "", "cards/2000001"]}}, "case:op2": {"counter+7100002": 1, "coin": 3, "prompt": {"id": "5400178_prompt_2", "text": "你让书店老板介绍一下自己的身份，他只说了三句，那无赖和卖书的小贩就吓得落荒而逃……后来大家都传说你要对一个无赖使用纵欲卡。但无论如何，书是保住了，而且没要钱。", "icon": ["common/position_shangye_1", "", "cards/2000199"]}}}}]}
