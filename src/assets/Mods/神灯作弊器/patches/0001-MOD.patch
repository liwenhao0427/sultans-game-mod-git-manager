+{"id": 5200790, "name": "蓝巾", "text": "哈布娜已经成为了一名娴熟的教师，她的纺织间已经无需你的资助可以运转了——这养活了不知道多少贫苦的女人和她们的家庭。那些女人们把织出来的纱编在发辫里、缠在腰带上，这样她们就能方便地在人群中认出自己的朋友，人们也知道，她们是哈布娜的学生。这似乎给了你一点灵感……", "tips": "", "mapping_id": 8001276, "once_new": 0, "round_number": 1, "waiting_round": 7, "waiting_round_end_action": [{"condition": {}, "result_title": "", "result_text": "", "result": {}, "action": {"rite": 5000789, "prompt": {"id": "5200790_prompt_01", "text": "也许是你并不关心这件事，那也就错过了。", "icon": "cards/2000001"}}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "上城区:[7,12]", "icon": "rite_12", "tag_tips": [], "tag_tips_up": {}, "tips_text": [], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {}, "result_title": "属于你的蓝色，属于自由和希望的蓝色", "result_text": "在你的授意之下，一批价格低廉的蓝色细纱流向平民们中间，随之而去的，还有一些秘而不宣的流言。贫民窟里，常常能看见系着蓝纱的人们偶然相遇，友好地说些什么，彼此交换着消息。他们偶尔会出现在你的宅邸附近，更多的则分散在整座城市，如同水滴汇成一片沉默地酝酿着风暴的蓝色海洋。", "result": {"counter+7000427": 1, "card": 2000100}, "action": {"rite": 5000789}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"is": 2000773}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 1, "text": "哈布娜已经是娴熟的教师"}, "s2": {"condition": {"type": "char", "主角": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你需要亲自来办这件事"}, "s3": {"condition": {"type": "item", "any": {"is": 2000541}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "合适的思潮"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
