@@ -0,0 +1 @@
+{"id": 5204526, "name": "选光者", "text": "你来到教会，很多等待晋升的信徒已经在此等待多时了。他们在祭司们的示意下割开自己的手心，以疼痛唤醒属于他的神之恩赐。你从中看到纷乱的神光，还有人们望向你时，闪烁着不同期待的眼神。", "tips": "", "mapping_id": 8001549, "once_new": 1, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "神殿区:[2,10]", "icon": "rite_9", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["你可以在他们中任意选择，甚至，也可以谁都不选。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "settlement_prior": [], "settlement": [], "settlement_extre": [{"condition": {"s2": 1}, "result_title": "你认可富家子弟的灵光", "result_text": "尽管他的灵光你瞪大了双眼也看不到分毫，但你还是给了他许可，毕竟……谁会跟钱过不去呢？\n他喜不自胜地差点原地跳起来欢呼，当然，他也没有忘记时候偷偷给你送去答应好的金子。", "result": {"金币": 4, "no_show": {"clean.s1": 1, "clean.s2": 1}}, "action": {"event_on": 5310625}}, {"condition": {"!s2": 1}, "result_title": "你的灵光不太行", "result_text": "你诚实地说出了真相，这位富家子弟的表情一下子就垮了。\n好吧、那好吧。这也在他的意料之中，毕竟教会那么纯洁、这么高尚、用钱走不通也是当然的。他哭丧着脸离开了。", "result": {"no_show": {"clean.s1": 1, "clean.s2": 1}}, "action": {}}, {"condition": {"s4": 1}, "result_title": "你认可贵族子弟的灵光", "result_text": "他的灵光足足有小猫那么大呢，鲜活灵动，比场上所有人加起来的都强。你没理由不给他认可，甚至略带劝勉地拍拍他的肩。然而，少年看起来却并不怎么高兴。他面无表情地看看你，用袖子掩盖住鲜血淋漓的手臂，低垂着头退回了行列之中。\n这之后，他的父亲在朝堂上说了你好多坏话。干什么啊这是，成为祭司不是大大的荣幸、大大的好事吗？", "result": {"card": 2000168, "counter-7100003": 1, "no_show": {"clean.s3": 1, "clean.s4": 1}}, "action": {"event_on": 5310628}}, {"condition": {"!s4": 1}, "result_title": "你对贵族子弟的灵光保持沉默", "result_text": "他的灵光足足有小猫那么大，鲜活灵动，比场上所有人加起来的都强。但是，你保持了沉默，而这沉默正是这名少年想要的。他望向你的眼神隐含着感激，事后，他派人给了你一袋沉甸甸的金子。", "result": {"coin": 10, "counter+7100003": 1, "no_show": {"clean.s3": 1, "clean.s4": 1}}, "action": {}}, {"condition": {"s6": 1}, "result_title": "你认可卑微仆役的灵光", "result_text": "他激动得眼含泪光，仿佛这辈子都没有过如此荣耀的时刻。他能将这无用的身躯、无能的鲜血奉献给伟大的神和祂的信徒，这是多好的一件事啊！他对你谢了又谢。", "result": {"no_show": {"clean.s5": 1, "clean.s6": 1}}, "action": {}}, {"condition": {"!s6": 1}, "result_title": "你不认可仆役的灵光", "result_text": "他的灵光太微弱了，他的纯净之言几乎起不到治疗的效果。你残酷地给予了你的评价，而他只是低下头，很快调整出一个微笑来献给你：“我、我还会继续努力的。”", "result": {"no_show": {"clean.s5": 1, "clean.s6": 1}}, "action": {}}, {"condition": {"s8": 1}, "result_title": "你认可少年的灵光", "result_text": "多么纯粹的眼睛，多么纯粹的灵光……虽然比那名贵族还差了一点，但他年纪还小嘛！\n少年听了你的夸赞，有些兴奋又有些不好意思地涨红了脸。他马上扭头往人群里找，大概是想找他的父母分享这份快乐吧。", "result": {"no_show": {"clean.s7": 1, "clean.s8": 1}}, "action": {"event_on": 5310628}}, {"condition": {"!s8": 1}, "result_title": "你不认可少年的灵光", "result_text": "泪水立刻涌上了他的眼眶，纯净的水滴滚滚而落，他就这样在人群中大哭了起来，你不得不手忙脚乱地安抚他好一阵子，他才抽抽噎噎地离开了。", "result": {"no_show": {"clean.s7": 1, "clean.s8": 1}}, "action": {}}, {"condition": {"any": {"s4": 1, "s8": 1}}, "result_title": "", "result_text": "时间证明你选对了人，看来你真的是被神眷顾的选光者。祭司们对你心服口服。", "result": {"s9+虔信": 1}, "action": {}}], "cards_slot": {"s1": {"condition": {"type": "char", "is": 2001097}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "富家子弟，此人身上完全没有灵光散发"}, "s2": {"condition": {"type": "item", "is": 2001096, "cost.已拥有=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择认可这名富家子弟的灵光"}, "s3": {"condition": {"type": "char", "is": 2001098}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "贵族子弟，此人灵光比其他所有人都要强大"}, "s4": {"condition": {"type": "item", "is": 2001096, "cost.已拥有=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择认可这名贵族子弟的灵光"}, "s5": {"condition": {"type": "char", "is": 2001099}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "卑微的仆役，此人灵光微弱，只能说不算没有"}, "s6": {"condition": {"type": "item", "is": 2001096, "cost.已拥有=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择认可这名卑微仆役的灵光"}, "s7": {"condition": {"type": "char", "is": 2001100}, "open_adsorb":0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "无知少年，此人灵光较强，仅次于贵族子弟"}, "s8": {"condition": {"type": "item", "is": 2001096, "cost.已拥有=": 1}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "你选择认可这名无知少年的灵光"}, "s9": {"condition": {"type": "item", "思潮": 1, "any": {"is": 2000728}}, "open_adsorb": 0, "is_key": 0, "is_empty": 0, "is_enemy": 0, "text": "你对纯净之神的信仰"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
