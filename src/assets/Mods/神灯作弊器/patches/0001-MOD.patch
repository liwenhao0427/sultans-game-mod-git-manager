+{"id": 5200722, "name": "回报宰相", "text": "阿卜德要求你带回穆尔台兹的承诺，强令他务必参与朝会，不得缺席。", "tips": "", "mapping_id": 8001063, "once_new": 0, "round_number": 1, "waiting_round": 3, "waiting_round_end_action": [{"condition": {"!s1": 1}, "result_title": "", "result_text": "宰相对你迟迟没有音讯感到不满。他让另一名贵族为他办成了这件事，而那名贵族因为这件事趾高气昂地四处宣扬你的无能。", "result": {"counter+7100002": 1}, "action": {}}], "method_settlement": "", "auto_begin": 0, "auto_result": 0, "location": "宫廷:[2,6]", "icon": "rite_14", "tag_tips": [], "tag_tips_up": {}, "tips_text": ["如果你没能办到阿卜德要求之事，便会因无能而遭惩罚。"], "open_conditions": [], "random_text": {}, "random_text_up": {}, "random_effect": {}, "settlement_prior": [], "settlement": [{"condition": {"!s1": 1}, "result_title": "你没能做到", "result_text": "你没能带回穆尔台兹的承诺。于是那段时间里，宫廷里人们窃窃私语、津津乐道的对象变成了你。", "result": {"counter+7100002": 1}, "action": {}}, {"condition": {"s1": 1}, "result_title": "你做到了", "result_text": "阿卜德对此非常满意，很好。这样苏丹就能在他的宫廷里欣赏穆尔台兹那被无能深深压抑着的微不足道的愤怒和仇恨了。\n而你只觉得可笑。王国的宰相，竟被他干成了一个安排节目单的小丑。", "result": {"clean.s1": 1, "counter+7100003": 1}, "action": {}}], "settlement_extre": [], "cards_slot": {"s1": {"condition": {"type": "item", "is": 2000373}, "open_adsorb": 0, "is_key": 0, "is_empty": 1, "is_enemy": 0, "text": "穆尔台兹的承诺"}}, "is_replay": 0, "auto_start": false, "start_trigger": true, "condition": {}, "on": {"round_begin_ba": 1}}
