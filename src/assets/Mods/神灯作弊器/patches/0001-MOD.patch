+{"id": 5420197, "text": "奈费勒声望事件--男人本应如此", "is_replay": 0, "auto_start": false, "start_trigger": true, "on": {"round_begin_ba": 1}, "condition": {"rite": 5120197}, "settlement": [{"tips_resource": "", "tips_text": "", "action": {"card": [2000749, "已拥有+1"], "prompt": {"id": "5420197_prompt_01", "text": "宰相阿卜德差人送来了一件斗篷给你，那上面用金线绣着不堪入目的春宫图。\n仆人转达了他的口信：“您只是做了男人都会做的事，我听说可恨的奈费勒居然还为此弹劾您。我要是您，我一定会狠狠报复这个无赖！”", "icon": ["", [2000749], "cards/2000349"]}}}]}
